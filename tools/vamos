#!/usr/bin/env bash
set -e
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" >/dev/null && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd "$(dirname "$SOURCE")/.." >/dev/null && pwd)"

FLASH_ARGS=()

configure_flash_storage() {
  local storage=""

  FLASH_ARGS=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --storage)
        if [ "$#" -lt 2 ]; then
          echo "ERROR: --storage requires nvme or ufs" >&2
          exit 2
        fi
        storage="$2"
        shift 2
        ;;
      --storage=*)
        storage="${1#*=}"
        shift
        ;;
      --nvme|--ufs)
        storage="${1#--}"
        shift
        ;;
      *)
        FLASH_ARGS+=("$1")
        shift
        ;;
    esac
  done

  [ -n "$storage" ] || return 0
  case "${storage,,}" in
    nvme) export VAMOS_EDL_MEMORY=Nvme ;;
    ufs) export VAMOS_EDL_MEMORY=Ufs ;;
    *)
      echo "ERROR: --storage must be nvme or ufs" >&2
      exit 2
      ;;
  esac
}

setup() {
  git -C "$DIR" submodule update --init --depth 1
  if [ "$(uname)" = "Linux" ]; then
    UDEV_RULES="/etc/udev/rules.d/99-qualcomm-edl.rules"
    echo "Setting up udev rules for Qualcomm EDL..."
    RULES_CONTENT="$(cat <<'EOF'
SUBSYSTEM=="usb", ATTR{idVendor}=="05c6", ATTR{idProduct}=="9008", MODE="0666"
SUBSYSTEM=="usb", ATTR{idVendor}=="3801", ATTR{idProduct}=="9008", MODE="0666"
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTRS{idVendor}=="05c6", ATTRS{idProduct}=="9008", DRIVER=="qcserial", RUN+="/bin/sh -c 'echo -n %k > /sys/bus/usb/drivers/qcserial/unbind'"
EOF
)"
    if [ ! -f "$UDEV_RULES" ] || [ "$(cat "$UDEV_RULES")" != "$RULES_CONTENT" ]; then
      printf '%s\n' "$RULES_CONTENT" | sudo tee "$UDEV_RULES" >/dev/null
      sudo udevadm control --reload-rules
    fi
    sudo udevadm trigger --action=add --subsystem-match=usb
  fi
}

case "${1:-}" in
  setup)    setup ;;
  build)
    case "${2:-}" in
      kernel) exec "$DIR/tools/build/build_kernel.sh" ;;
      system) exec "$DIR/tools/build/build_system.sh" ;;
      esp)    exec "$DIR/tools/build/build_esp.sh" ;;
      ota)    "$DIR/tools/build/build_esp.sh" && exec python3 "$DIR/tools/build/package_ota.py" ;;
      disk)   exec "$DIR/tools/build/build_disk.sh" ;;
      all)    "$DIR/tools/build/build_kernel.sh" && "$DIR/tools/build/build_system.sh" && "$DIR/tools/build/build_disk.sh" ;;
      *)      echo "Usage: vamos build <kernel|system|esp|ota|disk|all>"; exit 1 ;;
    esac ;;
  flash)
    flash_target="${2:-}"
    shift
    [ "$#" -eq 0 ] || shift
    configure_flash_storage "$@"
    case "$flash_target" in
      kernel)
        if [ "${#FLASH_ARGS[@]}" -ne 0 ]; then
          echo "Usage: vamos flash kernel [--storage nvme|ufs]" >&2
          exit 2
        fi
        exec "$DIR/tools/flash/kernel.sh"
        ;;
      system)
        exec "$DIR/tools/flash/system.sh" "${FLASH_ARGS[@]}"
        ;;
      all)
        VAMOS_NO_RESET=1 "$DIR/tools/flash/system.sh" "${FLASH_ARGS[@]}" && \
          "$DIR/tools/flash/kernel.sh"
        ;;
      *)
        echo "Usage: vamos flash <kernel|system|all> [--storage nvme|ufs]" >&2
        exit 1
        ;;
    esac ;;
  profile)
    shift
    exec "$DIR/tools/profile/rootfs.sh" "$@" ;;
  device-update)
    shift
    exec python3 "$DIR/tools/device_update.py" "$@" ;;
  *)
    echo "Usage: vamos <setup|build|flash|profile|device-update>"
    echo ""
    echo "  setup              Initialize submodules and udev rules"
    echo "  build kernel       Build the kernel → build/Image + dtb"
    echo "  build system       Build the rootfs  → build/system.img (ext4)"
    echo "  build esp          Build update/boot ESP → build/esp.img"
    echo "  build ota          Package ESP + system → build/ota/vamos.json"
    echo "  build disk         Assemble initial disk image → build/dragon.img"
    echo "  build all          Do all three in order"
    echo "  flash system       Flash vamOS; accepts --storage and --without-openpilot"
    echo "  flash kernel       Flash the ESP; accepts --storage nvme|ufs"
    echo "  flash all          Flash system + kernel; accepts --storage"
    echo "  profile [diff]     Profile rootfs or diff two profiles"
    echo "  device-update HOST Install local vamOS images over SSH"
    exit 1 ;;
esac
