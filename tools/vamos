#!/usr/bin/env bash
set -e
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" >/dev/null && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd "$(dirname "$SOURCE")/.." >/dev/null && pwd)"

configure_build_storage() {
  local storage="ufs"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --storage)
        if [ "$#" -lt 2 ]; then
          echo "ERROR: --storage requires ufs" >&2
          exit 2
        fi
        storage="$2"
        shift 2
        ;;
      --storage=*)
        storage="${1#*=}"
        shift
        ;;
      --ufs)
        storage="${1#--}"
        shift
        ;;
      *)
        echo "ERROR: unsupported build argument: $1" >&2
        exit 2
        ;;
    esac
  done

  case "${storage,,}" in
    ufs) export VAMOS_DISK_STORAGE="${storage,,}" ;;
    *)
      echo "ERROR: --storage must be ufs" >&2
      exit 2
      ;;
  esac
}

setup() {
  git -C "$DIR" submodule update --init --depth 1
  if [ "$(uname)" = "Linux" ]; then
    UDEV_RULES="/etc/udev/rules.d/99-qualcomm-edl.rules"
    echo "Setting up udev rules for Qualcomm EDL..."
    RULES_CONTENT="$(cat <<'EOF'
SUBSYSTEM=="usb", ATTR{idVendor}=="05c6", ATTR{idProduct}=="9008", MODE="0666"
SUBSYSTEM=="usb", ATTR{idVendor}=="3801", ATTR{idProduct}=="9008", MODE="0666"
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTRS{idVendor}=="05c6", ATTRS{idProduct}=="9008", DRIVER=="qcserial", RUN+="/bin/sh -c 'echo -n %k > /sys/bus/usb/drivers/qcserial/unbind'"
EOF
)"
    if [ ! -f "$UDEV_RULES" ] || [ "$(cat "$UDEV_RULES")" != "$RULES_CONTENT" ]; then
      printf '%s\n' "$RULES_CONTENT" | sudo tee "$UDEV_RULES" >/dev/null
      sudo udevadm control --reload-rules
    fi
    sudo udevadm trigger --action=add --subsystem-match=usb
  fi
}

case "${1:-}" in
  setup)    setup ;;
  build)
    case "${2:-}" in
      kernel) exec "$DIR/tools/build/build_kernel.sh" ;;
      uboot)  exec "$DIR/tools/build/build_uboot.sh" ;;
      system) exec "$DIR/tools/build/build_system.sh" ;;
      esp)    exec "$DIR/tools/build/build_esp.sh" ;;
      ota)    "$DIR/tools/build/build_esp.sh" && exec python3 "$DIR/tools/build/package_ota.py" ;;
      disk)
        shift 2
        configure_build_storage "$@"
        exec "$DIR/tools/build/build_disk.sh"
        ;;
      all)
        shift 2
        configure_build_storage "$@"
        "$DIR/tools/build/build_kernel.sh" && "$DIR/tools/build/build_system.sh" && "$DIR/tools/build/build_disk.sh"
        ;;
      *)      echo "Usage: vamos build <uboot|kernel|system|esp|ota|disk|all> [--storage ufs]"; exit 1 ;;
    esac ;;
  devices|flash|uboot)
    exec "${VAMOS_PYTHON:-python3}" "$DIR/tools/flash/cli.py" "$@"
    ;;
  profile)
    shift
    exec "$DIR/tools/profile/rootfs.sh" "$@" ;;
  *)
    echo "Usage: vamos <devices|flash|uboot|setup|build|profile>"
    echo ""
    echo "  setup              Initialize submodules and udev rules"
    echo "  build uboot        Build Dragon Q6A XBL-embedded U-Boot"
    echo "  build kernel       Build the kernel → build/Image + dtb"
    echo "  build system       Build the rootfs  → build/system.img (EROFS)"
    echo "  build esp          Build update/boot ESP → build/esp.img"
    echo "  build ota          Package ESP + system → build/ota/vamos.json"
    echo "  build disk         Assemble initial disk image; accepts --storage ufs"
    echo "  build all          Do all three in order; accepts --storage ufs"
    echo "  devices            List connected Dragon devices and USB speeds"
    echo "  flash              Flash a prepared local VamOS + openpilot build"
    echo "  flash --remote [VERSION]  Flash the latest or specified published release"
    echo "  uboot              Install published U-Boot; preserve OS and data"
    echo "                     flash accepts --no-openpilot, --manifest PATH, and --yes"
    echo "  profile [diff]     Profile rootfs or diff two profiles"
    case "${1:-}" in ""|-h|--help) exit 0 ;; *) exit 2 ;; esac ;;
esac
