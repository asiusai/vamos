#!/usr/local/venv/bin/python3 -I
"""Preserve comma's password across OS slots. Do not change sudo policy."""
import fcntl
import os
import sys
import tempfile
from pathlib import Path

SHADOW = Path('/etc/shadow')
SAVED = Path('/data/etc/comma-shadow')
LOCK = Path('/run/vamos-password.lock')


def entry(text):
  matches = [line for line in text.splitlines() if line.startswith('comma:')]
  if len(matches) != 1 or len(matches[0].split(':')) != 9 or not matches[0].split(':')[1]:
    raise ValueError('Invalid comma password record')
  return matches[0]


def atomic_write(path, text):
  fd, name = tempfile.mkstemp(prefix=f'.{path.name}.', dir=path.parent)
  try:
    with os.fdopen(fd, 'w') as output:
      os.fchmod(output.fileno(), 0o600)
      output.write(text)
      output.flush()
      os.fsync(output.fileno())
    os.replace(name, path)
    directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
      os.fsync(directory)
    finally:
      os.close(directory)
  finally:
    if os.path.exists(name):
      os.unlink(name)


def persist(restore=False):
  SAVED.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
  with LOCK.open('a') as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    current = SHADOW.read_text()
    current_entry = entry(current)
    if restore and SAVED.exists():
      saved = SAVED.read_text()
      if saved != entry(saved) + '\n':
        raise ValueError('Invalid saved password record')
      atomic_write(SHADOW, '\n'.join(entry(saved) if line == current_entry else line for line in current.splitlines()) + '\n')
    else:
      atomic_write(SAVED, current_entry + '\n')


if __name__ == '__main__':
  if os.geteuid() != 0:
    sys.exit('Password persistence requires root')
  if sys.argv[1:] == ['restore']:
    persist(restore=True)
  elif not sys.argv[1:] and os.environ.get('PAM_TYPE') == 'password' and os.environ.get('PAM_USER') == 'comma':
    persist()
  elif sys.argv[1:]:
    sys.exit('Usage: persist-password [restore]')
