#!/usr/bin/env python3
"""A leased, local-only Wi-Fi access point for authenticated app video sessions."""
import fcntl
import ctypes
import hashlib
import json
import os
from pathlib import Path
import secrets
import select
import signal
import socket
import subprocess
import sys
import time
import uuid

ROOT = Path('/run/vamos-local-video')
SOCKET = ROOT / 'control.sock'
INTERFACE = 'wlan0'
AP_INTERFACE = 'asiusap0'
ADDRESS = '192.168.43.1'
LEASE_SECONDS = 120
CGROUP = Path('/sys/fs/cgroup/vamos-local-video')


def camera_network(body):
  network = body.get('network')
  if body.get('owner') != 'remote-cameras' or not isinstance(network, dict) or set(network) != {'ssid', 'password'}:
    raise ValueError('Invalid camera network')
  for name, minimum, maximum in (('ssid', 1, 32), ('password', 8, 63)):
    value = network[name]
    if not isinstance(value, str) or not minimum <= len(value) <= maximum or any(not 32 <= ord(c) <= 126 for c in value):
      raise ValueError('Invalid camera network credentials')
  return network


class CameraStation:
  def __init__(self):
    self.uuid = str(uuid.uuid5(uuid.NAMESPACE_DNS, 'asius-remote-camera'))
    self.path = Path('/run/NetworkManager/system-connections/asius-remote-camera.nmconnection')
    self.previous = ''
    self.retry = 0

  def start(self, ssid, password):
    self.previous = command('nmcli', '-g', 'GENERAL.CON-UUID', 'device', 'show', INTERFACE)
    (ROOT / 'station-restore.json').write_text(json.dumps({'uuid': self.previous}))
    # A byte-array SSID and escaped keyfile string avoid shell or nmcli secret arguments.
    escaped = password.replace('\\', '\\\\').replace(' ', '\\s')
    fd = os.open(self.path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, 'w') as profile:
      profile.write(f'[connection]\nid=Asius camera network\nuuid={self.uuid}\ntype=wifi\ninterface-name={INTERFACE}\n'
                    'autoconnect=true\nautoconnect-priority=100\n[wifi]\nmode=infrastructure\nband=a\npowersave=2\n'
                    f'ssid={";".join(str(b) for b in ssid.encode())};\n[wifi-security]\nkey-mgmt=wpa-psk\npsk={escaped}\n'
                    '[ipv4]\nmethod=auto\nnever-default=true\n[ipv6]\nmethod=disabled\n')
    command('nmcli', 'connection', 'load', str(self.path))
    self.healthy()

  def healthy(self):
    if time.monotonic() >= self.retry:
      self.retry = time.monotonic() + 15
      current = command('nmcli', '-g', 'GENERAL.CON-UUID', 'device', 'show', INTERFACE)
      if current != self.uuid:
        command('nmcli', '--wait', '5', 'connection', 'up', 'uuid', self.uuid, check=False)
    return self.path.exists()

  def stop(self):
    command('nmcli', 'connection', 'delete', 'uuid', self.uuid, check=False)
    self.path.unlink(missing_ok=True)
    if self.previous and self.previous not in ('--', self.uuid):
      command('nmcli', '--wait', '0', 'connection', 'up', 'uuid', self.previous, check=False)
    (ROOT / 'station-restore.json').unlink(missing_ok=True)


def command(*args, check=True):
  result = subprocess.run(args, capture_output=True, text=True, timeout=15)
  if check and result.returncode:
    raise RuntimeError(f'Local video Wi-Fi: {args[0]} failed')
  return result.stdout.strip()


def stop_with_parent():
  # Access-point processes must not outlive a killed lease daemon.
  ctypes.CDLL(None).prctl(1, signal.SIGTERM)
  if os.getppid() == 1:
    os._exit(1)


class AccessPoint:
  def __init__(self):
    self.children = []

  def start(self, ssid, password):
    if not Path(f'/sys/class/net/{INTERFACE}').exists():
      raise RuntimeError('Device Wi-Fi is unavailable')
    if Path(f'/sys/class/net/{AP_INTERFACE}').exists():
      raise RuntimeError('Local video Wi-Fi is already active')
    try:
      # NetworkManager owns wlan0; hostapd exclusively owns the reserved AP interface.
      command('iw', 'dev', INTERFACE, 'interface', 'add', AP_INTERFACE, 'type', '__ap')
      command('nmcli', 'device', 'set', AP_INTERFACE, 'managed', 'no')
      command('ip', 'address', 'add', ADDRESS + '/24', 'dev', AP_INTERFACE)
      config = ROOT / 'hostapd.conf'
      config.write_text('\n'.join([
        f'interface={AP_INTERFACE}', f'ctrl_interface={ROOT / "hostapd"}', 'driver=nl80211', f'ssid={ssid}',
        'hw_mode=a', 'channel=36', 'ieee80211n=1', 'ieee80211ac=1', 'wmm_enabled=1',
        'ht_capab=[HT40+]', 'vht_oper_chwidth=1', 'vht_oper_centr_freq_seg0_idx=42',
        'auth_algs=1', 'wpa=2', 'wpa_key_mgmt=WPA-PSK',
        'rsn_pairwise=CCMP', f'wpa_passphrase={password}', '',
      ]))
      config.chmod(0o600)
      with (ROOT / 'hostapd.log').open('w') as output:
        self.children.append(subprocess.Popen(['hostapd', str(config)], stdout=output, stderr=output, preexec_fn=stop_with_parent))
      with (ROOT / 'dnsmasq.log').open('w') as output:
        self.children.append(subprocess.Popen([
        'dnsmasq', '--keep-in-foreground', '--conf-file=/dev/null', '--port=0', '--bind-interfaces',
        f'--interface={AP_INTERFACE}', '--dhcp-range=192.168.43.10,192.168.43.50,255.255.255.0,5m',
        '--dhcp-option=3', '--dhcp-option=6', '--dhcp-authoritative',
        f'--dhcp-leasefile={ROOT / "leases"}', f'--pid-file={ROOT / "dnsmasq.pid"}',
        ], stdout=output, stderr=output, preexec_fn=stop_with_parent))
      deadline = time.monotonic() + 8
      while not self.healthy():
        if any(child.poll() is not None for child in self.children) or time.monotonic() >= deadline:
          raise RuntimeError('The device could not start local video Wi-Fi')
        time.sleep(.1)
    except Exception:
      self.stop()
      raise

  def healthy(self):
    if len(self.children) != 2 or any(child.poll() is not None for child in self.children):
      return False
    # Station changes can remove the AP interface while hostapd keeps running.
    if not Path(f'/sys/class/net/{AP_INTERFACE}').exists():
      return False
    # A live hostapd process can still have a disabled AP.
    client_path = ROOT / ('status-' + secrets.token_hex(4))
    try:
      with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as client:
        client.settimeout(.5)
        client.bind(str(client_path))
        client.connect(str(ROOT / 'hostapd' / AP_INTERFACE))
        client.send(b'STATUS')
        return b'state=ENABLED' in client.recv(16384).splitlines()
    except OSError:
      return False
    finally:
      client_path.unlink(missing_ok=True)

  def stop(self):
    for child in self.children:
      if child.poll() is None:
        child.terminate()
        try:
          child.wait(timeout=3)
        except subprocess.TimeoutExpired:
          child.kill()
          child.wait()
    self.children.clear()
    if Path(f'/sys/class/net/{AP_INTERFACE}').exists():
      command('iw', 'dev', AP_INTERFACE, 'del', check=False)
    for name in ('hostapd.conf', 'leases', 'dnsmasq.pid'):
      (ROOT / name).unlink(missing_ok=True)


class Session:
  def __init__(self, ap):
    self.ap = ap
    self.owner = None
    self.details = None
    self.expires = 0

  def stop(self):
    self.ap.stop()
    self.owner = self.details = None
    self.expires = 0

  def expire(self):
    if self.details and (time.monotonic() >= self.expires or not self.ap.healthy()):
      self.stop()

  def request(self, body):
    self.expire()
    action, owner = body.get('action'), body.get('owner')
    if not isinstance(owner, str) or not 1 <= len(owner) <= 128:
      raise ValueError('Invalid local video owner')
    if action == 'start':
      if self.owner and self.owner != owner:
        raise ValueError('Another app is using local video Wi-Fi')
      if not self.details:
        # Android can remember consent for this access point across sessions.
        suffix = hashlib.sha256(Path(f'/sys/class/net/{INTERFACE}/address').read_bytes()).hexdigest()[:6]
        details = {'ssid': 'Asius-Live-' + suffix, 'password': secrets.token_urlsafe(18),
                   'lease': secrets.token_hex(24), 'address': ADDRESS}
        if 'network' in body:
          details.update(camera_network(body))
          if body.get('station') is True:
            self.ap = CameraStation()
          else:
            self.ap = AccessPoint()
        elif 'station' in body:
          raise ValueError('A camera station requires network credentials')
        elif isinstance(self.ap, CameraStation):
          self.ap = AccessPoint()
        self.ap.start(details['ssid'], details['password'])
        self.owner, self.details = owner, details
      self.expires = time.monotonic() + LEASE_SECONDS
      return self.details
    if not self.details or self.owner != owner or not secrets.compare_digest(str(body.get('lease', '')), self.details['lease']):
      raise ValueError('Local video session expired. Connect video again.')
    if action == 'stop':
      self.stop()
    elif action in ('renew', 'check'):
      self.expires = time.monotonic() + LEASE_SECONDS
    else:
      raise ValueError('Unknown local video command')
    return {'success': 1, 'address': ADDRESS}


def serve():
  # A manager restart kills the entire openpilot cgroup. Keep the lease daemon
  # and its radio children outside that group so expiry can restore Wi-Fi.
  CGROUP.mkdir(exist_ok=True)
  (CGROUP / 'cgroup.procs').write_text(str(os.getpid()))
  daemon_lock = (ROOT / 'daemon.lock').open('w')
  try:
    fcntl.flock(daemon_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
  except BlockingIOError:
    daemon_lock.close()
    return
  session = Session(AccessPoint())
  session.ap.stop()
  if (ROOT / 'station-restore.json').exists():
    station = CameraStation()
    station.previous = json.loads((ROOT / 'station-restore.json').read_text())['uuid']
    station.stop()
  # SIGTERM must release the radio just like a normal session close.
  def shutdown(_signal, _frame):
    raise SystemExit()
  signal.signal(signal.SIGTERM, shutdown)
  signal.signal(signal.SIGINT, shutdown)
  with socket.socket(socket.AF_UNIX) as server:
    SOCKET.unlink(missing_ok=True)
    server.bind(str(SOCKET))
    SOCKET.chmod(0o600)
    server.listen(4)
    idle_until = time.monotonic() + LEASE_SECONDS
    try:
      while session.details or time.monotonic() < idle_until:
        session.expire()
        if not select.select([server], [], [], 1)[0]:
          continue
        with server.accept()[0] as client:
          client.settimeout(3)
          try:
            with client.makefile('rb') as incoming:
              body = json.loads(incoming.readline(4096))
            reply = session.request(body)
            idle_until = time.monotonic() + 5
          except Exception as error:
            reply = {'error': str(error)}
          try:
            client.sendall(json.dumps(reply).encode() + b'\n')
          except OSError:
            pass
    finally:
      try:
        session.stop()
      finally:
        SOCKET.unlink(missing_ok=True)


def main():
  os.umask(0o077)
  ROOT.mkdir(mode=0o700, exist_ok=True)
  if len(sys.argv) == 2 and sys.argv[1] == 'serve':
    serve()
    return
  body = json.loads(sys.stdin.readline(4096))
  with (ROOT / 'lock').open('w') as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    running = False
    with socket.socket(socket.AF_UNIX) as probe:
      try:
        probe.connect(str(SOCKET))
        running = True
      except (FileNotFoundError, ConnectionRefusedError):
        pass
    if not running:
      if body.get('action') != 'start':
        raise ValueError('Local video session expired')
      subprocess.Popen([sys.executable, str(Path(__file__).resolve()), 'serve'],
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
      time.sleep(.2)
    with socket.socket(socket.AF_UNIX) as client:
      client.settimeout(40)
      for attempt in range(50):
        try:
          client.connect(str(SOCKET))
          break
        except (FileNotFoundError, ConnectionRefusedError):
          if attempt == 49:
            raise RuntimeError('Local video Wi-Fi did not start') from None
          time.sleep(.1)
      client.sendall(json.dumps(body).encode() + b'\n')
      with client.makefile('rb') as incoming:
        print(incoming.readline(4096).decode().strip())


if __name__ == '__main__':
  try:
    main()
  except Exception as error:
    print(json.dumps({'error': str(error)}))
    sys.exit(1)
