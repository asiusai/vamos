#!/bin/sh
# Custom runit stage 1 for vamOS

PATH=/sbin:/bin:/usr/sbin:/usr/bin

echo "=> vamOS runit stage 1 starting"

echo "=> Mounting pseudo-filesystems..."
mountpoint -q /proc || mount -t proc proc /proc -o nosuid,noexec,nodev
mountpoint -q /sys || mount -t sysfs sys /sys -o nosuid,noexec,nodev
mountpoint -q /run || mount -t tmpfs run /run -o mode=0755,nosuid,nodev
mountpoint -q /dev || mount -t devtmpfs dev /dev -o mode=0755,nosuid

mkdir -p /run/lock /run/user /dev/pts /dev/shm
touch /run/motd && chmod 666 /run/motd

mountpoint -q /dev/pts || mount -t devpts devpts /dev/pts -o mode=0620,gid=5,nosuid,noexec
mountpoint -q /dev/shm || mount -t tmpfs shm /dev/shm -o mode=1777,nosuid,nodev

# Mount /var, /tmp, /rwtmp as tmpfs early (from fstab, but we need it before services start)
mountpoint -q /var || mount -t tmpfs tmpfs /var -o rw,nosuid,nodev,size=128M,mode=755
mountpoint -q /tmp || mount -t tmpfs tmpfs /tmp -o rw,nosuid,nodev,size=150M,mode=1777
mountpoint -q /rwtmp || mount -t tmpfs tmpfs /rwtmp -o rw,nosuid,nodev,size=100M,mode=1777
mkdir -p /var/run /var/run/pppd/lock /var/log /var/tmp /var/lib /var/cache /var/chroot/ssh /var/db \
         /var/spool/cron /var/lib/logrotate
chmod 1777 /var/tmp
touch /var/log/lastlog /var/log/wtmp /var/log/btmp
chmod 664 /var/log/lastlog /var/log/wtmp
chmod 600 /var/log/btmp
ln -sf /usr/lib/xbps-db /var/db/xbps
# D-Bus socket symlink (D-Bus runs in /run/dbus, some apps expect /var/run/dbus)
ln -sf /run/dbus /var/run/dbus

# securityfs - optional, don't fail if kernel doesn't support
if [ -d /sys/kernel/security ]; then
    mountpoint -q /sys/kernel/security || mount -t securityfs securityfs /sys/kernel/security -o nosuid,noexec,nodev 2>/dev/null || echo "WARN: securityfs not available"
else
    echo "WARN: /sys/kernel/security does not exist, skipping"
fi

# debugfs - mount with mode=0755 so non-root users can traverse (needed for msm_vidc)
mountpoint -q /sys/kernel/debug || mount -t debugfs debugfs /sys/kernel/debug -o mode=0755 2>/dev/null || echo "WARN: debugfs not available"

# cgroups - try cgroup2 first, fall back to cgroup1, or skip entirely
echo "=> Setting up cgroups..."
mkdir -p /sys/fs/cgroup
if mount -t cgroup2 cgroup2 /sys/fs/cgroup -o nosuid,noexec,nodev 2>/dev/null; then
    echo "=> cgroup2 mounted successfully"
elif mount -t cgroup cgroup /sys/fs/cgroup -o nosuid,noexec,nodev 2>/dev/null; then
    echo "=> cgroup1 mounted successfully"
else
    echo "WARN: cgroups not available, continuing without"
fi

# Mount /firmware early (before udev) so firmware is available when drivers load
# The symlink /lib/firmware/updates -> /firmware/image requires /firmware to be mounted
echo "=> Mounting /firmware early for driver firmware..."
if [ ! -f /ASIUS ]; then
    n=0
    while [ ! -b /dev/sde4 ] && [ $n -lt 50 ]; do
        sleep 0.1
        n=$((n + 1))
    done
fi
if [ -b /dev/sde4 ]; then
    mount -t vfat -o ro /dev/sde4 /firmware && echo "=> /firmware mounted" || echo "WARN: /firmware mount failed"
elif [ -f /ASIUS ]; then
    echo "=> No Dragon firmware partition; using built-in and rootfs firmware"
else
    echo "WARN: /dev/sde4 not ready after 5s, will mount later"
fi
echo "=> Loading kernel modules..."
if [ -x /etc/runit/core-services/02-kmods.sh ]; then
    /etc/runit/core-services/02-kmods.sh || echo "WARN: kmod loading had issues"
fi

echo "=> Starting udev..."
if [ -x /usr/bin/udevd ]; then
    /usr/bin/udevd --daemon
    echo "=> udevd started, triggering events..."
    udevadm trigger --action=add --type=subsystems
    udevadm trigger --action=add --type=devices
    if [ -f /ASIUS ]; then
        echo "=> Continuing while Dragon udev probes finish asynchronously"
    else
        echo "=> Waiting for udev to settle (timeout 30s)..."
        udevadm settle --timeout=30 || echo "WARN: udevadm settle timed out"
        echo "=> udev settle complete"
    fi
else
    echo "WARN: udevd not found at /usr/bin/udevd"
    ls -la /usr/bin/udev* 2>/dev/null || true
    ls -la /sbin/udev* 2>/dev/null || true
fi

# Expose standard embedded userspace paths where Asius hardware has an equivalent
# interface under a different kernel name.
if [ -f /ASIUS ]; then
    [ -e /dev/i2c-1 ] || [ -L /dev/i2c-1 ] || ln -s /dev/i2c-6 /dev/i2c-1
    mkdir -p /dev/input/by-path
    touch_path=/dev/input/by-path/platform-894000.i2c-event
    [ -e "$touch_path" ] || [ -L "$touch_path" ] || ln -s /dev/null "$touch_path"
fi

# Wait for a device to appear (up to timeout seconds)
wait_for_dev() {
    dev="$1"
    timeout="${2:-60}"
    n=0
    while [ ! -e "$dev" ] && [ "$n" -lt "$timeout" ]; do
        sleep 1
        n=$((n + 1))
        [ $((n % 10)) -eq 0 ] && echo "=> Still waiting for $dev... (${n}s)"
    done
    [ -e "$dev" ]
}

# Mount a partition by partlabel
# Usage: mount_part <partlabel> <mountpoint> <options>
mount_part() {
    label="$1"
    mnt="$2"
    opts="${3:-ro}"
    dev="/dev/disk/by-partlabel/$label"

    if wait_for_dev "$dev" 60; then
        if mount -o "$opts" "$dev" "$mnt"; then
            echo "=> $mnt mounted ($label)"
        else
            echo "WARN: $mnt mount failed"
        fi
    else
        echo "WARN: $label partition not found"
    fi
}

storage_root="$(findmnt -n -o SOURCE / 2>/dev/null || true)"
storage_disk_name="$(lsblk -n -o PKNAME "$storage_root" 2>/dev/null | head -n 1)"
if [ -z "$storage_disk_name" ]; then
    for candidate in nvme0n1 mmcblk0 sda; do
        if [ -b "/dev/$candidate" ]; then
            storage_disk_name="$candidate"
            break
        fi
    done
fi
case "$storage_disk_name" in
    *[0-9]) userdata_candidate="/dev/${storage_disk_name}p5" ;;
    ?*) userdata_candidate="/dev/${storage_disk_name}5" ;;
    *) userdata_candidate="" ;;
esac

# A common factory image uses the smallest supported disk geometry. Grow its
# userdata partition on larger eMMC, NVMe, UFS, or SD media before mounting it.
# Legacy two-partition disks are expanded into A/B plus persistent userdata;
# an interrupted migration is resumed on the next boot.
ab_init_failed=0
if [ -f /ASIUS ] && [ -x /usr/bin/vamos-update ]; then
    /usr/bin/vamos-update expand ||
        echo "WARN: userdata could not be expanded to fill the physical storage"
    userdata_type="$(blkid -s TYPE -o value "$userdata_candidate" 2>/dev/null || true)"
    if { [ ! -b "$userdata_candidate" ] && [ ! -e /dev/disk/by-partlabel/userdata ]; } ||
       { [ -b "$userdata_candidate" ] && [ -z "$userdata_type" ]; }; then
        echo "=> Initializing rollback-safe A/B storage"
        /usr/bin/vamos-update initialize --yes || ab_init_failed=1
        udevadm trigger --action=add "/sys/class/block/$storage_disk_name" 2>/dev/null || true
        udevadm settle --timeout=5 || echo "WARN: A/B partitions did not settle"
    fi
fi

if [ "$ab_init_failed" -eq 0 ] &&
   { [ -b "$userdata_candidate" ] || [ -e /dev/disk/by-partlabel/userdata ]; }; then
    # The Dragon continues general udev probing asynchronously for fast boot.
    # Settle this one partition so the updater can rely on its persistent link.
    if [ -b "$userdata_candidate" ] && [ ! -e /dev/disk/by-partlabel/userdata ]; then
        udevadm trigger --action=add "/sys/class/block/${userdata_candidate##*/}"
        udevadm settle --timeout=2 ||
            echo "WARN: userdata udev event did not settle"
    fi
    echo "=> Mounting persistent userdata"
    userdata_dev="/dev/disk/by-partlabel/userdata"
    [ -e "$userdata_dev" ] || userdata_dev="$userdata_candidate"
    mount -o "rw,discard,noatime,nodiratime,nosuid,nodev" "$userdata_dev" /data ||
        echo "WARN: /data mount failed"
    if ! mountpoint -q /data; then
        echo "ERROR: persistent userdata exists but could not be mounted"
    elif [ -e /data/__system_reset__ ]; then
        echo "=> Performing requested headless factory reset"
        if ! /usr/comma/reset --early; then
            echo "ERROR: factory reset failed; preserving reset marker for diagnosis"
        fi
    elif [ ! -f /data/.vamos-userdata ] || [ ! -f /data/.vamos-ab-ready ]; then
        echo "=> Resuming interrupted A/B initialization"
        if ! /usr/bin/vamos-update initialize --yes; then
            echo "ERROR: userdata migration failed; retaining legacy rootfs data"
            umount /data || true
            ab_init_failed=1
        fi
    fi
elif [ -f /ASIUS ]; then
    echo "WARN: A/B initialization incomplete; /data remains on the active rootfs"
fi

if [ -f /ASIUS ] && [ -x /usr/bin/vamos-boot ]; then
    if ! /usr/bin/vamos-boot early 2>/run/vamos-boot-early.err; then
        echo "ERROR: failed to start vamOS trial watchdog; returning to the fallback slot"
        if mountpoint -q /data; then
            mkdir -p /data/vamos-update
            {
                echo "=== $(date -u +%Y-%m-%dT%H:%M:%SZ) trial watchdog startup failed ==="
                cat /run/vamos-boot-early.err 2>/dev/null || true
                cat /run/vamos-watchdog.log 2>/dev/null || true
                ls -l /dev/watchdog* 2>&1 || true
                dmesg 2>/dev/null | grep -i -E 'watchdog|qcom_wdt|deferred probe' | tail -100 || true
            } >> /data/vamos-update/trial-failure.log
        fi
        sync
        reboot -f
        while true; do sleep 60; done
    fi
    /usr/bin/vamos-boot reconcile || echo "WARN: failed to reconcile vamOS boot state"
fi

# Keep the operator home on persistent userdata. Image defaults are added on
# every boot without replacing files the operator has changed.
if [ -f /ASIUS ] && [ -d /usr/default/home/comma ] && ! mountpoint -q /home; then
  if mountpoint -q /data; then
    echo "=> Mounting persistent /home"
    mkdir -p /data/home/comma /home
    rsync -a --ignore-existing /usr/default/home/comma/ /data/home/comma/
    chown -R comma:comma /data/home/comma
    mount --bind /data/home /home || echo "ERROR: failed to bind persistent /home"
  else
    echo "=> Persistent userdata unavailable; mounting ephemeral /home overlay"
    mkdir -p /rwtmp/home_work /rwtmp/home_upper /home
    chmod 755 /rwtmp/home_work /rwtmp/home_upper
    mount -t overlay overlay \
      -o lowerdir=/usr/default/home,upperdir=/rwtmp/home_upper,workdir=/rwtmp/home_work \
      /home || echo "ERROR: failed to mount /home overlay"
  fi
fi

# /data writable scaffolding. This is persistent after A/B initialization and
# remains a writable rootfs fallback on legacy installations.
for d in /data/scons_cache /data/media/0/realdata /data/log /data/params/d /data/stats /data/safe_staging \
         /data/etc/NetworkManager/system-connections; do
  mkdir -p "$d" 2>/dev/null || true
done
chown -R comma:comma /data/scons_cache /data/media /data/log /data/params /data/stats /data/safe_staging 2>/dev/null || true
chmod 700 /data/etc/NetworkManager/system-connections 2>/dev/null || true
if [ ! -e /data/.vamos-ssh-seeded ]; then
    if [ ! -s /data/params/d/GithubSshKeys ] && [ -s /usr/comma/setup_keys ]; then
        cp /usr/comma/setup_keys /data/params/d/GithubSshKeys
        chown comma:comma /data/params/d/GithubSshKeys
        chmod 600 /data/params/d/GithubSshKeys
    fi
    touch /data/.vamos-ssh-seeded
fi
echo "=> Setting hostname..."
/usr/comma/set-hostname.sh

echo "=> Running core services..."
for f in /etc/runit/core-services/*.sh; do
    [ -x "$f" ] || continue
    # Skip only the ones we already handled above
    case "$f" in
        *00-pseudofs*|*01-static-devnodes*|*02-kmods*|*02-udev*)
            echo "=> Skipping $f (already done)"
            continue
            ;;
    esac
    echo "=> Running $f"
    "$f" || echo "WARN: $f failed"
done

touch /run/vamos-stage1-ready
echo "=> Stage 1 complete, entering stage 2"
