#!/bin/sh
# runit stage 3 - shutdown
# Wall broadcast is handled by /usr/local/sbin/poweroff wrapper (before runit signals)

PATH=/usr/bin:/usr/sbin

. /etc/runit/functions
detect_container
[ -r /etc/rc.conf ] && . /etc/rc.conf

/usr/bin/vamos-clock checkpoint || echo "WARN: failed to save clock at shutdown"

for f in /etc/runit/shutdown.d/*.sh; do
  [ -r "$f" ] && . "$f"
done
