#!/bin/sh
# openpilot - main openpilot launcher (runs as comma user in tmux)
exec 2>&1

# v1 has no physical display, but the mainline DRM/GPU stack still behaves
# better when the backlight class exists before openpilot starts.
if [ -f /V1 ]; then
  for i in $(seq 1 60); do
    [ -e /dev/dri/card0 ] && break
    sleep 0.5
  done

  if [ ! -d /sys/class/backlight/panel0-backlight ]; then
    mount -t tmpfs tmpfs /sys/class/backlight
    mkdir -p /sys/class/backlight/panel0-backlight
    echo 0 > /sys/class/backlight/panel0-backlight/bl_power
    echo 255 > /sys/class/backlight/panel0-backlight/max_brightness
    echo 128 > /sys/class/backlight/panel0-backlight/brightness
    chmod 666 /sys/class/backlight/panel0-backlight/bl_power
    chmod 666 /sys/class/backlight/panel0-backlight/brightness
  fi
fi

# Wait for filesystem to be ready (skipped on v1, which has no fs_setup service).
if [ ! -f /V1 ]; then
  sv check fs_setup > /dev/null || exit 1

  # Wait for fs_setup to finish mounting /home overlay
  for i in $(seq 1 120); do
    if [ -f /run/fs_setup.ready ] && grep -q 'overlay /home' /proc/mounts 2>/dev/null; then
      break
    fi
    sleep 0.5
  done

fi

mkdir -p /sys/fs/cgroup/openpilot

kill_openpilot() {
  echo 1 > /sys/fs/cgroup/openpilot/cgroup.kill
}

kill_openpilot

cleanup() {
  kill_openpilot
  exit 0
}

trap cleanup TERM INT HUP

# Run as comma user with proper groups and PAM limits
# V1's MSM GPU runtime needs CAP_SYS_RAWIO for trusted command submission.
if [ -f /V1 ]; then
  RUN_AS_COMMA="/usr/sbin/setpriv --reuid=comma --regid=comma --init-groups --inh-caps=+sys_rawio --ambient-caps=+sys_rawio"
else
  # sudo -u properly inherits groups and applies /etc/security/limits.conf
  RUN_AS_COMMA="sudo -u comma"
fi
PANE_CMD="sudo -n /bin/sh -c 'mkdir -p /sys/fs/cgroup/openpilot; echo \$\$ > /sys/fs/cgroup/openpilot/cgroup.procs; exec $RUN_AS_COMMA /usr/bin/bash -l -c /usr/comma/comma.sh'; exec /usr/bin/bash -l"

if sudo -u comma /usr/bin/tmux has-session -t openpilot 2>/dev/null; then
  sudo -u comma /usr/bin/tmux respawn-pane -k -t openpilot:0.0 "$PANE_CMD"
else
  sudo -u comma /usr/bin/tmux new-session -s openpilot -d "$PANE_CMD"
fi

for i in $(seq 1 10); do
  [ -s /sys/fs/cgroup/openpilot/cgroup.procs ] && break
  sleep 0.2
done

# Keep the runit service alive as the control wrapper. openpilot itself may
# briefly exit during build/startup, and runit must not interpret that as a
# reason to restart and kill the tmux command it just launched.
while true; do
  sleep 3600 &
  wait $!
done
