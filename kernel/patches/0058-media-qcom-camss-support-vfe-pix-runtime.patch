+		readl_relaxed(vfe->base + VFE_CAMIF_STATUS),
+		readl_relaxed(vfe->base + VFE_BUS_WM_IMAGE_ADDR(3)),
+		readl_relaxed(vfe->base + VFE_BUS_WM_FRAME_INC(3)),
+		readl_relaxed(vfe->base + VFE_BUS_WM_CFG(3)),
+		readl_relaxed(vfe->base + VFE_BUS_WM_STATUS0(3)),
+		readl_relaxed(vfe->base + VFE_BUS_WM_IMAGE_ADDR(4)),
+		readl_relaxed(vfe->base + VFE_BUS_WM_FRAME_INC(4)),
+		readl_relaxed(vfe->base + VFE_BUS_WM_CFG(4)),
+		readl_relaxed(vfe->base + VFE_BUS_WM_STATUS0(4)),
+		readl_relaxed(vfe->base + VFE_BUS_COMP_GROUP(0)),
+		readl_relaxed(vfe->base + VFE_BUS_DUAL_COMP_GROUP(0)),
+		readl_relaxed(vfe->base + VFE_BUS_ADDR_SYNC_CFG),
+		readl_relaxed(vfe->base + VFE_BUS_ADDR_SYNC_MASK(0)),
+		readl_relaxed(vfe->base + VFE_BUS_WM_ADDR_SYNC_NO_SYNC));
+
+	dev_warn_ratelimited(vfe->camss->dev,
+		"vfe%u pix wm latch wm3_last=0x%08x wm3_last_inc=0x%08x wm3_st1=0x%08x wm4_last=0x%08x wm4_last_inc=0x%08x wm4_st1=0x%08x done_mask=0x%02x\n",
+		id, vfe_pix_last_wm_addr[id][0], vfe_pix_last_wm_inc[id][0],
+		readl_relaxed(vfe->base + VFE_BUS_WM_STATUS1(3)),
