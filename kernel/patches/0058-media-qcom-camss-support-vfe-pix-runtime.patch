+	vfe_pix_comp_count[id] = 0;
+	vfe_pix_dual_count[id] = 0;
+	vfe_pix_wm3_count[id] = 0;
+	vfe_pix_wm4_count[id] = 0;
+	vfe_pix_last_warn_sof[id] = 0;
+	vfe_pix_last_wm_addr[id][0] = 0;
+	vfe_pix_last_wm_addr[id][1] = 0;
+	vfe_pix_last_wm_inc[id][0] = 0;
+	vfe_pix_last_wm_inc[id][1] = 0;
+	vfe_pix_last_prog_idx[id][0] = 0xffffffff;
+	vfe_pix_last_prog_idx[id][1] = 0xffffffff;
+	vfe_pix_last_ready_idx[id] = 0xffffffff;
+	vfe_pix_last_next_idx[id] = 0xffffffff;
+	vfe_pix_last_active_num[id] = 0;
+	vfe_pix_last_seq[id] = 0;
+	vfe_pix_partial_done_sof[id] = 0;
+	vfe_pix_recover_count[id] = 0;
+	vfe_pix_pair_recover_sof[id] = 0;
+	vfe_pix_last_completed_count[id] = 0;
+	vfe_pix_last_progress_sof[id] = 0;
