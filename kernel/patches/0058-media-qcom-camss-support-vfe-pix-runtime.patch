+static void vfe_pix_maybe_log_stall(struct vfe_device *vfe, u32 irq0, u32 irq1,
+				    u32 bus0, u32 bus1, u32 bus2)
+{
+	unsigned int id = vfe->id;
+	u32 sof_gap;
+
+	if (id >= 4)
+		return;
+
+	{
+		u32 completed = vfe_pix_comp_count[id] + vfe_pix_wm4_count[id] +
+			vfe_pix_recover_count[id];
+
+		if (completed != vfe_pix_last_completed_count[id]) {
+			vfe_pix_last_completed_count[id] = completed;
+			vfe_pix_last_progress_sof[id] = vfe_pix_sof_count[id];
+			return;
+		}
+	}
+	sof_gap = vfe_pix_sof_count[id] - vfe_pix_last_progress_sof[id];
+	if (sof_gap < VFE_PIX_STALL_SOF_GAP)
+		return;
+	if (vfe_pix_sof_count[id] - vfe_pix_last_warn_sof[id] < VFE_PIX_STALL_SOF_GAP)
+		return;
+
+	vfe_pix_last_warn_sof[id] = vfe_pix_sof_count[id];
+	dev_warn_ratelimited(vfe->camss->dev,
+		"vfe%u pix stall? sof=%u reg=%u comp=%u dual=%u wm3=%u wm4=%u gap=%u irq0=0x%08x irq1=0x%08x bus0=0x%08x bus1=0x%08x bus2=0x%08x camif=0x%08x wm3_addr=0x%08x wm3_inc=0x%08x wm3_cfg=0x%08x wm3_st0=0x%08x wm4_addr=0x%08x wm4_inc=0x%08x wm4_cfg=0x%08x wm4_st0=0x%08x comp0=0x%08x dual0=0x%08x addrsync=0x%08x addrmask0=0x%08x nosync=0x%08x\n",
+		id, vfe_pix_sof_count[id], vfe_pix_reg_count[id],
+		vfe_pix_comp_count[id], vfe_pix_dual_count[id],
