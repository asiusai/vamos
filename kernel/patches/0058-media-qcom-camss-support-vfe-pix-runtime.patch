+static void vfe_pix_recover_stalled_partial(struct vfe_device *vfe)
+{
+	struct vfe_output *output = &vfe->line[VFE_LINE_PIX].output;
+	unsigned int id = vfe->id;
+	unsigned int missing;
+	u8 all_done;
+	u8 done;
+
+	if (id >= ARRAY_SIZE(vfe_pix_wm_done_mask))
+		return;
+
+	if (output->state != VFE_OUTPUT_ON || output->wm_num < 2)
+		return;
+
+	done = vfe_pix_wm_done_mask[id];
+	all_done = (1 << output->wm_num) - 1;
+	if (!done || (done & all_done) == all_done)
+		return;
+
+	if (vfe_pix_sof_count[id] - vfe_pix_partial_done_sof[id] <
+	    VFE_PIX_RECOVER_SOF_GAP)
+		return;
+
+	for (missing = 0; missing < output->wm_num; missing++)
+		if (!(done & BIT(missing)))
+			break;
+	if (missing >= output->wm_num)
+		return;
+
+	vfe_pix_recover_count[id]++;
+	dev_warn_ratelimited(vfe->camss->dev,
+			     "vfe%u pix recovering missing PIX wm done mask=0x%x missing=%u seq=%u sof=%u wm3=%u wm4=%u dual=%u recover=%u\n",
+			     id, done, missing, vfe_pix_last_seq[id],
+			     vfe_pix_sof_count[id], vfe_pix_wm3_count[id],
+			     vfe_pix_wm4_count[id], vfe_pix_dual_count[id],
+			     vfe_pix_recover_count[id]);
+
+	vfe->isr_ops.wm_done(vfe, output->wm_idx[missing]);
+}
+
+static void vfe_pix_recover_stalled_pair(struct vfe_device *vfe)
+{
+	struct vfe_output *output = &vfe->line[VFE_LINE_PIX].output;
+	unsigned int id = vfe->id;
+	u32 sof_gap;
+
+	if (id >= ARRAY_SIZE(vfe_pix_wm_done_mask))
+		return;
+
+	if (output->state != VFE_OUTPUT_ON || output->wm_num < 2)
+		return;
+
+	if (vfe_pix_wm_done_mask[id] != 0)
+		return;
+
+	sof_gap = vfe_pix_sof_count[id] - vfe_pix_last_progress_sof[id];
+	if (sof_gap < VFE_PIX_STALL_SOF_GAP)
+		return;
+
+	if (vfe_pix_sof_count[id] - vfe_pix_pair_recover_sof[id] <
+	    VFE_PIX_PAIR_RECOVER_SOF_GAP)
+		return;
+
+	vfe_pix_pair_recover_sof[id] = vfe_pix_sof_count[id];
+	vfe_pix_recover_count[id]++;
+	dev_warn_ratelimited(vfe->camss->dev,
+			     "vfe%u pix recovering stalled WM pair seq=%u sof=%u wm3=%u wm4=%u dual=%u recover=%u\n",
+			     id, vfe_pix_last_seq[id], vfe_pix_sof_count[id],
+			     vfe_pix_wm3_count[id], vfe_pix_wm4_count[id],
+			     vfe_pix_dual_count[id], vfe_pix_recover_count[id]);
+
+	vfe->isr_ops.wm_done(vfe, output->wm_idx[0]);
+	vfe->isr_ops.wm_done(vfe, output->wm_idx[1]);
+}
