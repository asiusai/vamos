--- /dev/null
+++ b/drivers/leds/trigger/ledtrig-asius-boot.c
@@ -0,0 +1,159 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Warm-white Knight Rider startup, shared phase across both light windows. */
+#include <linux/init.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/leds.h>
+#include <linux/math64.h>
+#include <linux/timekeeping.h>
+#include <linux/timer.h>
+
+#define ASIUS_BOOT_PERIOD_MS 3000
+#define ASIUS_BOOT_STEP_MS 33
+
+/* Generated by tools/build/generate_boot_led_pattern.py: LEDs 1-6, with 2 and 5 at 10%. */
