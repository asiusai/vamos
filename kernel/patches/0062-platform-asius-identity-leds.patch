+
+static const char * const asius_boot_names[6][3] = {
+	{ "asius-boot-1-r", "asius-boot-1-g", "asius-boot-1-b" },
+	{ "asius-boot-2-r", "asius-boot-2-g", "asius-boot-2-b" },
+	{ "asius-boot-3-r", "asius-boot-3-g", "asius-boot-3-b" },
+	{ "asius-boot-4-r", "asius-boot-4-g", "asius-boot-4-b" },
+	{ "asius-boot-5-r", "asius-boot-5-g", "asius-boot-5-b" },
+	{ "asius-boot-6-r", "asius-boot-6-g", "asius-boot-6-b" },
+};
+static const u8 asius_boot_color[3] = { 255, 195, 120 };
+static struct led_trigger *asius_boot_triggers[6][3];
+static struct timer_list asius_boot_timer;
+
+static void asius_boot_update(struct timer_list *timer)
+{
+	unsigned int ms = div_u64(ktime_get_ns(), NSEC_PER_MSEC) % ASIUS_BOOT_PERIOD_MS;
+	unsigned int frame = ms * ARRAY_SIZE(asius_boot_frames) / ASIUS_BOOT_PERIOD_MS;
+	unsigned int led, color, brightness;
+
+	for (led = 0; led < 6; led++) {
+		for (color = 0; color < 3; color++) {
+			brightness = DIV_ROUND_CLOSEST(asius_boot_frames[frame][led] *
+						      asius_boot_color[color], 255);
+			led_trigger_event(asius_boot_triggers[led][color], brightness);
+		}
+	}
+	mod_timer(timer, jiffies + msecs_to_jiffies(ASIUS_BOOT_STEP_MS));
+}
+
+static int __init asius_boot_init(void)
+{
+	unsigned int led, color;
+
+	for (led = 0; led < 6; led++) {
+		for (color = 0; color < 3; color++) {
+			led_trigger_register_simple(asius_boot_names[led][color],
+						    &asius_boot_triggers[led][color]);
+			if (!asius_boot_triggers[led][color])
+				goto fail;
+		}
+	}
+	timer_setup(&asius_boot_timer, asius_boot_update, 0);
+	asius_boot_update(&asius_boot_timer);
+	return 0;
+
+fail:
+	for (led = 0; led < 6; led++)
+		for (color = 0; color < 3; color++)
+			if (asius_boot_triggers[led][color])
+				led_trigger_unregister_simple(asius_boot_triggers[led][color]);
+	return -ENOMEM;
+}
+subsys_initcall(asius_boot_init);
