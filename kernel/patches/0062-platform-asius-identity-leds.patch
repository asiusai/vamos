From: Asius <dev@asius.ai>
Subject: [PATCH] platform: arm64: expose Asius SOM identity and boot LED trigger

Rebased for Linux 7.2.7 from the existing VamOS patch series.
See kernel/README.md for provenance, scope and removed patches.

---
diff --git a/drivers/leds/trigger/Kconfig b/drivers/leds/trigger/Kconfig
index c11282a74b5ac3c9b6028cda12f79991a196adec..827d37e879f5154c1821ad9380b6513f41f884e1 100644
--- a/drivers/leds/trigger/Kconfig
+++ b/drivers/leds/trigger/Kconfig
@@ -19,6 +19,14 @@ config LEDS_TRIGGER_TIMER
 
 	  If unsure, say Y.
 
+config LEDS_TRIGGER_ASIUS_BOOT
+	bool "Asius synchronized camera boot trigger"
+	help
+	  Animate camera-board status LEDs from one shared timer so every
+	  available board displays the same boot phase. LEDs using the
+	  "asius-boot-*" triggers sweep warm white every three seconds until
+	  userspace selects another trigger or sets brightness directly.
+
 config LEDS_TRIGGER_ONESHOT
 	tristate "LED One-shot Trigger"
 	help
