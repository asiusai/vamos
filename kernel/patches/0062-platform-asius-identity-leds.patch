diff --git a/drivers/platform/arm64/asius-v0-som-id.c b/drivers/platform/arm64/asius-v0-som-id.c
new file mode 100644
index 0000000000000000000000000000000000000000..6c2c8e452e14e2c18cc3e14c13ff6bc06eb2abbb
--- /dev/null
+++ b/drivers/platform/arm64/asius-v0-som-id.c
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/sysfs.h>
+
+static char asius_v0_model[] = "asius v0";
+static struct property asius_v0_model_property = {
+	.name = "model",
+	.length = sizeof(asius_v0_model),
+	.value = asius_v0_model,
+};
+
+static ssize_t som_id_show(struct device *dev,
+			   struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "0\n");
+}
+static DEVICE_ATTR_RO(som_id);
+
+static int __init asius_v0_som_id_init(void)
+{
+	struct platform_device *som_id;
+	struct platform_device *vendor;
+	int ret;
+
+	if (!of_machine_is_compatible("radxa,dragon-q6a"))
+		return 0;
+
+	ret = of_update_property(of_root, &asius_v0_model_property);
+	if (ret)
+		return ret;
+
+	vendor = platform_device_register_simple("vendor", PLATFORM_DEVID_NONE,
+						 NULL, 0);
+	if (IS_ERR(vendor))
+		return PTR_ERR(vendor);
+
+	som_id = platform_device_alloc("vendor:gpio-som-id",
+				       PLATFORM_DEVID_NONE);
+	if (!som_id) {
+		ret = -ENOMEM;
+		goto unregister_vendor;
+	}
+	som_id->dev.parent = &vendor->dev;
+
+	ret = platform_device_add(som_id);
+	if (ret) {
+		platform_device_put(som_id);
+		goto unregister_vendor;
+	}
+
+	ret = device_create_file(&som_id->dev, &dev_attr_som_id);
+	if (ret) {
+		platform_device_unregister(som_id);
+		goto unregister_vendor;
+	}
+
+	return 0;
+
+unregister_vendor:
+	platform_device_unregister(vendor);
+	return ret;
+}
+device_initcall(asius_v0_som_id_init);
+
+MODULE_DESCRIPTION("Asius v0 hardware identity");
+MODULE_LICENSE("GPL");
