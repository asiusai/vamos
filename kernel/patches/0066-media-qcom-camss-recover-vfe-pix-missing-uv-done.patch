 			if (wm != output->wm_idx[output->wm_num - 1])
 				goto out_unlock;
 		} else {
+			old_done = vfe_pix_wm_done_mask[vfe->id];
 			for (i = 0; i < output->wm_num; i++) {
 				if (wm == output->wm_idx[i]) {
 					vfe_pix_wm_done_mask[vfe->id] |= BIT(i);
 					found = true;
 					break;
 				}
 			}
 
+			if (!old_done && found)
+				vfe_pix_partial_done_sof[vfe->id] =
+					vfe_pix_sof_count[vfe->id];
+
 			if (!found ||
 			    (vfe_pix_wm_done_mask[vfe->id] & all_done) != all_done)
 				goto out_unlock;
