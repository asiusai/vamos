diff --git a/drivers/media/i2c/os04c10.c b/drivers/media/i2c/os04c10.c
new file mode 100644
index 0000000..389645a
--- /dev/null
+++ b/drivers/media/i2c/os04c10.c
@@ -0,0 +1,588 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * OmniVision OS04C10 CMOS Image Sensor Driver
+ *
+ * This intentionally keeps the sensor register table in userspace. camerad
+ * writes comma's OS04C10 init/start/exposure arrays through SENSOR_WRITE_REGS.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/uaccess.h>
+#include <linux/vmalloc.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-mediabus.h>
+
+#include <uapi/linux/qcom-camss-vfe.h>
+
+#define OS04C10_XCLK_FREQ		24000000
+#define OS04C10_LINK_FREQ		456000000ULL
+#define OS04C10_PIXEL_RATE		182400000ULL
+
+#define OS04C10_REG_CHIP_ID_H		CCI_REG8(0x300a)
+#define OS04C10_REG_CHIP_ID_L		CCI_REG8(0x300b)
+#define OS04C10_CHIP_ID_H		0x53
+#define OS04C10_CHIP_ID_L		0x04
+
+#define OS04C10_NATIVE_WIDTH		2688
+#define OS04C10_NATIVE_HEIGHT		1520
+
+#define to_os04c10(_sd) container_of(_sd, struct os04c10, sd)
+
+static const s64 os04c10_link_freq_menu[] = {
+	OS04C10_LINK_FREQ,
+};
+
+static const char * const os04c10_supply_name[] = {
+	"avdd",
+	"dovdd",
+	"dvdd",
+};
+
+struct os04c10 {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *pixel_rate;
+
+	struct device *dev;
+	struct regmap *cci;
+	struct clk *xclk;
+	struct gpio_desc *enable_gpio;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(os04c10_supply_name)];
+	unsigned long link_freq_bitmap;
+	bool powered;
+	u32 mbus_code;
+	u32 active_width;
+	u32 active_height;
+};
+
+static void os04c10_fill_format(struct v4l2_mbus_framefmt *fmt, u32 code)
+{
+	if (!fmt->width || fmt->width > OS04C10_NATIVE_WIDTH)
+		fmt->width = OS04C10_NATIVE_WIDTH;
+	if (!fmt->height || fmt->height > OS04C10_NATIVE_HEIGHT)
+		fmt->height = OS04C10_NATIVE_HEIGHT;
+	if (code != MEDIA_BUS_FMT_SBGGR12_1X12)
+		code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->code = code;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int os04c10_power_on(struct device *dev);
+
+static long os04c10_ioctl(struct v4l2_subdev *sd, unsigned int cmd, void *arg)
+{
+	struct os04c10 *sensor = to_os04c10(sd);
+	struct sensor_write_regs_cmd *wcmd = arg;
+	struct sensor_reg_write *regs;
+	unsigned int i;
+	int ret = 0;
+
+	if (cmd != SENSOR_WRITE_REGS)
+		return -ENOIOCTLCMD;
+
+	if (!wcmd || wcmd->count == 0 || wcmd->count > 4096)
+		return -EINVAL;
+
+	if (wcmd->data_width != 1 && wcmd->data_width != 2)
+		return -EINVAL;
+
+	regs = kvmalloc_array(wcmd->count, sizeof(*regs), GFP_KERNEL);
+	if (!regs)
+		return -ENOMEM;
+
+	if (copy_from_user(regs, u64_to_user_ptr(wcmd->regs),
+			   wcmd->count * sizeof(*regs))) {
+		ret = -EFAULT;
+		goto out;
+	}
+
+	if (!sensor->powered) {
+		ret = os04c10_power_on(sensor->dev);
+		if (ret < 0)
+			goto out;
+	}
+
+	for (i = 0; i < wcmd->count; i++) {
+		if (wcmd->data_width == 2)
+			ret = cci_write(sensor->cci, CCI_REG16(regs[i].addr),
+					regs[i].data, NULL);
+		else
+			ret = cci_write(sensor->cci, CCI_REG8(regs[i].addr),
+					regs[i].data & 0xff, NULL);
+		if (ret)
+			goto out;
+	}
+
+out:
+	kvfree(regs);
+	return ret;
+}
+
+static int os04c10_get_fmt(struct v4l2_subdev *sd,
+			   struct v4l2_subdev_state *state,
+			   struct v4l2_subdev_format *fmt)
+{
+	struct os04c10 *sensor = to_os04c10(sd);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		fmt->format = *v4l2_subdev_state_get_format(state, fmt->pad);
+	else {
+		fmt->format.width = sensor->active_width ?: OS04C10_NATIVE_WIDTH;
+		fmt->format.height = sensor->active_height ?: OS04C10_NATIVE_HEIGHT;
+		os04c10_fill_format(&fmt->format, sensor->mbus_code);
+	}
+
+	return 0;
+}
+
+static int os04c10_set_fmt(struct v4l2_subdev *sd,
+			   struct v4l2_subdev_state *state,
+			   struct v4l2_subdev_format *fmt)
+{
+	struct os04c10 *sensor = to_os04c10(sd);
+
+	os04c10_fill_format(&fmt->format, fmt->format.code);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		*v4l2_subdev_state_get_format(state, fmt->pad) = fmt->format;
+	else {
+		sensor->mbus_code = fmt->format.code;
+		sensor->active_width = fmt->format.width;
+		sensor->active_height = fmt->format.height;
+	}
+
+	return 0;
+}
+
+static int os04c10_enum_mbus_code(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_mbus_code_enum *code)
+{
+	switch (code->index) {
+	case 0:
+		code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+		break;
+	case 1:
+		code->code = MEDIA_BUS_FMT_SBGGR12_1X12;
+		break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static int os04c10_enum_frame_size(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state,
+				   struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index > 0 ||
+	    (fse->code != MEDIA_BUS_FMT_SBGGR12_1X12 &&
+	     fse->code != MEDIA_BUS_FMT_SBGGR10_1X10))
+		return -EINVAL;
+
+	fse->min_width = 1;
+	fse->max_width = OS04C10_NATIVE_WIDTH;
+	fse->min_height = 1;
+	fse->max_height = OS04C10_NATIVE_HEIGHT;
+	return 0;
+}
+
+static int os04c10_init_state(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *fmt =
+		v4l2_subdev_state_get_format(state, 0);
+
+	fmt->width = OS04C10_NATIVE_WIDTH;
+	fmt->height = OS04C10_NATIVE_HEIGHT;
+	os04c10_fill_format(fmt, MEDIA_BUS_FMT_SBGGR10_1X10);
+	return 0;
+}
+
+static int os04c10_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct os04c10 *sensor = to_os04c10(sd);
+	int ret;
+
+	if (sensor->powered)
+		return 0;
+
+	gpiod_set_value_cansleep(sensor->reset_gpio, 0);
+	usleep_range(1000, 2000);
+
+	if (sensor->enable_gpio) {
+		gpiod_set_value_cansleep(sensor->enable_gpio, 1);
+		usleep_range(1000, 2000);
+	}
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(os04c10_supply_name),
+				    sensor->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to enable regulators\n");
+
+	ret = clk_prepare_enable(sensor->xclk);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to enable xclk\n");
+		goto reg_off;
+	}
+
+	usleep_range(5000, 6000);
+	gpiod_set_value_cansleep(sensor->reset_gpio, 1);
+	usleep_range(50000, 51000);
+
+	sensor->powered = true;
+	return 0;
+
+reg_off:
+	regulator_bulk_disable(ARRAY_SIZE(os04c10_supply_name),
+			       sensor->supplies);
+	if (sensor->enable_gpio)
+		gpiod_set_value_cansleep(sensor->enable_gpio, 0);
+	return ret;
+}
+
+static int os04c10_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct os04c10 *sensor = to_os04c10(sd);
+
+	if (!sensor->powered)
+		return 0;
+
+	sensor->powered = false;
+	gpiod_set_value_cansleep(sensor->reset_gpio, 0);
+	clk_disable_unprepare(sensor->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(os04c10_supply_name),
+			       sensor->supplies);
+	if (sensor->enable_gpio)
+		gpiod_set_value_cansleep(sensor->enable_gpio, 0);
+	return 0;
+}
+
+static int os04c10_set_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct os04c10 *sensor = to_os04c10(sd);
+
+	if (enable)
+		return os04c10_power_on(sensor->dev);
+
+	cci_write(sensor->cci, CCI_REG8(0x0100), 0, NULL);
+	os04c10_power_off(sensor->dev);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops os04c10_video_ops = {
+	.s_stream = os04c10_set_stream,
+};
+
+static const struct v4l2_subdev_pad_ops os04c10_pad_ops = {
+	.get_fmt = os04c10_get_fmt,
+	.set_fmt = os04c10_set_fmt,
+	.enum_mbus_code = os04c10_enum_mbus_code,
+	.enum_frame_size = os04c10_enum_frame_size,
+};
+
+static const struct v4l2_subdev_core_ops os04c10_core_ops = {
+	.subscribe_event = v4l2_ctrl_subdev_subscribe_event,
+	.unsubscribe_event = v4l2_event_subdev_unsubscribe,
+	.ioctl = os04c10_ioctl,
+};
+
+static const struct v4l2_subdev_ops os04c10_subdev_ops = {
+	.core = &os04c10_core_ops,
+	.video = &os04c10_video_ops,
+	.pad = &os04c10_pad_ops,
+};
+
+static const struct media_entity_operations os04c10_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static const struct v4l2_subdev_internal_ops os04c10_internal_ops = {
+	.init_state = os04c10_init_state,
+};
+
+static int os04c10_identify_module(struct os04c10 *sensor)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&sensor->sd);
+	u64 val_h, val_l;
+	int ret;
+
+	ret = cci_read(sensor->cci, OS04C10_REG_CHIP_ID_H, &val_h, NULL);
+	if (ret)
+		return dev_warn_probe(&client->dev, ret,
+				      "failed to read chip id high byte\n");
+
+	ret = cci_read(sensor->cci, OS04C10_REG_CHIP_ID_L, &val_l, NULL);
+	if (ret)
+		return dev_warn_probe(&client->dev, ret,
+				      "failed to read chip id low byte\n");
+
+	if (val_h != OS04C10_CHIP_ID_H || val_l != OS04C10_CHIP_ID_L)
+		return dev_warn_probe(&client->dev, -EIO,
+				      "chip id mismatch: expected %02x%02x, got %02llx%02llx\n",
+				      OS04C10_CHIP_ID_H, OS04C10_CHIP_ID_L,
+				      val_h, val_l);
+
+	dev_info(&client->dev, "OS04C10 chip ID verified: 0x%02llx%02llx\n",
+		 val_h, val_l);
+	return 0;
+}
+
+static int os04c10_get_regulators(struct os04c10 *sensor)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&sensor->sd);
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(os04c10_supply_name); i++)
+		sensor->supplies[i].supply = os04c10_supply_name[i];
+
+	return devm_regulator_bulk_get(&client->dev,
+				       ARRAY_SIZE(os04c10_supply_name),
+				       sensor->supplies);
+}
+
+static int os04c10_check_hwcfg(struct device *dev, struct os04c10 *sensor)
+{
+	struct fwnode_handle *endpoint;
+	struct v4l2_fwnode_endpoint ep_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint)
+		return dev_err_probe(dev, -EINVAL, "endpoint node not found\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep_cfg);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to parse endpoint\n");
+		goto out;
+	}
+
+	if (ep_cfg.bus.mipi_csi2.num_data_lanes != 2) {
+		ret = dev_err_probe(dev, -EINVAL,
+				    "only two CSI-2 data lanes are supported\n");
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(dev, ep_cfg.link_frequencies,
+				       ep_cfg.nr_of_link_frequencies,
+				       os04c10_link_freq_menu,
+				       ARRAY_SIZE(os04c10_link_freq_menu),
+				       &sensor->link_freq_bitmap);
+	if (ret)
+		dev_err_probe(dev, ret, "link frequency not supported\n");
+
+out:
+	v4l2_fwnode_endpoint_free(&ep_cfg);
+	fwnode_handle_put(endpoint);
+	return ret;
+}
+
+static int os04c10_init_controls(struct os04c10 *sensor)
+{
+	struct v4l2_ctrl_handler *hdl = &sensor->ctrl_handler;
+	int ret;
+
+	v4l2_ctrl_handler_init(hdl, 2);
+
+	sensor->link_freq = v4l2_ctrl_new_int_menu(
+		hdl, NULL, V4L2_CID_LINK_FREQ,
+		ARRAY_SIZE(os04c10_link_freq_menu) - 1, 0,
+		os04c10_link_freq_menu);
+	if (sensor->link_freq)
+		sensor->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	sensor->pixel_rate = v4l2_ctrl_new_std(
+		hdl, NULL, V4L2_CID_PIXEL_RATE,
+		OS04C10_PIXEL_RATE, OS04C10_PIXEL_RATE, 1,
+		OS04C10_PIXEL_RATE);
+	if (sensor->pixel_rate)
+		sensor->pixel_rate->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	ret = hdl->error;
+	if (ret) {
+		v4l2_ctrl_handler_free(hdl);
+		return ret;
+	}
+
+	sensor->sd.ctrl_handler = hdl;
+	return 0;
+}
+
+static int os04c10_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct os04c10 *sensor;
+	int ret, i;
+
+	sensor = devm_kzalloc(dev, sizeof(*sensor), GFP_KERNEL);
+	if (!sensor)
+		return -ENOMEM;
+
+	sensor->mbus_code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	sensor->dev = dev;
+	v4l2_i2c_subdev_init(&sensor->sd, client, &os04c10_subdev_ops);
+	sensor->sd.internal_ops = &os04c10_internal_ops;
+
+	ret = os04c10_check_hwcfg(dev, sensor);
+	if (ret)
+		return ret;
+
+	sensor->cci = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sensor->cci))
+		return dev_err_probe(dev, PTR_ERR(sensor->cci),
+				     "failed to initialize CCI\n");
+
+	sensor->xclk = devm_v4l2_sensor_clk_get_legacy(dev, NULL, true,
+						       OS04C10_XCLK_FREQ);
+	if (IS_ERR(sensor->xclk))
+		return dev_err_probe(dev, PTR_ERR(sensor->xclk),
+				     "failed to get xclk\n");
+
+	if (clk_get_rate(sensor->xclk) != OS04C10_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "xclk frequency not supported: %lu Hz\n",
+				     clk_get_rate(sensor->xclk));
+
+	ret = os04c10_get_regulators(sensor);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	sensor->enable_gpio = devm_gpiod_get_optional(dev, "enable",
+						      GPIOD_OUT_LOW);
+	if (IS_ERR(sensor->enable_gpio))
+		return PTR_ERR(sensor->enable_gpio);
+
+	sensor->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_LOW);
+	if (IS_ERR(sensor->reset_gpio))
+		return PTR_ERR(sensor->reset_gpio);
+
+	ret = os04c10_power_on(dev);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < 4; i++) {
+		ret = os04c10_identify_module(sensor);
+		if (!ret)
+			break;
+		if (i == 3)
+			break;
+
+		dev_warn(dev, "chip id read failed on attempt %d, power cycling sensor: %d\n",
+			 i + 1, ret);
+		os04c10_power_off(dev);
+		usleep_range(20000, 30000);
+		ret = os04c10_power_on(dev);
+		if (ret)
+			return ret;
+	}
+	if (ret)
+		dev_warn(dev, "registering optional OS04C10 node without sensor response: %d\n",
+			 ret);
+
+	ret = os04c10_init_controls(sensor);
+	if (ret)
+		goto error_power_off;
+
+	sensor->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE |
+			    V4L2_SUBDEV_FL_HAS_EVENTS;
+	sensor->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sensor->sd.entity.ops = &os04c10_entity_ops;
+	sensor->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&sensor->sd.entity, 1, &sensor->pad);
+	if (ret)
+		goto error_handler_free;
+
+	sensor->sd.state_lock = sensor->ctrl_handler.lock;
+	ret = v4l2_subdev_init_finalize(&sensor->sd);
+	if (ret)
+		goto error_media_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sensor->sd);
+	if (ret)
+		goto error_subdev_cleanup;
+
+	return 0;
+
+error_subdev_cleanup:
+	v4l2_subdev_cleanup(&sensor->sd);
+	pm_runtime_disable(dev);
+
+error_media_entity:
+	media_entity_cleanup(&sensor->sd.entity);
+
+error_handler_free:
+	v4l2_ctrl_handler_free(sensor->sd.ctrl_handler);
+
+error_power_off:
+	os04c10_power_off(dev);
+	return ret;
+}
+
+static void os04c10_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct os04c10 *sensor = to_os04c10(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+
+	pm_runtime_disable(&client->dev);
+	os04c10_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id os04c10_dt_ids[] = {
+	{ .compatible = "ovti,os04c10" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, os04c10_dt_ids);
+
+static const struct dev_pm_ops os04c10_pm_ops = {
+	SET_RUNTIME_PM_OPS(os04c10_power_off, os04c10_power_on, NULL)
+};
+
+static struct i2c_driver os04c10_i2c_driver = {
+	.driver = {
+		.name = "os04c10",
+		.of_match_table = os04c10_dt_ids,
+		.pm = &os04c10_pm_ops,
+	},
+	.probe = os04c10_probe,
+	.remove = os04c10_remove,
+};
+
+module_i2c_driver(os04c10_i2c_driver);
+
+MODULE_AUTHOR("Asius");
+MODULE_DESCRIPTION("OmniVision OS04C10 sensor driver");
+MODULE_LICENSE("GPL");
