+
+	node = fdt_path_offset(fdt, path);
+	if (node < 0)
+		return node;
+
+	return fdt_setprop_u32(fdt, node, name, value);
+}
+
+static int asius_configure_cci_bus(void *fdt, const char *path)
+{
+	int bus;
+
+	bus = fdt_path_offset(fdt, path);
+	if (bus < 0)
+		return bus;
+
+	return fdt_setprop_string(fdt, bus, "status", "okay") ?:
+	       fdt_setprop_u32(fdt, bus, "clock-frequency", 1000000) ?:
+	       fdt_setprop_u32(fdt, bus, "#address-cells", 1) ?:
+	       fdt_setprop_u32(fdt, bus, "#size-cells", 0);
+}
+
+static int asius_configure_camera_leds(void *fdt, const char *path,
+				       int camera_number)
+{
+	char child_name[] = "led@1";
+	char label[sizeof("asius:cam1:green:0")];
+	int controller;
+	int child;
+	int status;
+	int i;
+
+	controller = fdt_path_offset(fdt, path);
+	if (controller < 0)
+		return controller;
+
+	status = fdt_setprop_string(fdt, controller, "compatible",
+				    "issi,is31fl3199") ?:
+		 fdt_setprop_u32(fdt, controller, "reg", 0x64) ?:
+		 fdt_setprop_u32(fdt, controller, "#address-cells", 1) ?:
+		 fdt_setprop_u32(fdt, controller, "#size-cells", 0);
+	if (status)
+		return status;
+
+	for (i = 0; i < 9; i++) {
+		child_name[4] = '1' + i;
+		child = asius_fdt_subnode(fdt, controller, child_name);
+		if (child < 0)
+			return child;
+
+		switch (i % 3) {
+		case 0:
+			snprintf(label, sizeof(label), "asius:cam%d:red:%d",
+				 camera_number, i / 3);
+			break;
+		case 1:
+			snprintf(label, sizeof(label), "asius:cam%d:green:%d",
+				 camera_number, i / 3);
+			break;
+		default:
+			snprintf(label, sizeof(label), "asius:cam%d:blue:%d",
+				 camera_number, i / 3);
+			break;
+		}
+
+		status = fdt_setprop_u32(fdt, child, "reg", i + 1) ?:
+			 fdt_setprop_string(fdt, child, "label", label) ?:
+			 fdt_setprop_u32(fdt, child, "led-max-microamp",
+					 40000);
+		if (status)
+			return status;
+
+		if ((i % 3) == 2 && camera_number != 1) {
+			status = fdt_setprop_string(fdt, child,
+						   "linux,default-trigger",
+						   "asius-boot") ?:
+				 asius_fdt_delprop_optional(fdt, child,
+							    "led-pattern");
+		} else {
+			status = asius_fdt_delprop_optional(fdt, child,
+							    "linux,default-trigger") ?:
+				 asius_fdt_delprop_optional(fdt, child,
+							    "led-pattern");
+		}
+		if (status)
+			return status;
+	}
+
+	return 0;
+}
+
+static int asius_configure_cam_mclk_pinctrl(void *fdt, const char *path,
+					    const char *pin, const char *bias)
+{
+	int node;
+
+	node = fdt_path_offset(fdt, path);
+	if (node < 0)
+		return node;
+
+	return fdt_setprop_string(fdt, node, "pins", pin) ?:
+	       fdt_setprop_string(fdt, node, "function", "cam_mclk") ?:
+	       fdt_setprop_u32(fdt, node, "drive-strength", 2) ?:
+	       fdt_setprop(fdt, node, bias, NULL, 0);
+}
+
+static int asius_configure_fixed_clock(void *fdt, const char *path,
+				       const char *name, u32 frequency,
+				       u32 *phandle)
+{
+	int node;
+	int status;
+
+	node = fdt_path_offset(fdt, path);
+	if (node < 0)
+		return node;
+
+	status = fdt_setprop_string(fdt, node, "status", "okay") ?:
+		 fdt_setprop_string(fdt, node, "compatible", "fixed-clock") ?:
+		 fdt_setprop_u32(fdt, node, "clock-frequency", frequency) ?:
+		 fdt_setprop_string(fdt, node, "clock-output-names", name) ?:
+		 fdt_setprop_u32(fdt, node, "#clock-cells", 0) ?:
+		 asius_fdt_node_phandle(fdt, path, phandle);
+
+	return status;
+}
+
+static int asius_configure_camss_port(void *fdt, int index,
+				      const char *port_path,
+				      const char *endpoint_path,
+				      u32 *endpoint_phandle)
+{
+	const u32 data_lanes[] = { 0, 1 };
+	const u32 lane_polarities[] = { 0, 0, 0 };
+	int endpoint;
+	int port;
+	int status;
+
+	port = fdt_path_offset(fdt, port_path);
+	if (port < 0)
+		return port;
+
+	status = fdt_setprop_u32(fdt, port, "reg", index);
+	if (status)
+		return status;
+
+	endpoint = asius_fdt_ensure_child(fdt, port_path, "endpoint",
+					  endpoint_path);
+	if (endpoint < 0)
+		return endpoint;
+
+	status = fdt_setprop_u32(fdt, endpoint, "clock-lanes", 7) ?:
+		 asius_fdt_setprop_u32_array(fdt, endpoint, "data-lanes",
+					     data_lanes, ARRAY_SIZE(data_lanes)) ?:
+		 asius_fdt_setprop_u32_array(fdt, endpoint, "lane-polarities",
+					     lane_polarities,
+					     ARRAY_SIZE(lane_polarities)) ?:
+		 asius_fdt_assign_phandle(fdt, endpoint_path,
+					  endpoint_phandle);
+
+	return status;
+}
+
+static int asius_configure_camera_sensor(void *fdt, const char *sensor_path,
+					 const char *sensor_port_path,
+					 const char *sensor_endpoint_path,
+					 const char *compatible, u32 i2c_addr,
+					 u32 camcc_phandle, u32 mclk,
+					 u32 mclk_default_phandle,
+					 u32 mclk_suspend_phandle,
+					 int use_camcc_mclk,
+					 u32 reset_phandle, u32 reset_gpio,
+					 u32 enable_gpio,
+					 u64 link_frequency,
+					 u32 *endpoint_phandle)
+{
+	const u32 data_lanes[] = { 1, 2 };
+	const char pinctrl_names[] = "default\0suspend";
+	u32 clock_cells[] = { camcc_phandle, mclk };
+	u32 pinctrl0_cells[] = { mclk_default_phandle };
+	u32 pinctrl1_cells[] = { mclk_suspend_phandle };
+	u32 reset_cells[] = { reset_phandle, reset_gpio, 0 };
+	u32 enable_cells[] = { reset_phandle, enable_gpio, 0 };
+	int endpoint;
+	int sensor;
+	int status;
+
+	sensor = fdt_path_offset(fdt, sensor_path);
+	if (sensor < 0)
+		return sensor;
+
+	status = fdt_setprop_string(fdt, sensor, "compatible", compatible) ?:
+		 fdt_setprop_u32(fdt, sensor, "reg", i2c_addr) ?:
+		 asius_fdt_setprop_u32_array(fdt, sensor, "clocks",
+					     clock_cells,
+					     use_camcc_mclk ? ARRAY_SIZE(clock_cells) : 1) ?:
+		 fdt_setprop_string(fdt, sensor, "clock-names", "xclk") ?:
+		 asius_fdt_setprop_u32_array(fdt, sensor, "reset-gpios",
+					     reset_cells, ARRAY_SIZE(reset_cells));
+	if (status)
+		return status;
+
+	if (use_camcc_mclk) {
+		status = asius_fdt_setprop_u32_array(fdt, sensor, "assigned-clocks",
+						     clock_cells,
+						     ARRAY_SIZE(clock_cells)) ?:
+			 fdt_setprop_u32(fdt, sensor, "assigned-clock-rates",
+					 24000000) ?:
+			 fdt_setprop(fdt, sensor, "pinctrl-names",
+				     pinctrl_names, sizeof(pinctrl_names)) ?:
+			 asius_fdt_setprop_u32_array(fdt, sensor, "pinctrl-0",
+						     pinctrl0_cells,
+						     ARRAY_SIZE(pinctrl0_cells)) ?:
+			 asius_fdt_setprop_u32_array(fdt, sensor, "pinctrl-1",
+						     pinctrl1_cells,
+						     ARRAY_SIZE(pinctrl1_cells));
+	} else {
+		status = asius_fdt_delprop_optional(fdt, sensor,
+						    "assigned-clocks") ?:
+			 asius_fdt_delprop_optional(fdt, sensor,
+						    "assigned-clock-rates") ?:
+			 asius_fdt_delprop_optional(fdt, sensor,
+						    "pinctrl-names") ?:
+			 asius_fdt_delprop_optional(fdt, sensor,
+						    "pinctrl-0") ?:
+			 asius_fdt_delprop_optional(fdt, sensor,
+						    "pinctrl-1");
+	}
+	if (status)
+		return status;
+
+	if (enable_gpio) {
+		status = asius_fdt_setprop_u32_array(fdt, sensor,
+						     "enable-gpios",
+						     enable_cells,
+						     ARRAY_SIZE(enable_cells));
+		if (status)
+			return status;
+	}
+
+	if (asius_fdt_ensure_child(fdt, sensor_path, "port",
+				   sensor_port_path) < 0)
+		return fdt_path_offset(fdt, sensor_port_path);
+
+	endpoint = asius_fdt_ensure_child(fdt, sensor_port_path, "endpoint",
+					  sensor_endpoint_path);
+	if (endpoint < 0)
+		return endpoint;
+
+	status = fdt_setprop_u64(fdt, endpoint, "link-frequencies",
+				 link_frequency) ?:
+		 asius_fdt_setprop_u32_array(fdt, endpoint, "data-lanes",
+					     data_lanes, ARRAY_SIZE(data_lanes)) ?:
+		 asius_fdt_assign_phandle(fdt, sensor_endpoint_path,
+					  endpoint_phandle);
+
+	return status;
+}
+
+static void asius_enable_dragon_cameras(void *fdt)
+{
+	u32 cam1_csi_phandle, cam1_sensor_phandle;
+	u32 cam2_csi_phandle, cam2_sensor_phandle;
+	u32 cam3_csi_phandle, cam3_sensor_phandle;
+	u32 cam1_mclk_default_phandle, cam1_mclk_suspend_phandle;
+	u32 cam2_ext_clk_phandle, cam3_ext_clk_phandle;
+	u32 camss_vdda_phy_phandle, camss_vdda_pll_phandle;
+	u32 camcc_phandle, tlmm_phandle;
+	int camss, cci0, cci1;
+	int status;
+
+	camss = fdt_path_offset(fdt, ASIUS_CAMSS_PATH);
+	cci0 = fdt_path_offset(fdt, ASIUS_CCI0_PATH);
+	cci1 = fdt_path_offset(fdt, ASIUS_CCI1_PATH);
+	if (camss < 0 || cci0 < 0 || cci1 < 0)
+		return;
+
+	status = asius_fdt_ensure_child(fdt, ASIUS_CAMSS_PATH, "ports",
+					ASIUS_CAMSS_PORTS_PATH);
+	if (status < 0) {
+		efi_warn("Failed to add Asius camera ports node: %d\n", status);
+		return;
+	}
+
+	status = asius_fdt_ensure_child(fdt, "/", "ext-cam-clk-os04-cam2",
+				       ASIUS_CAM2_EXT_CLK_PATH);
+	if (status < 0)
+		goto fail;
+
+	status = asius_fdt_ensure_child(fdt, "/", "ext-cam-clk-os04-cam3",
+				       ASIUS_CAM3_EXT_CLK_PATH);
+	if (status < 0)
+		goto fail;
+
+	status = asius_fdt_ensure_child(fdt, ASIUS_CAMSS_PORTS_PATH, "port@0",
+				       ASIUS_CAMSS_PORT0_PATH);
+	if (status < 0)
+		goto fail;
+
+	status = asius_fdt_ensure_child(fdt, ASIUS_CAMSS_PORTS_PATH, "port@2",
+				       ASIUS_CAMSS_PORT2_PATH);
+	if (status < 0)
+		goto fail;
+
+	status = asius_fdt_ensure_child(fdt, ASIUS_CAMSS_PORTS_PATH, "port@3",
+				       ASIUS_CAMSS_PORT3_PATH);
+	if (status < 0)
+		goto fail;
+
+	status = asius_fdt_ensure_child(fdt, ASIUS_CCI0_BUS0_PATH, "camera@36",
+				       ASIUS_CAM1_PATH);
+	if (status < 0)
+		goto fail;
+
+	status = asius_fdt_ensure_child(fdt, ASIUS_CCI1_BUS0_PATH, "camera@36",
+				       ASIUS_CAM2_PATH);
+	if (status < 0)
+		goto fail;
+
+	status = asius_fdt_ensure_child(fdt, ASIUS_CCI1_BUS1_PATH, "camera@36",
+				       ASIUS_CAM3_PATH);
+	if (status < 0)
+		goto fail;
+
+	status = asius_fdt_ensure_child(fdt, ASIUS_CCI0_BUS0_PATH,
+				       "led-controller@64",
+				       ASIUS_CAM1_LEDS_PATH);
+	if (status < 0)
+		goto fail;
+
+	status = asius_fdt_ensure_child(fdt, ASIUS_CCI1_BUS0_PATH,
+				       "led-controller@64",
+				       ASIUS_CAM2_LEDS_PATH);
+	if (status < 0)
+		goto fail;
+
+	status = asius_fdt_ensure_child(fdt, ASIUS_CCI1_BUS1_PATH,
+				       "led-controller@64",
+				       ASIUS_CAM3_LEDS_PATH);
+	if (status < 0)
+		goto fail;
+
+	status = asius_fdt_ensure_child(fdt, ASIUS_TLMM_PATH,
+				       "cam1-mclk-default-state",
+				       ASIUS_CAM1_MCLK_DEFAULT_PATH);
+	if (status < 0)
+		goto fail;
+
+	status = asius_fdt_ensure_child(fdt, ASIUS_TLMM_PATH,
+				       "cam1-mclk-suspend-state",
+				       ASIUS_CAM1_MCLK_SUSPEND_PATH);
+	if (status < 0)
+		goto fail;
+
+	status = asius_fdt_node_phandle(fdt, ASIUS_CAMCC_PATH,
+					&camcc_phandle) ?:
+		 asius_fdt_node_phandle(fdt, ASIUS_TLMM_PATH,
+					&tlmm_phandle) ?:
+		 asius_fdt_node_phandle(fdt, ASIUS_VREG_L10C_0P88_PATH,
+					&camss_vdda_phy_phandle) ?:
+		 asius_fdt_node_phandle(fdt, ASIUS_VREG_L6B_1P2_PATH,
+					&camss_vdda_pll_phandle) ?:
+		 asius_configure_cam_mclk_pinctrl(fdt,
+						  ASIUS_CAM1_MCLK_DEFAULT_PATH,
+						  "gpio64", "bias-disable") ?:
+		 asius_configure_cam_mclk_pinctrl(fdt,
+						  ASIUS_CAM1_MCLK_SUSPEND_PATH,
+						  "gpio64", "bias-pull-down") ?:
+		 asius_configure_fixed_clock(fdt, ASIUS_CAM2_EXT_CLK_PATH,
+					      "ext_cam_clk_os04_cam2",
+					      24000000,
+					      &cam2_ext_clk_phandle) ?:
+		 asius_configure_fixed_clock(fdt, ASIUS_CAM3_EXT_CLK_PATH,
+					      "ext_cam_clk_os04_cam3",
+					      24000000,
+					      &cam3_ext_clk_phandle) ?:
+		 asius_fdt_node_phandle(fdt, ASIUS_CAM1_MCLK_DEFAULT_PATH,
+					&cam1_mclk_default_phandle) ?:
+		 asius_fdt_node_phandle(fdt, ASIUS_CAM1_MCLK_SUSPEND_PATH,
+					&cam1_mclk_suspend_phandle) ?:
+		 asius_fdt_setprop_string_path(fdt, ASIUS_CAMSS_PATH,
+					       "status", "okay") ?:
+		 asius_fdt_setprop_u32_path(fdt, ASIUS_CAMSS_PATH,
+					    "vdda-phy-supply",
+					    camss_vdda_phy_phandle) ?:
+		 asius_fdt_setprop_u32_path(fdt, ASIUS_CAMSS_PATH,
+					    "vdda-pll-supply",
+					    camss_vdda_pll_phandle) ?:
+		 asius_fdt_setprop_string_path(fdt, ASIUS_CCI0_PATH,
+					       "status", "okay") ?:
+		 asius_fdt_setprop_string_path(fdt, ASIUS_CCI1_PATH,
+					       "status", "okay") ?:
+		 asius_fdt_setprop_u32_path(fdt, ASIUS_CAMSS_PORTS_PATH,
+					    "#address-cells", 1) ?:
+		 asius_fdt_setprop_u32_path(fdt, ASIUS_CAMSS_PORTS_PATH,
+					    "#size-cells", 0) ?:
+		 asius_configure_cci_bus(fdt, ASIUS_CCI0_BUS0_PATH) ?:
+		 asius_configure_cci_bus(fdt, ASIUS_CCI1_BUS0_PATH) ?:
+		 asius_configure_cci_bus(fdt, ASIUS_CCI1_BUS1_PATH) ?:
+		 asius_configure_camera_leds(fdt, ASIUS_CAM1_LEDS_PATH, 1) ?:
+		 asius_configure_camera_leds(fdt, ASIUS_CAM2_LEDS_PATH, 2) ?:
+		 asius_configure_camera_leds(fdt, ASIUS_CAM3_LEDS_PATH, 3) ?:
+		 asius_configure_camss_port(fdt, 0, ASIUS_CAMSS_PORT0_PATH,
+					    ASIUS_CAMSS_PORT0_EP_PATH,
+					    &cam1_csi_phandle) ?:
+		 asius_configure_camss_port(fdt, 2, ASIUS_CAMSS_PORT2_PATH,
+					    ASIUS_CAMSS_PORT2_EP_PATH,
+					    &cam2_csi_phandle) ?:
+		 asius_configure_camss_port(fdt, 3, ASIUS_CAMSS_PORT3_PATH,
+					    ASIUS_CAMSS_PORT3_EP_PATH,
+					    &cam3_csi_phandle) ?:
+		 asius_configure_camera_sensor(fdt, ASIUS_CAM1_PATH,
+					       ASIUS_CAM1_PORT_PATH,
+					       ASIUS_CAM1_EP_PATH,
+					       "ovti,os04c10", 0x36,
+					       camcc_phandle,
+					       ASIUS_CAM_CC_MCLK0_CLK,
+					       cam1_mclk_default_phandle,
+					       cam1_mclk_suspend_phandle,
+					       1,
+					       tlmm_phandle, 20, 36,
+					       456000000ULL,
+					       &cam1_sensor_phandle) ?:
+		 asius_configure_camera_sensor(fdt, ASIUS_CAM2_PATH,
+					       ASIUS_CAM2_PORT_PATH,
+					       ASIUS_CAM2_EP_PATH,
+					       "ovti,os04c10", 0x36,
+					       cam2_ext_clk_phandle,
+					       0, 0, 0, 0,
+					       tlmm_phandle, 77, 0,
+					       456000000ULL,
+					       &cam2_sensor_phandle) ?:
+		 asius_configure_camera_sensor(fdt, ASIUS_CAM3_PATH,
+					       ASIUS_CAM3_PORT_PATH,
+					       ASIUS_CAM3_EP_PATH,
+					       "ovti,os04c10", 0x36,
+					       cam3_ext_clk_phandle,
+					       0, 0, 0, 0,
+					       tlmm_phandle, 78, 0,
+					       456000000ULL,
+					       &cam3_sensor_phandle) ?:
+		 fdt_setprop_u32(fdt, fdt_path_offset(fdt,
+				 ASIUS_CAMSS_PORT0_EP_PATH), "remote-endpoint",
+				 cam1_sensor_phandle) ?:
+		 fdt_setprop_u32(fdt, fdt_path_offset(fdt,
+				 ASIUS_CAM1_EP_PATH), "remote-endpoint",
+				 cam1_csi_phandle) ?:
+		 fdt_setprop_u32(fdt, fdt_path_offset(fdt,
+				 ASIUS_CAMSS_PORT2_EP_PATH), "remote-endpoint",
+				 cam2_sensor_phandle) ?:
+		 fdt_setprop_u32(fdt, fdt_path_offset(fdt,
+				 ASIUS_CAM2_EP_PATH), "remote-endpoint",
+				 cam2_csi_phandle) ?:
+		 fdt_setprop_u32(fdt, fdt_path_offset(fdt,
+				 ASIUS_CAMSS_PORT3_EP_PATH), "remote-endpoint",
+				 cam3_sensor_phandle) ?:
+		 fdt_setprop_u32(fdt, fdt_path_offset(fdt,
+				 ASIUS_CAM3_EP_PATH), "remote-endpoint",
+				 cam3_csi_phandle);
+	if (status)
+		goto fail;
+
+	return;
+
+fail:
+	efi_warn("Failed to configure Asius Dragon cameras: %d\n", status);
+}
