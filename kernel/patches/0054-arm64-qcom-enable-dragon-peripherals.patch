+static int asius_fdt_setprop_u32_array(void *fdt, int node,
+				       const char *name, const u32 *values,
+				       int count)
+{
+	fdt32_t cells[ASIUS_MAX_FDT_CELLS];
+	int i;
+
+	if (count > ASIUS_MAX_FDT_CELLS)
+		return -FDT_ERR_BADVALUE;
+
+	for (i = 0; i < count; i++)
+		cells[i] = cpu_to_fdt32(values[i]);
+
+	return fdt_setprop(fdt, node, name, cells, sizeof(cells[0]) * count);
+}
