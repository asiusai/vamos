+static int asius_fdt_subnode(void *fdt, int parent, const char *name)
+{
+	int node;
+
+	node = fdt_subnode_offset(fdt, parent, name);
+	if (node == -FDT_ERR_NOTFOUND)
+		node = fdt_add_subnode(fdt, parent, name);
+
+	return node;
+}
+
+static int asius_fdt_ensure_child(void *fdt, const char *parent_path,
+				  const char *child_name, const char *path)
+{
+	int parent;
+	int child;
+
+	child = fdt_path_offset(fdt, path);
+	if (child >= 0)
+		return child;
+
+	parent = fdt_path_offset(fdt, parent_path);
+	if (parent < 0)
+		return parent;
+
+	child = asius_fdt_subnode(fdt, parent, child_name);
+	if (child < 0)
+		return child;
+
+	return fdt_path_offset(fdt, path);
+}
+
+static int asius_fdt_node_phandle(void *fdt, const char *path, u32 *phandle)
+{
+	int node;
+	int status;
+
+	node = fdt_path_offset(fdt, path);
+	if (node < 0)
+		return node;
+
+	*phandle = fdt_get_phandle(fdt, node);
+	if (*phandle)
+		return 0;
+
+	status = fdt_generate_phandle(fdt, phandle);
+	if (status)
+		return status;
+
+	node = fdt_path_offset(fdt, path);
+	if (node < 0)
+		return node;
+
+	return fdt_setprop_u32(fdt, node, "phandle", *phandle);
+}
+
