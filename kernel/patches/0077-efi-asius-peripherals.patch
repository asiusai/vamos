+#define ASIUS_CAMSS_PORT2_EP_PATH	ASIUS_CAMSS_PORT2_PATH "/endpoint"
+#define ASIUS_CAMSS_PORT3_EP_PATH	ASIUS_CAMSS_PORT3_PATH "/endpoint"
