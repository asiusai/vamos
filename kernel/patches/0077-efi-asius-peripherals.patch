+#define ASIUS_CAM1_MCLK_DEFAULT_PATH	ASIUS_TLMM_PATH "/cam1-mclk-default-state"
+#define ASIUS_CAM1_MCLK_SUSPEND_PATH	ASIUS_TLMM_PATH "/cam1-mclk-suspend-state"
+#define ASIUS_VREG_L6B_1P2_PATH		"/soc@0/rsc@18200000/regulators-0/ldo6"
+#define ASIUS_VREG_L10C_0P88_PATH	"/soc@0/rsc@18200000/regulators-1/ldo10"
