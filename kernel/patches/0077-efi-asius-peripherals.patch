From: Asius <dev@asius.ai>
Subject: [PATCH] efi: preserve Asius peripherals when using the stock firmware DT

Rebased for Linux 7.2.7 from the existing VamOS patch series.
See kernel/README.md for provenance, scope and removed patches.

---
diff --git a/drivers/firmware/efi/libstub/fdt.c b/drivers/firmware/efi/libstub/fdt.c
index 23b3543d3041b07a35e658378d3e2d650f3c3bb1..fd0ba3c325b7cfa39873b05ddd3d44ee1c17854a 100644
--- a/drivers/firmware/efi/libstub/fdt.c
+++ b/drivers/firmware/efi/libstub/fdt.c
@@ -27,6 +27,944 @@ static void fdt_update_cell_size(void *fdt)
 	fdt_setprop_u32(fdt, offset, "#size-cells",    EFI_DT_SIZE_CELLS_DEFAULT);
 }
 
+static void asius_enable_panda_spi(void *fdt)
+{
+	static const char spi12_path[] = "/soc@0/geniqup@ac0000/spi@a90000";
+	fdt32_t max_frequency = cpu_to_fdt32(50000000);
+	fdt32_t reg = cpu_to_fdt32(0);
+	int aliases, panda, spi, status;
+
+	spi = fdt_path_offset(fdt, spi12_path);
+	if (spi < 0)
+		return;
+
+	/*
+	 * panda's Python SPI backend opens /dev/spidev0.0. The firmware DTB
+	 * aliases this controller as spi12, so replace spi0 before aliases are
+	 * scanned by the kernel.
+	 */
+	aliases = fdt_path_offset(fdt, "/aliases");
+	if (aliases >= 0) {
+		status = fdt_setprop_string(fdt, aliases, "spi0", spi12_path);
+		if (status)
+			efi_warn("Failed to alias Asius panda SPI controller: %d\n",
+				 status);
+	}
+
+	status = fdt_setprop_string(fdt, spi, "status", "okay");
+	if (status)
+		efi_warn("Failed to enable Asius panda SPI controller: %d\n",
+			 status);
+
+	status = fdt_setprop_u32(fdt, spi, "#address-cells", 1);
+	if (status)
+		efi_warn("Failed to set Asius panda SPI address cells: %d\n",
+			 status);
+
+	status = fdt_setprop_u32(fdt, spi, "#size-cells", 0);
+	if (status)
+		efi_warn("Failed to set Asius panda SPI size cells: %d\n",
+			 status);
+
+	panda = fdt_subnode_offset(fdt, spi, "panda@0");
+	if (panda == -FDT_ERR_NOTFOUND)
+		panda = fdt_add_subnode(fdt, spi, "panda@0");
+	if (panda < 0) {
+		efi_warn("Failed to add Asius panda SPI node: %d\n", panda);
+		return;
+	}
+
+	status = fdt_setprop_string(fdt, panda, "compatible", "rohm,dh2228fv") ?:
+		 fdt_setprop(fdt, panda, "reg", &reg, sizeof(reg)) ?:
+		 fdt_setprop(fdt, panda, "spi-max-frequency", &max_frequency,
+			     sizeof(max_frequency));
+	if (status)
+		efi_warn("Failed to configure Asius panda SPI node: %d\n",
+			 status);
+}
+
+static void asius_keep_panda_som_alive(void *fdt)
+{
+	static const char tlmm_path[] = "/soc@0/pinctrl@f100000";
+	fdt32_t gpios[] = {
+		cpu_to_fdt32(27),
+		cpu_to_fdt32(0),
+	};
+	int node;
+	int status;
+	int tlmm;
+
+	tlmm = fdt_path_offset(fdt, tlmm_path);
+	if (tlmm < 0) {
+		efi_warn("Failed to find TLMM for Asius panda SOM GPIO: %d\n",
+			 tlmm);
+		return;
+	}
+
+	node = fdt_subnode_offset(fdt, tlmm, "panda-som-alive-hog");
+	if (node == -FDT_ERR_NOTFOUND)
+		node = fdt_add_subnode(fdt, tlmm, "panda-som-alive-hog");
+	if (node < 0) {
+		efi_warn("Failed to add Asius panda SOM GPIO: %d\n", node);
+		return;
+	}
+
+	status = fdt_setprop(fdt, node, "gpio-hog", NULL, 0) ?:
+		 fdt_setprop(fdt, node, "gpios", gpios, sizeof(gpios)) ?:
+		 fdt_setprop(fdt, node, "output-high", NULL, 0) ?:
+		 fdt_setprop_string(fdt, node, "line-name", "PANDA_SOM_GPIO");
+	if (status)
+		efi_warn("Failed to configure Asius panda SOM GPIO: %d\n",
+			 status);
+}
+
+static void asius_enable_panda_imu_i2c(void *fdt)
+{
+	static const char i2c6_path[] =
+		"/soc@0/geniqup@9c0000/i2c@998000";
+	int i2c;
+	int status;
+
+	i2c = fdt_path_offset(fdt, i2c6_path);
+	if (i2c < 0) {
+		efi_warn("Failed to find Asius panda IMU I2C controller: %d\n",
+			 i2c);
+		return;
+	}
+
+	status = fdt_setprop_string(fdt, i2c, "status", "okay") ?:
+		 fdt_setprop(fdt, i2c, "qcom,enable-gsi-dma", NULL, 0);
+	if (status)
+		efi_warn("Failed to enable Asius panda IMU I2C controller: %d\n",
+			 status);
+}
+
+static int asius_fdt_get_or_add_subnode(void *fdt, int parent,
+					const char *name)
+{
+	int node;
+
+	node = fdt_subnode_offset(fdt, parent, name);
+	if (node == -FDT_ERR_NOTFOUND)
+		node = fdt_add_subnode(fdt, parent, name);
+
+	return node;
+}
+
+static int asius_fdt_configure_audio_codec(void *fdt, const char *name,
+					   const char *compatible,
+					   u32 channels, u32 *phandle)
+{
+	int node;
+	int status;
+
+	node = asius_fdt_get_or_add_subnode(fdt, 0, name);
+	if (node < 0)
+		return node;
+
+	status = fdt_setprop_string(fdt, node, "compatible", compatible) ?:
+		 fdt_setprop_u32(fdt, node, "#sound-dai-cells", 0);
+	if (status)
+		return status;
+
+	if (channels) {
+		status = fdt_setprop_u32(fdt, node, "num-channels", channels);
+		if (status)
+			return status;
+	}
+
+	*phandle = fdt_get_phandle(fdt, node);
+	if (!*phandle) {
+		status = fdt_generate_phandle(fdt, phandle);
+		if (status)
+			return status;
+		status = fdt_setprop_u32(fdt, node, "phandle", *phandle);
+	}
+
+	return status;
+}
+
+static int asius_fdt_configure_audio_link(void *fdt, int sound,
+					  const char *node_name,
+					  const char *link_name,
+					  u32 cpu_phandle, u32 dai_id,
+					  u32 codec_phandle,
+					  u32 platform_phandle)
+{
+	fdt32_t cpu_dai[] = {
+		cpu_to_fdt32(cpu_phandle),
+		cpu_to_fdt32(dai_id),
+	};
+	fdt32_t codec_dai = cpu_to_fdt32(codec_phandle);
+	fdt32_t platform_dai = cpu_to_fdt32(platform_phandle);
+	int codec;
+	int cpu;
+	int link;
+	int platform;
+	int status;
+
+	link = asius_fdt_get_or_add_subnode(fdt, sound, node_name);
+	if (link < 0)
+		return link;
+	status = fdt_setprop_string(fdt, link, "link-name", link_name);
+	if (status)
+		return status;
+
+	cpu = asius_fdt_get_or_add_subnode(fdt, link, "cpu");
+	if (cpu < 0)
+		return cpu;
+	status = fdt_setprop(fdt, cpu, "sound-dai", cpu_dai,
+			     sizeof(cpu_dai));
+	if (status)
+		return status;
+
+	codec = asius_fdt_get_or_add_subnode(fdt, link, "codec");
+	if (codec < 0)
+		return codec;
+	status = fdt_setprop(fdt, codec, "sound-dai", &codec_dai,
+			     sizeof(codec_dai));
+	if (status)
+		return status;
+
+	platform = asius_fdt_get_or_add_subnode(fdt, link, "platform");
+	if (platform < 0)
+		return platform;
+
+	return fdt_setprop(fdt, platform, "sound-dai", &platform_dai,
+			   sizeof(platform_dai));
+}
+
+static void asius_configure_panda_audio(void *fdt)
+{
+	static const char old_links[][24] = {
+		"wcd-capture-dai-link",
+		"panda-playback-dai-link",
+		"dp0-dai-link",
+	};
+	static const char pin_paths[][64] = {
+		"/soc@0/pinctrl@f100000/mi2s0-mclk-state",
+		"/soc@0/pinctrl@f100000/mi2s0-sclk-state",
+		"/soc@0/pinctrl@f100000/mi2s0-ws-state",
+		"/soc@0/pinctrl@f100000/mi2s0-data0-state",
+		"/soc@0/pinctrl@f100000/mi2s0-data1-state",
+	};
+	fdt32_t pinctrl[ARRAY_SIZE(pin_paths)];
+	u32 capture_codec;
+	u32 playback_codec;
+	u32 q6apm_phandle;
+	u32 q6bedai_phandle;
+	int node;
+	int q6apm;
+	int q6bedai;
+	int sound;
+	int status;
+	int i;
+
+	sound = fdt_path_offset(fdt, "/sound");
+	q6apm = fdt_node_offset_by_compatible(fdt, -1, "qcom,q6apm");
+	q6bedai = fdt_node_offset_by_compatible(fdt, -1,
+						"qcom,q6apm-lpass-dais");
+	if (sound < 0 || q6apm < 0 || q6bedai < 0) {
+		efi_warn("Failed to find Asius panda audio nodes: %d %d %d\n",
+			 sound, q6apm, q6bedai);
+		return;
+	}
+
+	q6apm_phandle = fdt_get_phandle(fdt, q6apm);
+	q6bedai_phandle = fdt_get_phandle(fdt, q6bedai);
+	if (!q6apm_phandle || !q6bedai_phandle) {
+		efi_warn("Asius panda audio Q6 nodes have no phandles\n");
+		return;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(pin_paths); i++) {
+		node = fdt_path_offset(fdt, pin_paths[i]);
+		if (node < 0 || !fdt_get_phandle(fdt, node)) {
+			efi_warn("Failed to find Asius panda audio pin %d: %d\n",
+				 i, node);
+			return;
+		}
+		pinctrl[i] = cpu_to_fdt32(fdt_get_phandle(fdt, node));
+	}
+
+	status = asius_fdt_configure_audio_codec(fdt, "panda-audio-input",
+						 "dmic-codec", 2, &capture_codec) ?:
+		 asius_fdt_configure_audio_codec(fdt, "panda-audio-output",
+						  "maxim,max98357a", 0,
+						  &playback_codec);
+	if (status)
+		goto fail;
+
+	sound = fdt_path_offset(fdt, "/sound");
+	for (i = 0; i < ARRAY_SIZE(old_links); i++) {
+		node = fdt_subnode_offset(fdt, sound, old_links[i]);
+		if (node >= 0) {
+			status = fdt_del_node(fdt, node);
+			if (status)
+				goto fail;
+			sound = fdt_path_offset(fdt, "/sound");
+		}
+	}
+
+	status = fdt_setprop(fdt, sound, "pinctrl-0", pinctrl, sizeof(pinctrl)) ?:
+		 fdt_setprop_string(fdt, sound, "pinctrl-names", "default") ?:
+		 asius_fdt_configure_audio_link(fdt, sound,
+						 "panda-playback-dai-link",
+						 "Panda Playback", q6bedai_phandle,
+						 16, playback_codec, q6apm_phandle) ?:
+		 asius_fdt_configure_audio_link(fdt, sound,
+						 "panda-capture-dai-link",
+						 "Panda Capture", q6bedai_phandle,
+						 17, capture_codec, q6apm_phandle);
+fail:
+	if (status)
+		efi_warn("Failed to configure Asius audio: %d\n", status);
+}
+
+#define ASIUS_PWRKEY_PATH \
+	"/soc@0/spmi@c440000/pmic@0/pon@1300/pwrkey"
+#define ASIUS_PAIR_KEY_CODE		148
+
+static void asius_repurpose_power_key(void *fdt)
+{
+	int node;
+	int status;
+
+	node = fdt_path_offset(fdt, ASIUS_PWRKEY_PATH);
+	if (node < 0) {
+		efi_warn("Failed to find Asius pairing key: %d\n", node);
+		return;
+	}
+
+	status = fdt_setprop_u32(fdt, node, "linux,code",
+				 ASIUS_PAIR_KEY_CODE);
+	if (status)
+		efi_warn("Failed to configure Asius pairing key: %d\n",
+			 status);
+}
