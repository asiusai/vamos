+#define ASIUS_CAM2_PATH			ASIUS_CCI1_BUS0_PATH "/camera@36"
+#define ASIUS_CAM3_PATH			ASIUS_CCI1_BUS1_PATH "/camera@36"
+#define ASIUS_CAM1_LEDS_PATH		ASIUS_CCI0_BUS0_PATH "/led-controller@64"
+#define ASIUS_CAM2_LEDS_PATH		ASIUS_CCI1_BUS0_PATH "/led-controller@64"
+#define ASIUS_CAM3_LEDS_PATH		ASIUS_CCI1_BUS1_PATH "/led-controller@64"
