+#define ASIUS_CAMSS_PATH		"/soc@0/isp@acb3000"
+#define ASIUS_CAMSS_PORTS_PATH		ASIUS_CAMSS_PATH "/ports"
+#define ASIUS_CAMSS_PORT0_PATH		ASIUS_CAMSS_PORTS_PATH "/port@0"
+#define ASIUS_CAMSS_PORT2_PATH		ASIUS_CAMSS_PORTS_PATH "/port@2"
+#define ASIUS_CAMSS_PORT3_PATH		ASIUS_CAMSS_PORTS_PATH "/port@3"
