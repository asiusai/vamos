+#define ASIUS_CAM2_PORT_PATH		ASIUS_CAM2_PATH "/port"
+#define ASIUS_CAM3_PORT_PATH		ASIUS_CAM3_PATH "/port"
+#define ASIUS_CAM1_EP_PATH		ASIUS_CAM1_PORT_PATH "/endpoint"
+#define ASIUS_CAM2_EP_PATH		ASIUS_CAM2_PORT_PATH "/endpoint"
+#define ASIUS_CAM3_EP_PATH		ASIUS_CAM3_PORT_PATH "/endpoint"
+#define ASIUS_CAM2_EXT_CLK_PATH		"/ext-cam-clk-os04-cam2"
+#define ASIUS_CAM3_EXT_CLK_PATH		"/ext-cam-clk-os04-cam3"
