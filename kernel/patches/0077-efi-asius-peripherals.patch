+#define ASIUS_CCI1_PATH			"/soc@0/cci@ac4b000"
+#define ASIUS_CCI1_BUS0_PATH		ASIUS_CCI1_PATH "/i2c-bus@0"
+#define ASIUS_CCI1_BUS1_PATH		ASIUS_CCI1_PATH "/i2c-bus@1"
