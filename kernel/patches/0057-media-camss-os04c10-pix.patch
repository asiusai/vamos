+		readl_relaxed(vfe->base + VFE_BUS_WM_IMAGE_ADDR(3)),
+		readl_relaxed(vfe->base + VFE_BUS_WM_FRAME_INC(3)),
+		readl_relaxed(vfe->base + VFE_BUS_WM_CFG(3)),
+		readl_relaxed(vfe->base + VFE_BUS_WM_STATUS0(3)),
