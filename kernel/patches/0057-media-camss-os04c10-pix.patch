+config VIDEO_OS04C10
+	tristate "OmniVision OS04C10 sensor support"
+	select V4L2_CCI_I2C
+	select V4L2_FWNODE
+	help
+	  This is a Video4Linux2 sensor driver for the OmniVision
+	  OS04C10 camera sensor.
+
+	  The driver exposes the sensor as a RAW10/RAW12 V4L2 sub-device and
+	  accepts register writes from userspace through SENSOR_WRITE_REGS.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called os04c10.
+
 config VIDEO_IMX258
 	tristate "Sony IMX258 sensor support"
