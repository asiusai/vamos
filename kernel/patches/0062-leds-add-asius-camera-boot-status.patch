diff --git a/drivers/leds/trigger/ledtrig-asius-boot.c b/drivers/leds/trigger/ledtrig-asius-boot.c
new file mode 100644
index 0000000..9ab70c7
--- /dev/null
+++ b/drivers/leds/trigger/ledtrig-asius-boot.c
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Synchronized boot-status trigger for Asius camera-board LEDs.
+ */
+
+#include <linux/init.h>
+#include <linux/jiffies.h>
+#include <linux/leds.h>
+#include <linux/timer.h>
+
+#define ASIUS_BOOT_BLINK_MS	500
+#define ASIUS_BOOT_BRIGHTNESS	204
+
+static struct led_trigger *asius_boot_trigger;
+static struct timer_list asius_boot_timer;
+static enum led_brightness asius_boot_brightness = ASIUS_BOOT_BRIGHTNESS;
+
+static void asius_boot_blink(struct timer_list *timer)
+{
+	asius_boot_brightness = asius_boot_brightness == LED_OFF ?
+				ASIUS_BOOT_BRIGHTNESS : LED_OFF;
+	led_trigger_event(asius_boot_trigger, asius_boot_brightness);
+	mod_timer(timer, jiffies + msecs_to_jiffies(ASIUS_BOOT_BLINK_MS));
+}
+
+static int __init asius_boot_init(void)
+{
+	led_trigger_register_simple("asius-boot", &asius_boot_trigger);
+	if (!asius_boot_trigger)
+		return -ENOMEM;
+
+	led_trigger_event(asius_boot_trigger, asius_boot_brightness);
+	timer_setup(&asius_boot_timer, asius_boot_blink, 0);
+	mod_timer(&asius_boot_timer,
+		  jiffies + msecs_to_jiffies(ASIUS_BOOT_BLINK_MS));
+
+	return 0;
+}
+subsys_initcall(asius_boot_init);
