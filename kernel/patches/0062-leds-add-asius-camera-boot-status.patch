+static int asius_configure_camera_leds(void *fdt, const char *path,
+				       int camera_number)
+{
+	char child_name[] = "led@1";
+	char label[sizeof("asius:cam1:green:0")];
+	int controller;
+	int child;
+	int status;
+	int i;
+
+	controller = fdt_path_offset(fdt, path);
+	if (controller < 0)
+		return controller;
+
+	status = fdt_setprop_string(fdt, controller, "compatible",
+				    "issi,is31fl3199") ?:
+		 fdt_setprop_u32(fdt, controller, "reg", 0x64) ?:
+		 fdt_setprop_u32(fdt, controller, "#address-cells", 1) ?:
+		 fdt_setprop_u32(fdt, controller, "#size-cells", 0);
+	if (status)
+		return status;
+
+	for (i = 0; i < 9; i++) {
+		child_name[4] = '1' + i;
+		child = asius_fdt_subnode(fdt, controller, child_name);
+		if (child < 0)
+			return child;
+
+		switch (i % 3) {
+		case 0:
+			snprintf(label, sizeof(label), "asius:cam%d:red:%d",
+				 camera_number, i / 3);
+			break;
+		case 1:
+			snprintf(label, sizeof(label), "asius:cam%d:green:%d",
+				 camera_number, i / 3);
+			break;
+		default:
+			snprintf(label, sizeof(label), "asius:cam%d:blue:%d",
+				 camera_number, i / 3);
+			break;
+		}
+
+		status = fdt_setprop_u32(fdt, child, "reg", i + 1) ?:
+			 fdt_setprop_string(fdt, child, "label", label) ?:
+			 fdt_setprop_u32(fdt, child, "led-max-microamp",
+					 40000);
+		if (status)
+			return status;
+
+		if ((i % 3) == 2 && camera_number != 1) {
+			status = fdt_setprop_string(fdt, child,
+						   "linux,default-trigger",
+						   "asius-boot") ?:
+				 asius_fdt_delprop_optional(fdt, child,
+							    "led-pattern");
+		} else {
+			status = asius_fdt_delprop_optional(fdt, child,
+							    "linux,default-trigger") ?:
+				 asius_fdt_delprop_optional(fdt, child,
+							    "led-pattern");
+		}
+		if (status)
+			return status;
+	}
+
+	return 0;
+}
