 #define ASIUS_CAMSS_PORTS_PATH		ASIUS_CAMSS_PATH "/ports"
@@ -774,6 +796,7 @@ static efi_status_t update_fdt(void *orig_fdt, unsigned long orig_fdt_size,
 	}
 
 	asius_enable_panda_spi(fdt);
