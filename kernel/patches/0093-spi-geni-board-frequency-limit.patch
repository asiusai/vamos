From: Asius <hello@asius.ai>
Subject: [PATCH] spi: geni: honor the board bus frequency limit

The Dragon Panda bus is unreliable at the next GENI clock step above
33.33 MHz through its level translator. A 37 MHz ceiling selects that
safe step. Enforce the ceiling on the controller so both spidev defaults
and per-transfer speed requests are clamped by the SPI core. Other
controllers retain their 50 MHz maximum.

--- a/drivers/spi/spi-geni-qcom.c
+++ b/drivers/spi/spi-geni-qcom.c
@@ -1099,6 +1099,15 @@
 	spi->bits_per_word_mask = SPI_BPW_RANGE_MASK(4, 32);
 	spi->num_chipselect = 4;
 	spi->max_speed_hz = 50000000;
+	/* Board wiring can impose a lower limit than the controller itself. */
+	if (device_property_present(dev, "spi-max-frequency")) {
+		u32 max_speed_hz;
+
+		ret = device_property_read_u32(dev, "spi-max-frequency", &max_speed_hz);
+		if (ret || !max_speed_hz || max_speed_hz > spi->max_speed_hz)
+			return dev_err_probe(dev, -EINVAL, "invalid SPI bus frequency limit\n");
+		spi->max_speed_hz = max_speed_hz;
+	}
 	spi->max_dma_len = 0xffff0; /* 24 bits for tx/rx dma length */
 	spi->prepare_message = spi_geni_prepare_message;
 	spi->transfer_one = spi_geni_transfer_one;
--- a/Documentation/devicetree/bindings/spi/qcom,spi-geni-qcom.yaml
+++ b/Documentation/devicetree/bindings/spi/qcom,spi-geni-qcom.yaml
@@ -59,6 +59,11 @@
   interrupts:
     maxItems: 1
 
+  spi-max-frequency:
+    description: Maximum bus frequency allowed by the board wiring, in Hz.
+    minimum: 1
+    maximum: 50000000
+
   operating-points-v2: true
 
   power-domains:
--- a/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
+++ b/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
@@ -970,3 +970,5 @@
 &spi12 {
 	qcom,enable-gsi-dma;
+	/* 37 MHz selects the reliable 33.33 MHz GENI clock step. */
+	spi-max-frequency = <37000000>;
 	status = "okay";
