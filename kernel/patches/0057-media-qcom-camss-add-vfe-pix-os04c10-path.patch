+
+	if (copy_from_user(data, u64_to_user_ptr(cmd->data),
+			   cmd->count * sizeof(*data))) {
+		ret = -EFAULT;
+		goto out;
+	}
+
+	/* DMI_CFG: auto-increment enable | ram_select */
+	writel_relaxed(BIT(8) | cmd->ram_select,
+		       vfe->base + cmd->dmi_cfg_offset);
+	writel_relaxed(0, vfe->base + cmd->dmi_cfg_offset + 0x4); /* DMI_ADDR = 0 */
+
+	for (i = 0; i < cmd->count; i++)
+		writel_relaxed(data[i],
+			       vfe->base + cmd->dmi_cfg_offset + 0xc); /* DMI_DATA_LO */
+
+	/* Disable DMI */
+	writel_relaxed(0, vfe->base + cmd->dmi_cfg_offset);
+	wmb();
+
+out:
+	kvfree(data);
+	return ret;
+}
+
+static long vfe_17x_map_buf(struct vfe_device *vfe, void __user *arg)
+{
+	struct vfe_map_buf_cmd *cmd = arg;
+	struct vfe_mapped_buf *mb;
+	struct dma_buf *dmabuf;
+	int ret;
+
+	dev_dbg(vfe->camss->dev, "vfe_map_buf: fd=%d\n", cmd->fd);
+	dmabuf = dma_buf_get(cmd->fd);
+	if (IS_ERR(dmabuf)) {
+		dev_dbg(vfe->camss->dev, "vfe_map_buf: dma_buf_get failed: %ld\n",
+			PTR_ERR(dmabuf));
+		return PTR_ERR(dmabuf);
+	}
+
+	mb = kzalloc(sizeof(*mb), GFP_KERNEL);
+	if (!mb) {
+		dma_buf_put(dmabuf);
+		return -ENOMEM;
+	}
+
+	mb->dmabuf = dmabuf;
+	mb->attach = dma_buf_attach(dmabuf, vfe->camss->dev);
+	if (IS_ERR(mb->attach)) {
+		dev_dbg(vfe->camss->dev, "vfe_map_buf: dma_buf_attach failed: %ld\n",
+			PTR_ERR(mb->attach));
+		ret = PTR_ERR(mb->attach);
+		goto err_free;
+	}
+
+	mb->sgt = dma_buf_map_attachment(mb->attach, DMA_FROM_DEVICE);
+	if (IS_ERR(mb->sgt)) {
+		dev_dbg(vfe->camss->dev, "vfe_map_buf: dma_buf_map_attachment failed: %ld\n",
+			PTR_ERR(mb->sgt));
+		ret = PTR_ERR(mb->sgt);
+		goto err_detach;
+	}
+
+	mb->iova = sg_dma_address(mb->sgt->sgl);
+	mb->size = dmabuf->size;
+	dev_dbg(vfe->camss->dev, "vfe_map_buf: success fd=%d iova=0x%llx size=%zu\n",
+		cmd->fd, (unsigned long long)mb->iova, mb->size);
+
+	ret = xa_insert(&vfe->mapped_bufs, (unsigned long)(mb->iova >> PAGE_SHIFT),
+			mb, GFP_KERNEL);
+	if (ret)
+		goto err_unmap;
+
+	/* V4L2 framework handles copy_to_user for _IOWR ioctls */
+	cmd->iova = mb->iova;
+	cmd->size = mb->size;
+
+	return 0;
+
+err_unmap:
+	dma_buf_unmap_attachment(mb->attach, mb->sgt, DMA_FROM_DEVICE);
+err_detach:
+	dma_buf_detach(dmabuf, mb->attach);
+err_free:
+	kfree(mb);
+	dma_buf_put(dmabuf);
+	return ret;
+}
+
+static long vfe_17x_unmap_buf(struct vfe_device *vfe, void __user *arg)
+{
+	struct vfe_unmap_buf_cmd *cmd = arg;
+	struct vfe_mapped_buf *mb;
+
+	mb = xa_erase(&vfe->mapped_bufs, (unsigned long)(cmd->iova >> PAGE_SHIFT));
+	if (!mb)
+		return -ENOENT;
+
+	dma_buf_unmap_attachment(mb->attach, mb->sgt, DMA_FROM_DEVICE);
+	dma_buf_detach(mb->dmabuf, mb->attach);
+	dma_buf_put(mb->dmabuf);
+	kfree(mb);
+
+	return 0;
+}
+
+static long vfe_17x_set_buf(struct vfe_device *vfe, struct vfe_line *line,
+			    void __user *arg)
+{
+	struct vfe_set_buf_cmd *cmd = arg;
+
+	if (cmd->wm_index >= MSM_VFE_IMAGE_MASTERS_NUM)
+		return -EINVAL;
+
+	writel_relaxed((u32)cmd->iova,
+		       vfe->base + VFE_BUS_WM_IMAGE_ADDR(cmd->wm_index));
+	writel_relaxed(cmd->stride,
+		       vfe->base + VFE_BUS_WM_STRIDE(cmd->wm_index));
+	writel_relaxed(cmd->frame_inc,
+		       vfe->base + VFE_BUS_WM_FRAME_INC(cmd->wm_index));
+	wmb();
+
+	return 0;
+}
+
+static long vfe_17x_reg_update_ioctl(struct vfe_device *vfe,
+				     struct vfe_line *line)
+{
+	vfe_reg_update(vfe, line->id);
+	return 0;
+}
+
+static long vfe_17x_start(struct vfe_device *vfe, struct vfe_line *line)
+{
+	struct media_entity *entity;
+	struct media_pad *pad;
+	struct v4l2_subdev *subdev;
+	int ret;
+
+	/* Power on VFE (PM domain, clocks, reset) */
+	ret = vfe_get(vfe);
+	if (ret)
+		return ret;
+
+	/* Enable IRQs */
+	mutex_lock(&vfe->stream_lock);
+	if (!vfe->stream_count)
+		vfe_enable_irq_common(vfe);
+	vfe->stream_count++;
+	mutex_unlock(&vfe->stream_lock);
+
+	/* Reserve write masters for PIX line */
+	ret = vfe_get_output_v2(line);
+	if (ret < 0)
+		goto error_stream;
+
+	/* Configure PIX write masters */
+	{
+		struct vfe_output *output = &line->output;
+		int i;
+
+		if (vfe->id < ARRAY_SIZE(vfe_pix_wm_done_mask))
+			vfe_pix_wm_done_mask[vfe->id] = 0;
+
+		for (i = 0; i < output->wm_num; i++)
+			vfe->res->hw_ops->vfe_wm_start(vfe, output->wm_idx[i], line);
+	}
+
+	/* Start media pipeline (validates format matching across links) */
+	ret = video_device_pipeline_alloc_start(&line->video_out.vdev);
+	if (ret < 0)
+		pr_warn("vfe_17x_start: pipeline_start returned %d, continuing anyway\n", ret);
+
+	/* Walk upstream from VFE subdev and call s_stream(1) on each entity */
+	entity = &line->subdev.entity;
+	while (1) {
+		pad = &entity->pads[0];
+		if (!(pad->flags & MEDIA_PAD_FL_SINK))
+			break;
+
+		pad = media_pad_remote_pad_first(pad);
+		if (!pad || !is_media_entity_v4l2_subdev(pad->entity))
+			break;
+
+		entity = pad->entity;
+		subdev = media_entity_to_v4l2_subdev(entity);
+
+			dev_dbg(vfe->camss->dev, "vfe_17x_start: calling s_stream(1) on %s\n",
+				subdev->name);
+			ret = v4l2_subdev_call(subdev, video, s_stream, 1);
+			dev_dbg(vfe->camss->dev, "vfe_17x_start: s_stream on %s returned %d\n",
+				subdev->name, ret);
+			if (ret < 0 && ret != -ENOIOCTLCMD) {
+				pr_err("vfe_17x_start: s_stream failed on %s: %d\n",
+				       subdev->name, ret);
+			goto error_pipeline;
+		}
+	}
+
+	vfe->was_streaming = 1;
+	dev_dbg(vfe->camss->dev, "vfe_17x_start: VFE%d PIX started, wm=[%d,%d]\n",
+		vfe->id, line->output.wm_idx[0], line->output.wm_idx[1]);
+
+	return 0;
+
+error_pipeline:
+error_output:
+	vfe_put_output(line);
+error_stream:
+	mutex_lock(&vfe->stream_lock);
+	vfe->stream_count--;
+	mutex_unlock(&vfe->stream_lock);
+	vfe_put(vfe);
+	return ret;
+}
+
+static long vfe_17x_stop(struct vfe_device *vfe, struct vfe_line *line)
+{
+	struct vfe_output *output = &line->output;
+	int i;
+
+	for (i = 0; i < output->wm_num; i++)
+		vfe->res->hw_ops->vfe_wm_stop(vfe, output->wm_idx[i]);
+
+	mutex_lock(&vfe->stream_lock);
+	vfe->stream_count--;
+	mutex_unlock(&vfe->stream_lock);
+
+	vfe_put(vfe);
+	return 0;
+}
+
+static long vfe_17x_wait_sof(struct vfe_device *vfe, struct vfe_line *line)
+{
+	unsigned long ret;
+
+	reinit_completion(&line->output.sof);
+	ret = wait_for_completion_timeout(&line->output.sof, msecs_to_jiffies(200));
+	return ret ? 0 : -ETIMEDOUT;
+}
+
