 static void csid_configure_stream(struct csid_device *csid, u8 enable)
 {
 	struct csid_testgen_config *tg = &csid->testgen;
 	u8 i;
+
 	/* Loop through all enabled VCs and configure stream for each */
 	for (i = 0; i < MSM_CSID_MAX_SRC_STREAMS; i++)
 		if (csid->phy.en_vc & BIT(i)) {
 			if (tg->enabled)
 				__csid_configure_testgen(csid, enable, i);
 
+			if (i == CSID_PIX_SRC_INDEX && !csid_is_lite(csid))
+				continue;
+
 			__csid_configure_rdi_stream(csid, enable, i);
 			__csid_configure_rx(csid, &csid->phy, i);
 			__csid_ctrl_rdi(csid, enable, i);
 		}
+
+	if (!csid_is_lite(csid) && (csid->phy.en_vc & BIT(CSID_PIX_SRC_INDEX))) {
+		if (!(csid->phy.en_vc & BIT(0)))
+			__csid_configure_rdi_stream(csid, enable, 0);
+
+		__csid_configure_rx(csid, &csid->phy, 0);
+		__csid_configure_ipp_stream(csid, enable, 0);
+		__csid_ctrl_ipp(csid, enable);
+		wmb();
+	}
 }
 
