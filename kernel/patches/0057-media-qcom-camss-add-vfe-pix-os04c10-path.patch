+	.write_regs = vfe_17x_write_regs,
+	.write_dmi = vfe_17x_write_dmi,
+	.map_buf = vfe_17x_map_buf,
+	.unmap_buf = vfe_17x_unmap_buf,
+	.set_buf = vfe_17x_set_buf,
+	.reg_update_ioctl = vfe_17x_reg_update_ioctl,
+	.start = vfe_17x_start,
+	.stop = vfe_17x_stop,
+	.wait_sof = vfe_17x_wait_sof,
