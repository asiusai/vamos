# vamOS kernel config fragment for Radxa Dragon Q6A (QCS6490 / SC7280 family)
# Merged on top of mainline arm64 `defconfig`.

# =============================================================================
# Boot format: EFI stub kernel, loaded directly by edk2 (no GRUB)
# =============================================================================
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_ZBOOT=y
CONFIG_QCOM_WDT=y
CONFIG_WATCHDOG_OPEN_TIMEOUT=0
CONFIG_EFI_GENERIC_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_EFI_VARS_PSTORE=y

# A stable EFI entry supplies its slot-specific command line. Qualcomm's
# removable-media fallback may supply only the EFI image path; the local fdt
# patch treats a command line without root= as absent and uses slot A here.
CONFIG_CMDLINE_FROM_BOOTLOADER=y
CONFIG_CMDLINE="console=ttyMSM0,115200n8 earlycon root=PARTLABEL=rootfs_a rootwait rw fw_devlink=permissive quiet loglevel=3 vamos.slot=a"

# =============================================================================
# QCS6490 / SC7280 platform
# =============================================================================
CONFIG_ARCH_QCOM=y
# The image is product-specific; generic ARM64 Tegra platform drivers cannot bind.
# CONFIG_ARCH_TEGRA is not set
CONFIG_PINCTRL_SC7280=y
CONFIG_SC_GCC_7280=y
CONFIG_SC_GPUCC_7280=y
# The product is headless. Do not probe the display clock/domain stack that
# the vendor UEFI used to leave configured for DP/HDMI output.
# CONFIG_SC_DISPCC_7280 is not set
CONFIG_SC_LPASSCC_7280=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_BCM_VOTER=y
CONFIG_INTERCONNECT_QCOM_RPMH_POSSIBLE=y
CONFIG_INTERCONNECT_QCOM_RPMH=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_INTERCONNECT_QCOM_SC7280=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_GDSC=y

# CoreSight trace hardware is not used in production. Its deferred probes
# also depend on firmware state normally established by the vendor UEFI.
# CONFIG_CORESIGHT is not set

# Use the ARMv8 crypto instructions instead of the optional Qualcomm QCE DMA
# engine. This avoids another unnecessary firmware/IOMMU handoff at boot.
# CONFIG_CRYPTO_DEV_QCE is not set

# Camera and drive recording use the Qualcomm Venus video engine. Keep it
# built in so dropping UEFI does not silently remove hardware video support.
CONFIG_VIDEO_QCOM_VENUS=y

# PMIC stack (PMK8350 + PM7325 + PMR735A)
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_MFD_QCOM_SPMI_PMIC=y
CONFIG_REGULATOR_QCOM_SPMI=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y

# =============================================================================
# Storage — NVMe and UFS only
# =============================================================================
# CONFIG_MMC is not set

# UFS (Dragon Q6A-UFS variants)
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y

# =============================================================================
# PCIe (Dragon's ethernet and any add-in cards are behind PCIe)
# =============================================================================
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIE_QCOM=y
CONFIG_PCIE_QCOM_COMMON=y
CONFIG_PHY_QCOM_QMP_PCIE=y

# NVMe — built-in so root= on NVMe works without initramfs
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y

# =============================================================================
# USB / Type-C
# =============================================================================
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_PHY_QCOM_USB_HS=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_ROLE_SWITCH=y
# USB 3 storage such as the Samsung T7 advertises UAS. Keep the driver built in
# so external storage is available without an initramfs and does not fall back
# to the slower Bulk-Only usb-storage transport.
CONFIG_USB_UAS=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_F_NCM=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_WWAN=y
CONFIG_USB_SERIAL_OPTION=y

# =============================================================================
# I2C / SPI / GENI serial engine (Qualcomm GSI/QUP)
# =============================================================================
CONFIG_I2C_QCOM_GENI=y
CONFIG_I2C_QCOM_CCI=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_SND_SOC_DMIC=m
CONFIG_SND_SOC_MAX98357A=m
CONFIG_SPI_SPIDEV=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y

# =============================================================================
# Networking
# =============================================================================
CONFIG_IPV6=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_RAW=y

# Ethernet — Dragon Q6A uses a Realtek RTL8111/8168 on PCIe.
CONFIG_R8169=y
# The production PCIe topology has no Mellanox network hardware.
# CONFIG_NET_VENDOR_MELLANOX is not set
# Keep STMMAC/ETHQOS too in case future variants wire up the SoC GMAC.
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_QCOM_ETHQOS=y

# =============================================================================
# Bluetooth
# =============================================================================
CONFIG_BT=y
CONFIG_BT_LE=y
CONFIG_BT_QCA=y
CONFIG_POWER_SEQUENCING=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_QCA=y

# =============================================================================
# WiFi — Dragon Q6A: ath11k-PCI for the on-board WCN-series chip, plus
# AIC8800 USB as a fallback if an external module is plugged in.
# (aic8800 kernel module is out-of-tree and currently broken on 6.18; we
# install the firmware blobs so it works once the module ports forward.)
# =============================================================================
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH_COMMON=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y

# =============================================================================
# Remoteproc / Modem / Audio DSP / Compute DSP
# =============================================================================
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_QCOM_Q6V5_MSS=y
CONFIG_QCOM_Q6V5_ADSP=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_PDR_HELPERS=y
CONFIG_RPMSG_CHAR=y
CONFIG_RESET_QCOM_PDC=y
CONFIG_QCOM_FASTRPC=y

# =============================================================================
# PPP (USB LTE modem)
# =============================================================================
CONFIG_PPP=y
CONFIG_PPP_ASYNC=y
CONFIG_PPP_DEFLATE=y
CONFIG_PPP_BSDCOMP=y
CONFIG_PPP_MPPE=y

# =============================================================================
# Camera (CAMSS / OS04C10)
# =============================================================================
CONFIG_SC_CAMCC_7280=y
CONFIG_SC_VIDEOCC_7280=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_V4L2_FWNODE=y
CONFIG_VIDEO_QCOM_CAMSS=y
CONFIG_VIDEO_OS04C10=y
# CONFIG_VIDEO_IMX219 is not set
CONFIG_VIDEO_IMX577=m
CONFIG_LEDS_IS31FL319X=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_ASIUS_BOOT=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y

# =============================================================================
# GPU (Adreno 643L, headless)
# tinygrad model inference uses DRM_MSM directly. The product has no display,
# so retain the Adreno render driver but compile out all scanout/output blocks.
# DRM_MSM compute depends on SCHED, GEM_SHMEM, EXEC, and GPUVM. Disable other
# DRM drivers from defconfig so the headless image does not carry KMS helpers.
# =============================================================================
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_GPU_STATE=y
# tinygrad's A635 compute command stream requires trusted-ring submission.
CONFIG_DRM_MSM_GPU_SUDO=y
# CONFIG_DRM_MSM_MDP4 is not set
# CONFIG_DRM_MSM_MDP5 is not set
# CONFIG_DRM_MSM_DPU is not set
# CONFIG_DRM_MSM_DP is not set
# CONFIG_DRM_MSM_DSI is not set
# CONFIG_DRM_MSM_HDMI is not set
CONFIG_DRM_EXEC=y
CONFIG_DRM_GPUVM=y
CONFIG_DRM_GEM_SHMEM_HELPER=y
CONFIG_DRM_SCHED=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_OCMEM=y
# The Dragon has an MSM/Adreno GPU; arm64 defconfig's Nouveau module is unused.
# CONFIG_DRM_NOUVEAU is not set

# =============================================================================
# Filesystems / compression / storage helpers
# =============================================================================
CONFIG_OVERLAY_FS=y
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_DEF_COMP="lz4"
CONFIG_CRYPTO_LZ4=y
CONFIG_LZ4_COMPRESS=y
CONFIG_LZ4_DECOMPRESS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZ4=y

# =============================================================================
# Power monitoring / sensors / misc
# =============================================================================
CONFIG_SENSORS_INA2XX=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# GPIO userspace (TODO: migrate to libgpiod chardev)
CONFIG_EXPERT=y
CONFIG_GPIO_SYSFS=y

# =============================================================================
# Misc
# =============================================================================
CONFIG_LOCALVERSION_AUTO=n
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_HIBERNATION=n
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_FW_LOADER_USER_HELPER_FALLBACK=n
CONFIG_EXTRA_FIRMWARE="regulatory.db regulatory.db.p7s qcom/a660_sqe.fw qcom/a660_gmu.bin qcom/qcm6490/qupv3fw.elf qcom/vpu-2.0/venus.mbn"
