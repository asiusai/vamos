CONFIG_DEFAULT_DEVICE_TREE="qcom/qcs6490-radxa-dragon-q6a"
# Dragon Q6A embeds the EDK2 core at 0x9f000000 inside the XBL image instead
# of providing RB3 Gen 2's separate uefi_a/uefi_b partitions. The first word
# of the stock core is an AArch64 branch to its reset vector, proving XBL
# enters at the segment base (the later EDK2 Sec log is not the XBL entry).
CONFIG_TEXT_BASE=0x9f000000
# Keep the pre-relocation stack above the embedded Secure Launch resources.
# __bss_end + this offset remains inside the stock 0x374000-byte XBL segment,
# with over 512 KiB of downward-growing stack headroom above the blob.
CONFIG_SYS_INIT_SP_BSS_OFFSET=0x230000
CONFIG_DEBUG_UART=y
CONFIG_DEBUG_UART_BOARD_INIT=y
CONFIG_DEBUG_UART_ANNOUNCE=y
CONFIG_DEBUG_UART_BASE=0x994000
CONFIG_DEBUG_UART_MSM_GENI=y
CONFIG_DEBUG_UART_MSM_GENI_16X=y
CONFIG_DEBUG_UART_CLOCK=7372800
# Boot immediately, while retaining U-Boot's zero-delay check for a UART byte
# that was already queued by recovery tooling before the prompt is reached.
CONFIG_BOOTDELAY=0
CONFIG_AUTOBOOT_ZERO_DELAY_RESCUE_MS=50
CONFIG_BOARD_EARLY_INIT_F=y
# CONFIG_USE_PREBOOT is not set
# Qualcomm's generic board leaves BOARDDIR empty, so include the vendor path.
CONFIG_ENV_SOURCE_FILE="qualcomm/asius-dragon-q6a"
# CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE is not set

# The product uses an explicit fixed boot path. Standard boot binds/probes all
# boot devices while entering the command loop, including absent UFS hardware.
# CONFIG_BOOTSTD is not set

# The direct Image/DT boot path and vamOS updater do not use UEFI services or
# capsules. Besides dead code, Qualcomm capsule discovery probes absent UFS
# before bootcmd and adds avoidable delay on NVMe systems.
# CONFIG_EFI_LOADER is not set

# The product has NVMe or UFS storage. Do not carry the eMMC/SD stack into the
# first stage merely because the generic Qualcomm configuration enables it.
# CONFIG_MMC is not set
# CONFIG_CMD_MMC is not set
# CONFIG_DFU_MMC is not set
# CONFIG_FASTBOOT_MMC_USER_SUPPORT is not set

CONFIG_PCI=y
CONFIG_PCIE_DW_QCOM=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_NVME=y
CONFIG_NVME_PCI=y
CONFIG_CMD_PCI=y
CONFIG_CMD_NVME=y
CONFIG_FAT_WRITE=y
CONFIG_CMD_VAMOSBOOT=y
CONFIG_CMD_QCOM_EDL=y
CONFIG_QCOM_SECURE_LAUNCH=y
CONFIG_CMD_IMPORTENV=y
CONFIG_CMD_EXPORTENV=y

# Keep UFS available for the production SOM option. Qualcomm UFS is exposed as
# a SCSI block device after `ufs init; scsi scan`.
CONFIG_UFS=y
CONFIG_UFS_QCOM=y
CONFIG_SCSI=y
CONFIG_CMD_UFS=y
CONFIG_CMD_SCSI=y

# Bring-up recovery remains available over UART and USB. These can be trimmed
# after both storage variants have completed destructive rollback testing.
CONFIG_CMD_GPIO=y
CONFIG_CMD_USB=y
CONFIG_USB=y
