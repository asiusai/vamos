diff --git a/arch/arm/dts/qcs6490-radxa-dragon-q6a-u-boot.dtsi b/arch/arm/dts/qcs6490-radxa-dragon-q6a-u-boot.dtsi
new file mode 100644
index 00000000..3e2676f8
--- /dev/null
+++ b/arch/arm/dts/qcs6490-radxa-dragon-q6a-u-boot.dtsi
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+/*
+ * XBL does not pass the external ABL FDT that normally fills this range.
+ * Keep U-Boot itself and its DMA allocations below 4 GiB: PCIe/NVMe runs
+ * without Linux's SMMU IOVA setup here, and the Dragon endpoint cannot
+ * complete admin-queue DMA to allocations at the top of the full 8 GiB.
+ * The kernel is booted with its separate production DT and sees all RAM.
+ */
+&{/memory@80000000} {
+	reg = <0 0x80000000 0 0x80000000>;
+};
+
+/* The product NVMe is on PCIe1. Avoid probing the unused Ethernet root port. */
+&pcie0 {
+	status = "disabled";
+};
+
+&pcie0_phy {
+	status = "disabled";
+};
+
+&pcie1 {
+	/*
+	 * The Dragon firmware routes the root port and directly attached NVMe
+	 * through the shared PCIe1 TBU stream.  Using SC7280's generic 0x1c81
+	 * endpoint SID leaves bus-master DMA disconnected on this module.
+	 */
+	iommu-map = <0x0 &apps_smmu 0x1c80 0x1>,
+		    <0x100 &apps_smmu 0x1c80 0x1>;
+
+	/* U-Boot does not model generated pipe-clock providers or their mux. */
+	clocks = <&gcc GCC_PCIE_1_PIPE_CLK>,
+		 <&rpmhcc RPMH_CXO_CLK>,
+		 <&gcc GCC_PCIE_1_AUX_CLK>,
+		 <&gcc GCC_PCIE_1_CFG_AHB_CLK>,
+		 <&gcc GCC_PCIE_1_MSTR_AXI_CLK>,
+		 <&gcc GCC_PCIE_1_SLV_AXI_CLK>,
+		 <&gcc GCC_PCIE_1_SLV_Q2A_AXI_CLK>,
+		 <&gcc GCC_AGGRE_NOC_PCIE_TBU_CLK>,
+		 <&gcc GCC_DDRSS_PCIE_SF_CLK>,
+		 <&gcc GCC_AGGRE_NOC_PCIE_CENTER_SF_AXI_CLK>,
+		 <&gcc GCC_AGGRE_NOC_PCIE_1_AXI_CLK>;
+	clock-names = "pipe", "ref", "aux", "cfg",
+		      "bus_master", "bus_slave", "slave_q2a", "tbu",
+		      "ddrss_sf_tbu", "aggre0", "aggre1";
+	bootph-all;
+};
+
+&pcie1_phy {
+	bootph-all;
+};
+
+/* QHEE leaves unmatched PCIe stream IDs faulting even though U-Boot is EL2. */
+&apps_smmu {
+	qcom,configure-at-el2;
+	bootph-all;
+};
+
+/* The production storage variants are mutually exclusive NVMe and UFS. */
+&ufs_mem_hc {
+	reset-gpios = <&tlmm 175 GPIO_ACTIVE_LOW>;
+	vcc-supply = <&vreg_l7b_2p96>;
+	vccq-supply = <&vreg_l9b_1p2>;
+	vccq2-supply = <&vreg_l9b_1p2>;
+	bootph-all;
+	status = "okay";
+};
+
+&ufs_mem_phy {
+	vdda-phy-supply = <&vreg_l10c_0p88>;
+	vdda-pll-supply = <&vreg_l6b_1p2>;
+	bootph-all;
+	status = "okay";
+};
+
+&sdhc_1 {
+	status = "disabled";
+};
+
+&sdhc_2 {
+	status = "disabled";
+};
+
+&uart5 {
+	bootph-all;
+};
