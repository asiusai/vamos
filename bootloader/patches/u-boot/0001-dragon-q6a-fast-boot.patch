diff --git a/arch/arm/mach-snapdragon/board.c b/arch/arm/mach-snapdragon/board.c
index 35735f15..d190cc33 100644
--- a/arch/arm/mach-snapdragon/board.c
+++ b/arch/arm/mach-snapdragon/board.c
@@ -24,6 +24,7 @@
 #include <init.h>
 #include <linux/arm-smccc.h>
 #include <linux/bug.h>
+#include <linux/delay.h>
 #include <linux/psci.h>
 #include <linux/sizes.h>
 #include <lmb.h>
@@ -39,6 +40,114 @@ DECLARE_GLOBAL_DATA_PTR;
 
 enum qcom_boot_source qcom_boot_source __section(".data") = 0;
 
+/*
+ * The Panda safety SOM is kept alive by GPIO27. Assert it before the serial
+ * console, relocation, storage discovery, or Linux DT processing can add
+ * avoidable dead time to the safety MCU path.
+ *
+ * SC7280/QCM6490 TLMM uses a 4 KiB stride, GPIO OE at bit 9 of CFG and the
+ * output value at bit 1 of IN_OUT. XBL has already mapped this MMIO range.
+ */
+#define DRAGON_Q6A_TLMM_BASE		0x0f100000UL
+#define DRAGON_Q6A_TLMM_STRIDE		0x1000
+#define DRAGON_Q6A_SOM_ALIVE_GPIO	27
+#define DRAGON_Q6A_UFS_CD_GPIO		7
+#define DRAGON_Q6A_GPIO_OE		BIT(9)
+#define DRAGON_Q6A_GPIO_IN		BIT(0)
+#define DRAGON_Q6A_GPIO_OUT		BIT(1)
+#define DRAGON_Q6A_GPIO_PULL_MASK	GENMASK(1, 0)
+#define DRAGON_Q6A_GPIO_PULL_UP		3
+#define DRAGON_Q6A_GPIO_FUNC_MASK	GENMASK(5, 2)
+#define DRAGON_Q6A_GUNYAH_TAKEOVER_SMC	0x02000121
+
+static void dragon_q6a_assert_som_alive(void)
+{
+	void __iomem *cfg;
+	void __iomem *in_out;
+	u32 value;
+
+	cfg = (void __iomem *)(DRAGON_Q6A_TLMM_BASE +
+			DRAGON_Q6A_SOM_ALIVE_GPIO * DRAGON_Q6A_TLMM_STRIDE);
+	in_out = cfg + 4;
+
+	/* Select GPIO, drive the high value, then enable the output. */
+	value = readl(cfg);
+	value &= ~DRAGON_Q6A_GPIO_FUNC_MASK;
+	writel(DRAGON_Q6A_GPIO_OUT, in_out);
+	writel(value | DRAGON_Q6A_GPIO_OE, cfg);
+}
+
+/*
+ * GPIO7 is the UFS connector's active-low card-detect signal.  Sampling it
+ * before bootcmd lets mutually exclusive product variants initialize their
+ * real boot medium first, without paying an absent PCIe link timeout on UFS.
+ * A pull-up makes the no-UFS/NVMe case deterministic.
+ */
+static bool dragon_q6a_ufs_present(void)
+{
+	void __iomem *cfg;
+	u32 value;
+
+	cfg = (void __iomem *)(DRAGON_Q6A_TLMM_BASE +
+			DRAGON_Q6A_UFS_CD_GPIO * DRAGON_Q6A_TLMM_STRIDE);
+	value = readl(cfg);
+	value &= ~(DRAGON_Q6A_GPIO_FUNC_MASK | DRAGON_Q6A_GPIO_OE |
+		   DRAGON_Q6A_GPIO_PULL_MASK);
+	writel(value | DRAGON_Q6A_GPIO_PULL_UP, cfg);
+	udelay(10);
+
+	return !(readl(cfg + 4) & DRAGON_Q6A_GPIO_IN);
+}
+
+/* Called from crt0 before the debug UART itself is initialized. */
+void board_debug_uart_init(void)
+{
+	dragon_q6a_assert_som_alive();
+}
+
+int board_early_init_f(void)
+{
+	if (fdt_node_check_compatible(gd->fdt_blob, 0, "radxa,dragon-q6a"))
+		return 0;
+
+	dragon_q6a_assert_som_alive();
+
+	return 0;
+}
+
+/* The OS DT contains the complete 8 GiB topology. U-Boot deliberately keeps
+ * its own allocator below 4 GiB for NVMe DMA, so the generic ARM fixup must
+ * not replace the OS memory node with U-Boot's private 2 GiB allocation pool.
+ */
+bool board_preserve_fdt_memory(void *blob)
+{
+	return !fdt_node_check_compatible(blob, 0, "radxa,dragon-q6a");
+}
+
+/* Radxa's Gunyah firmware can return its EL1 caller at EL2 during the final
+ * OS handoff. Stock EnvDxe issues this at ExitBootServices when the board DT
+ * requests KVM. Do the same immediately before U-Boot's cache teardown so
+ * Linux retains KVM and Venus support without UEFI.
+ */
+void board_cleanup_before_linux(void)
+{
+	struct arm_smccc_res res;
+
+	if (fdt_node_check_compatible(gd->fdt_blob, 0, "radxa,dragon-q6a"))
+		return;
+
+	if (current_el() == 1)
+		arm_smccc_smc(DRAGON_Q6A_GUNYAH_TAKEOVER_SMC, 0, 0, 1,
+			      0, 0, 0, 0, &res);
+
+	if (current_el() == 2)
+		printf("Dragon: Gunyah handed Linux EL2\n");
+	else
+		printf("Dragon: WARNING: Gunyah EL2 takeover failed "
+		       "(EL%u, a0=%lx a1=%lx)\n",
+		       current_el(), res.a0, res.a1);
+}
+
 static struct mm_region rbx_mem_map[CONFIG_NR_DRAM_BANKS + 2] = { { 0 } };
 
 struct mm_region *mem_map = rbx_mem_map;
@@ -509,5 +618,14 @@
-void __weak qcom_late_init(void)
-{
-}
-
+void __weak qcom_late_init(void)
+{
+	bool ufs_present;
+
+	if (fdt_node_check_compatible(gd->fdt_blob, 0, "radxa,dragon-q6a"))
+		return;
+
+	ufs_present = dragon_q6a_ufs_present();
+	env_set("vamos_storage", ufs_present ? "ufs" : "nvme");
+	printf("vamOS: %s selected by UFS card detect\n",
+	       ufs_present ? "UFS" : "NVMe");
+}
+
 #define KERNEL_COMP_SIZE	SZ_64M
