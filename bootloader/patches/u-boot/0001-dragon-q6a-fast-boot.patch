diff --git a/cmd/qcom_edl.c b/cmd/qcom_edl.c
new file mode 100644
index 00000000..8aad8a64
--- /dev/null
+++ b/cmd/qcom_edl.c
@@ -0,0 +1,151 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Qualcomm software-only emergency download reset. */
+
+#include <command.h>
+#include <asm/system.h>
+#include <linux/arm-smccc.h>
+#include <linux/kernel.h>
+#include <qcom_secure_launch.h>
+#include <vsprintf.h>
+
+/*
+ * Keep the two SMCs adjacent and register-exact.  The same sequence, loaded
+ * as a standalone RAM stub, is proven to enumerate the Dragon as 05c6:9008.
+ * Inserting a C call (including console output) between the cookie write and
+ * SDI-disable/reset makes this firmware's secure monitor wedge instead.
+ */
+extern long qcom_enter_edl_exact(void);
+
+asm(
+".pushsection .text.qcom_enter_edl_exact, \"ax\"\n"
+".align 4\n"
+".global qcom_enter_edl_exact\n"
+".type qcom_enter_edl_exact, %function\n"
+"qcom_enter_edl_exact:\n"
+"	movz	x0, #0x0502\n"
+"	movk	x0, #0x8200, lsl #16\n"
+"	mov	x1, #2\n"
+"	movz	x2, #0x3000\n"
+"	movk	x2, #0x01fd, lsl #16\n"
+"	mov	x3, #1\n"
+"	mov	x4, #0\n"
+"	mov	x5, #0\n"
+"	mov	x6, #0\n"
+"	mov	x7, #0\n"
+"	smc	#0\n"
+"	cbnz	x0, 1f\n"
+"	movz	x0, #0x0108\n"
+"	movk	x0, #0x8200, lsl #16\n"
+"	mov	x1, #1\n"
+"	mov	x2, #1\n"
+"	mov	x3, #0\n"
+"	mov	x4, #0\n"
+"	mov	x5, #0\n"
+"	mov	x6, #0\n"
+"	mov	x7, #0\n"
+"	smc	#0\n"
+"1:	ret\n"
+".size qcom_enter_edl_exact, . - qcom_enter_edl_exact\n"
+".popsection\n"
+);
+
+static int do_qcom_edl(struct cmd_tbl *cmdtp, int flag, int argc,
+		       char *const argv[])
+{
+	long ret;
+
+	puts("Entering Qualcomm EDL through the exact stock SMC sequence...\n");
+	ret = qcom_enter_edl_exact();
+	printf("Qualcomm EDL sequence returned unexpectedly: %ld\n", ret);
+	return CMD_RET_FAILURE;
+}
+
+U_BOOT_CMD(
+	edl, 1, 0, do_qcom_edl,
+	"enter Qualcomm emergency download mode",
+	"- set the Dragon EDL cookie and reset through Qualcomm SCM"
+);
+
+static int do_qcom_el2(struct cmd_tbl *cmdtp, int flag, int argc,
+		       char *const argv[])
+{
+	struct arm_smccc_res res;
+	int ret;
+
+	printf("Dragon: requesting Gunyah takeover from EL%u\n", current_el());
+	ret = qcom_secure_launch_prepare_platform();
+	if (ret) {
+		printf("Dragon: cannot register Gunyah platform data (%d)\n", ret);
+		return CMD_RET_FAILURE;
+	}
+	arm_smccc_smc(0x02000121, 0, 0, 1, 0, 0, 0, 0, &res);
+	printf("Dragon: takeover returned at EL%u (a0=%lx a1=%lx a2=%lx a3=%lx)\n",
+	       current_el(), res.a0, res.a1, res.a2, res.a3);
+
+	return current_el() == 2 ? CMD_RET_SUCCESS : CMD_RET_FAILURE;
+}
+
+U_BOOT_CMD(
+	el2, 1, 0, do_qcom_el2,
+	"request the Dragon Gunyah EL2 takeover",
+	"- diagnostic command used before storage and SMMU initialization"
+);
+
+static int do_qcom_sl_available(struct cmd_tbl *cmdtp, int flag, int argc,
+				char *const argv[])
+{
+	int ret = qcom_secure_launch_available();
+
+	printf("Dragon: Secure Launch availability at EL%u: %s (%d)\n",
+	       current_el(), ret ? "unavailable" : "available", ret);
+	return ret ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(
+	slavail, 1, 0, do_qcom_sl_available,
+	"probe the Qualcomm Secure Launch service",
+	"- non-destructive TrustZone ABI availability test"
+);
+
+static int do_qcom_sl_launch(struct cmd_tbl *cmdtp, int flag, int argc,
+			     char *const argv[])
+{
+	int ret = qcom_secure_launch();
+
+	printf("Dragon: Secure Launch command completed at EL%u (%d)\n",
+	       current_el(), ret);
+	return ret ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(
+	sllaunch, 1, 0, do_qcom_sl_launch,
+	"take over Gunyah and return U-Boot at EL2",
+	"- authenticate the stock signed TCB and perform Secure Launch"
+);
+
+static int do_qcom_pas_boot(struct cmd_tbl *cmdtp, int flag, int argc,
+			    char *const argv[])
+{
+	ulong firmware_addr, firmware_size, pas_id, region_addr, region_size;
+	int ret;
+
+	if (argc != 6)
+		return CMD_RET_USAGE;
+	firmware_addr = hextoul(argv[1], NULL);
+	firmware_size = hextoul(argv[2], NULL);
+	pas_id = hextoul(argv[3], NULL);
+	region_addr = hextoul(argv[4], NULL);
+	region_size = hextoul(argv[5], NULL);
+
+	ret = qcom_pas_boot((void *)firmware_addr, firmware_size, pas_id,
+			    region_addr, region_size);
+	if (ret)
+		printf("Dragon: PAS %lu boot failed (%d)\n", pas_id, ret);
+	return ret ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(
+	dspboot, 6, 0, do_qcom_pas_boot,
+	"authenticate and start a Qualcomm PAS firmware image",
+	"<firmware_addr> <firmware_size> <pas_id> <region_addr> <region_size>"
+);
diff --git a/cmd/vamosboot.c b/cmd/vamosboot.c
new file mode 100644
index 00000000..e413eefa
--- /dev/null
+++ b/cmd/vamosboot.c
@@ -0,0 +1,370 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Redundant vamOS A/B selector compatible with the existing GRUB records. */
+
+#include <blk.h>
+#include <command.h>
+#include <ctype.h>
+#include <env.h>
+#include <fs.h>
+#include <linux/errno.h>
+#include <linux/string.h>
+#include <malloc.h>
+#include <vsprintf.h>
+
+#define VAMOS_ENV_PATH "EFI/vamos/grubenv"
+#define VAMOS_ENV_SIZE 1024
+
+enum vamos_phase {
+	VAMOS_PHASE_INVALID,
+	VAMOS_PHASE_ARMED,
+	VAMOS_PHASE_ATTEMPTED,
+	VAMOS_PHASE_STABLE,
+};
+
+struct vamos_state {
+	unsigned long generation;
+	char active;
+	char pending;
+	enum vamos_phase phase;
+	bool edl_request;
+	char usb_mode[8];
+	char root_a[64];
+	char root_b[64];
+};
+
+static bool vamos_value(const char *buf, const char *name, char *out, size_t size)
+{
+	const char *line = buf;
+	size_t name_len = strlen(name);
+
+	while (line && *line) {
+		const char *end = strchr(line, '\n');
+		size_t line_len = end ? end - line : strlen(line);
+
+		if (line_len > name_len && !memcmp(line, name, name_len) &&
+		    line[name_len] == '=') {
+			size_t value_len = line_len - name_len - 1;
+
+			if (!value_len || value_len >= size)
+				return false;
+			memcpy(out, line + name_len + 1, value_len);
+			out[value_len] = '\0';
+			return true;
+		}
+		line = end ? end + 1 : NULL;
+	}
+
+	return false;
+}
+
+static int vamos_rank(enum vamos_phase phase)
+{
+	switch (phase) {
+	case VAMOS_PHASE_STABLE:
+		return 3;
+	case VAMOS_PHASE_ATTEMPTED:
+		return 2;
+	case VAMOS_PHASE_ARMED:
+		return 1;
+	default:
+		return 0;
+	}
+}
+
+static bool vamos_root_valid(const char *root)
+{
+	const char *value;
+
+	if (!strncmp(root, "PARTUUID=", 9))
+		value = root + 9;
+	else if (!strncmp(root, "PARTLABEL=", 10))
+		value = root + 10;
+	else
+		return false;
+	if (!*value)
+		return false;
+	for (; *value; value++) {
+		if (!isalnum((unsigned char)*value) && *value != '.' && *value != '_' &&
+		    *value != '-')
+			return false;
+	}
+	return true;
+}
+
+static int vamos_set_device(const char *interface, const char *device, int part)
+{
+	char devpart[24];
+
+	snprintf(devpart, sizeof(devpart), "%s:%d", device, part);
+	return fs_set_blk_dev(interface, devpart, FS_TYPE_FAT);
+}
+
+static int vamos_read_state(const char *interface, const char *device, int part,
+			    struct vamos_state *state)
+{
+	char generation[24], active[4], pending[4], phase[16], edl_request[4];
+	char usb_mode[8];
+	loff_t read = 0;
+	char *buf;
+	int ret;
+
+	buf = malloc(VAMOS_ENV_SIZE + 1);
+	if (!buf)
+		return -ENOMEM;
+
+	ret = vamos_set_device(interface, device, part);
+	if (ret)
+		goto out;
+	ret = fs_read(VAMOS_ENV_PATH, (ulong)buf, 0, VAMOS_ENV_SIZE, &read);
+	if (ret || read != VAMOS_ENV_SIZE) {
+		ret = ret ?: -EINVAL;
+		goto out;
+	}
+	buf[VAMOS_ENV_SIZE] = '\0';
+
+	if (!vamos_value(buf, "generation", generation, sizeof(generation)) ||
+	    !vamos_value(buf, "active", active, sizeof(active)) ||
+	    !vamos_value(buf, "phase", phase, sizeof(phase)) ||
+	    !vamos_value(buf, "root_a", state->root_a, sizeof(state->root_a)) ||
+	    !vamos_value(buf, "root_b", state->root_b, sizeof(state->root_b))) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (strict_strtoul(generation, 10, &state->generation)) {
+		ret = -EINVAL;
+		goto out;
+	}
+	state->active = active[0];
+	state->pending = 0;
+	state->edl_request = false;
+	strcpy(state->usb_mode, "ncm");
+	if (vamos_value(buf, "pending", pending, sizeof(pending))) {
+		if (pending[1]) {
+			ret = -EINVAL;
+			goto out;
+		}
+		state->pending = pending[0];
+	}
+	if (vamos_value(buf, "edl_request", edl_request,
+				sizeof(edl_request))) {
+		if (strcmp(edl_request, "0") && strcmp(edl_request, "1")) {
+			ret = -EINVAL;
+			goto out;
+		}
+		state->edl_request = !strcmp(edl_request, "1");
+	}
+	if (vamos_value(buf, "usb_mode", usb_mode, sizeof(usb_mode))) {
+		if (strcmp(usb_mode, "host") && strcmp(usb_mode, "ncm")) {
+			ret = -EINVAL;
+			goto out;
+		}
+		strcpy(state->usb_mode, usb_mode);
+	}
+	if (!strcmp(phase, "stable"))
+		state->phase = VAMOS_PHASE_STABLE;
+	else if (!strcmp(phase, "armed"))
+		state->phase = VAMOS_PHASE_ARMED;
+	else if (!strcmp(phase, "attempted"))
+		state->phase = VAMOS_PHASE_ATTEMPTED;
+	else
+		state->phase = VAMOS_PHASE_INVALID;
+	if (active[1] || (state->active != 'a' && state->active != 'b') ||
+	    !vamos_rank(state->phase) || !vamos_root_valid(state->root_a) ||
+	    !vamos_root_valid(state->root_b) ||
+	    (state->phase != VAMOS_PHASE_STABLE &&
+	     ((state->pending != 'a' && state->pending != 'b') ||
+	      state->pending == state->active)))
+		ret = -EINVAL;
+	else
+		ret = 0;
+out:
+	free(buf);
+	return ret;
+}
+
+static int vamos_write_one(const char *interface, const char *device, int part,
+			   const struct vamos_state *state)
+{
+	const char *phase = state->phase == VAMOS_PHASE_STABLE ? "stable" :
+		state->phase == VAMOS_PHASE_ATTEMPTED ? "attempted" : "armed";
+	char pending[2] = { state->pending, '\0' };
+	loff_t written = 0;
+	char *buf;
+	int len, ret;
+
+	buf = malloc(VAMOS_ENV_SIZE);
+	if (!buf)
+		return -ENOMEM;
+	memset(buf, '#', VAMOS_ENV_SIZE);
+	len = snprintf(buf, VAMOS_ENV_SIZE,
+		"# GRUB Environment Block\n"
+		"# WARNING: Do not edit this file by tools other than grub-editenv!!!\n"
+		"generation=%lu\nactive=%c\npending=%s\nphase=%s\n"
+		"root_a=%s\nroot_b=%s\nedl_request=%u\nusb_mode=%s\n",
+		state->generation, state->active, pending, phase,
+		state->root_a, state->root_b, state->edl_request,
+		state->usb_mode);
+	if (len <= 0 || len >= VAMOS_ENV_SIZE) {
+		ret = -E2BIG;
+		goto out;
+	}
+	/* Replace snprintf's terminator with GRUB environment padding. */
+	memset(buf + len, '#', VAMOS_ENV_SIZE - len);
+
+	ret = vamos_set_device(interface, device, part);
+	if (ret)
+		goto out;
+	ret = fs_write(VAMOS_ENV_PATH, (ulong)buf, 0, VAMOS_ENV_SIZE, &written);
+	if (!ret && written != VAMOS_ENV_SIZE)
+		ret = -EIO;
+out:
+	free(buf);
+	return ret;
+}
+
+static int vamos_persist(const char *interface, const char *device,
+			 const struct vamos_state *state)
+{
+	int ret_b, ret_a;
+
+	/* Backup first: a reset between writes leaves at least one valid record. */
+	ret_b = vamos_write_one(interface, device, 3, state);
+	ret_a = vamos_write_one(interface, device, 1, state);
+	return ret_a && ret_b ? ret_a : 0;
+}
+
+static void vamos_export_choice(const struct vamos_state *state,
+				const char *interface, const char *device,
+				char slot, const char *boot_state_arg)
+{
+	char esp[4] = { slot == 'a' ? '1' : '3', '\0' };
+	char rootpart[4] = { slot == 'a' ? '2' : '4', '\0' };
+	char slot_string[2] = { slot, '\0' };
+	const char *root = slot == 'a' ? state->root_a : state->root_b;
+	char legacy_root[24];
+
+	/*
+	 * Factory and older recovery ESPs used PARTLABEL references. If both
+	 * supported media are attached on a bench, those labels are duplicated.
+	 * Keep their metadata readable but bind Linux to the storage U-Boot just
+	 * selected. New factory images and OTA state use a persistent PARTUUID.
+	 */
+	if (!strncmp(root, "PARTLABEL=", 10) && !strcmp(device, "0")) {
+		if (!strcmp(interface, "nvme")) {
+			snprintf(legacy_root, sizeof(legacy_root),
+				 "/dev/nvme0n1p%s", rootpart);
+			root = legacy_root;
+		} else if (!strcmp(interface, "scsi")) {
+			snprintf(legacy_root, sizeof(legacy_root),
+				 "/dev/sda%s", rootpart);
+			root = legacy_root;
+		}
+	}
+
+	env_set("vamos_slot", slot_string);
+	env_set("vamos_esp", esp);
+	env_set("vamos_rootpart", rootpart);
+	env_set("vamos_root", root);
+	env_set("vamos_state_arg", boot_state_arg);
+	env_set("vamos_usb_mode", state->usb_mode);
+}
+
+static int do_vamosboot(struct cmd_tbl *cmdtp, int flag, int argc,
+			char *const argv[])
+{
+	struct vamos_state states[2], *chosen = NULL;
+	const char *interface, *device;
+	char slot;
+	int valid = 0, i;
+	const char *boot_state_arg = "";
+
+	if (argc < 3 || argc > 4)
+		return CMD_RET_USAGE;
+	interface = argv[1];
+	device = argv[2];
+	env_set("vamos_edl", "0");
+
+	for (i = 0; i < 2; i++) {
+		int part = i ? 3 : 1;
+
+		if (vamos_read_state(interface, device, part, &states[valid]))
+			continue;
+		if (!chosen || states[valid].generation > chosen->generation ||
+		    (states[valid].generation == chosen->generation &&
+		     vamos_rank(states[valid].phase) > vamos_rank(chosen->phase)))
+			chosen = &states[valid];
+		valid++;
+	}
+	if (!chosen) {
+		printf("vamOS: no valid A/B state on %s %s\n", interface, device);
+		return CMD_RET_FAILURE;
+	}
+
+	if (argc == 3 && chosen->edl_request) {
+		/*
+		 * Advance the generation before clearing the redundant request.  If
+		 * only one ESP is writable, its cleared record must outrank the stale
+		 * request on the other ESP on the next boot.
+		 */
+		chosen->generation++;
+		chosen->edl_request = false;
+		if (vamos_persist(interface, device, chosen)) {
+			printf("vamOS: could not consume software EDL request\n");
+		} else {
+			printf("vamOS: entering one-shot software EDL recovery\n");
+			env_set("vamos_edl", "1");
+			return CMD_RET_SUCCESS;
+		}
+	}
+
+	if (argc == 4 && !strcmp(argv[3], "fail")) {
+		if (chosen->phase == VAMOS_PHASE_ATTEMPTED) {
+			/* The pending trial failed: return to the known-good slot. */
+			slot = chosen->active;
+			printf("vamOS: trial slot %c failed; returning to %c\n",
+			       chosen->pending, slot);
+		} else {
+			/* The stable slot failed: promote its peer as recovery. */
+			chosen->generation++;
+			chosen->active = chosen->active == 'a' ? 'b' : 'a';
+			slot = chosen->active;
+			boot_state_arg = "vamos.recovery=1";
+			printf("vamOS: stable slot failed; trying recovery slot %c\n",
+			       slot);
+		}
+		chosen->pending = 0;
+		chosen->phase = VAMOS_PHASE_STABLE;
+		vamos_persist(interface, device, chosen);
+	} else if (chosen->phase == VAMOS_PHASE_ARMED) {
+		slot = chosen->pending;
+		chosen->phase = VAMOS_PHASE_ATTEMPTED;
+		if (vamos_persist(interface, device, chosen)) {
+			printf("vamOS: could not persist trial; keeping slot %c\n",
+			       chosen->active);
+			slot = chosen->active;
+		} else {
+			boot_state_arg = "vamos.trial=1";
+		}
+	} else if (chosen->phase == VAMOS_PHASE_ATTEMPTED) {
+		printf("vamOS: rolling back uncommitted slot %c\n", chosen->pending);
+		chosen->pending = 0;
+		chosen->phase = VAMOS_PHASE_STABLE;
+		vamos_persist(interface, device, chosen);
+		slot = chosen->active;
+	} else {
+		slot = chosen->active;
+	}
+
+	vamos_export_choice(chosen, interface, device, slot, boot_state_arg);
+	printf("vamOS: booting slot %c%s\n", slot,
+	       *boot_state_arg ? " (non-stable path)" : "");
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(
+	vamosboot, 4, 0, do_vamosboot,
+	"select and persist the vamOS A/B slot",
+	"<interface> <device> [fail]\n"
+	"    - read redundant EFI/vamos/grubenv records and export vamos_*"
+);
diff --git a/common/autoboot.c b/common/autoboot.c
