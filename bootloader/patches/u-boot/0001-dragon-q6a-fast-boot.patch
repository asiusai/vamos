+++ b/common/autoboot.c
@@ -389,6 +389,23 @@ static int abortboot_single_key(int bootdelay)
 		abort = 1;	/* don't auto boot	*/
 	}
 
+	/* A zero-second boot normally samples the UART only once. Give remote
+	 * recovery tooling a short, explicitly bounded rescue window without
+	 * paying a full one-second CONFIG_BOOTDELAY penalty.
+	 */
+	if (!bootdelay && !abort && CONFIG_AUTOBOOT_ZERO_DELAY_RESCUE_MS) {
+		ts = get_timer(0);
+		do {
+			if (tstc()) {
+				getchar();
+				print_boot_delay(0);
+				abort = 1;
+				break;
+			}
+			udelay(1000);
+		} while (get_timer(ts) < CONFIG_AUTOBOOT_ZERO_DELAY_RESCUE_MS);
+	}
+
 	while ((bootdelay > 0) && (!abort)) {
 		--bootdelay;
 		/* delay 1000 ms */
diff --git a/drivers/clk/qcom/clock-sc7280.c b/drivers/clk/qcom/clock-sc7280.c
index 91e3fcc2..dbe4d8ed 100644
--- a/drivers/clk/qcom/clock-sc7280.c
+++ b/drivers/clk/qcom/clock-sc7280.c
@@ -109,6 +109,26 @@ static ulong sc7280_set_rate(struct clk *clk, ulong rate)
 		clk_rcg_set_rate_mnd(priv->base, 0x17860,
 				     freq->pre_div, freq->m, freq->n, freq->src, 16);
 		return freq->freq;
+	case GCC_QUPV3_WRAP1_S2_CLK:
+		freq = qcom_find_freq(ftbl_gcc_qupv3_wrap0_s2_clk_src, rate);
+		clk_rcg_set_rate_mnd(priv->base, 0x18270,
+				     freq->pre_div, freq->m, freq->n, freq->src, 16);
+		return freq->freq;
+	case GCC_QUPV3_WRAP1_S4_CLK:
+		freq = qcom_find_freq(ftbl_gcc_qupv3_wrap0_s2_clk_src, rate);
+		clk_rcg_set_rate_mnd(priv->base, 0x184d0,
+				     freq->pre_div, freq->m, freq->n, freq->src, 16);
+		return freq->freq;
+	case GCC_QUPV3_WRAP1_S5_CLK:
+		freq = qcom_find_freq(ftbl_gcc_qupv3_wrap0_s2_clk_src, rate);
+		clk_rcg_set_rate_mnd(priv->base, 0x18600,
+				     freq->pre_div, freq->m, freq->n, freq->src, 16);
+		return freq->freq;
