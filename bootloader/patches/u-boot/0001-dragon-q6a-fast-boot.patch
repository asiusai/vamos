index 00000000..b3f06240
--- /dev/null
+++ b/arch/arm/mach-snapdragon/secure_launch.c
@@ -0,0 +1,1055 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Qualcomm Secure Launch handoff for U-Boot.
+ *
+ * Copyright (c) 2024 Nikita Travkin <nikita@trvn.ru>
+ * Copyright (c) 2026 Asius Technologies, Inc.
+ *
+ * The Secure Launch data layout and transition mechanism are derived from
+ * slbounce: https://github.com/TravMurav/slbounce
+ */
+
+#include <asm/cache.h>
+#include <asm/system.h>
+#include <asm/unaligned.h>
+#include <cpu_func.h>
+#include <errno.h>
+#include <linux/arm-smccc.h>
+#include <linux/build_bug.h>
+#include <linux/kernel.h>
+#include <linux/sizes.h>
+#include <malloc.h>
+#include <qcom_secure_launch.h>
+
+#define QCOM_SL_SMC_ID			0xc3000001UL
+#define QCOM_SL_CMD_IS_AVAILABLE	1
+#define QCOM_SL_CMD_AUTH		2
+#define QCOM_SL_CMD_LAUNCH		4
+#define QCOM_SL_SMC_INTERRUPTED		1
+#define QCOM_SL_MAX_INTERRUPTS		64
+
+#define QCOM_QSEE_OWNER			ARM_SMCCC_OWNER_TRUSTED_OS
+#define QCOM_QSEE_APP_MGR_SERVICE	1
+#define QCOM_QSEE_APP_START_COMMAND	1
+#define QCOM_QSEE_APP_LOOKUP_COMMAND	3
+#define QCOM_QSEE_APP_REGION_COMMAND	5
+#define QCOM_QSEE_LOAD_SERVICES_COMMAND	7
+#define QCOM_QSEE_SMC(command)		ARM_SMCCC_CALL_VAL(\
+	ARM_SMCCC_STD_CALL, ARM_SMCCC_SMC_64, QCOM_QSEE_OWNER, \
+	(QCOM_QSEE_APP_MGR_SERVICE << 8) | (command))
+#define QCOM_QSEE_APP_START_ID		QCOM_QSEE_SMC(QCOM_QSEE_APP_START_COMMAND)
+#define QCOM_QSEE_APP_LOOKUP_ID		QCOM_QSEE_SMC(QCOM_QSEE_APP_LOOKUP_COMMAND)
+#define QCOM_QSEE_APP_REGION_ID		QCOM_QSEE_SMC(QCOM_QSEE_APP_REGION_COMMAND)
+#define QCOM_QSEE_LOAD_SERVICES_ID	QCOM_QSEE_SMC(QCOM_QSEE_LOAD_SERVICES_COMMAND)
+#define QCOM_QSEE_ARGS_2_RW_VAL		(2 | (2 << 4))
+#define QCOM_QSEE_ARGS_3_VAL		3
+#define QCOM_QSEE_RESULT_SUCCESS	0
+#define QCOM_QSEE_RESULT_FAILURE	0xffffffffUL
+#define QCOM_QSEE_RESPONSE_APP_ID	0xee01
+#define QCOM_QSEE_TZAPPS_ADDR		0xc1800000UL
+#define QCOM_QSEE_TZAPPS_SIZE		0x02200000UL
+#define QCOM_QSEE_MSSECAPP_ADDR		0x9bd00000UL
+#define QCOM_QSEE_LEGACY_CMD_ADDR	0x9bd40000UL
+#define QCOM_QSEE_APP_NAME_ADDR		0x9bd80000UL
+#define QCOM_QSEE_MSSECAPP_NAME		"qcom.tz.mssecapp"
+#define QCOM_QSEE_LEGACY_SCHEDULER_ID	0x0003f001
+#define QCOM_QSEE_LEGACY_CMD_SIZE	0x5c
+#define QCOM_QSEE_LEGACY_REQUEST_OFF	0x10
+#define QCOM_QSEE_LEGACY_RESPONSE_OFF	0x44
+
+#define QCOM_SL_BLOB_MAGIC		"VAMOS-SL"
+#define QCOM_SL_BLOB_VERSION		3
+#define QCOM_SL_TCB_PAGES		512
+#define QCOM_SL_CRT_PAGES		24
+#define QCOM_SL_TCG_PAGES		2
+#define QCOM_SL_BOOT_PARAMS_PAGES	3
+#define QCOM_SL_BLOB_MAX_SIZE		SZ_2M
+/*
+ * Secure Launch inputs must live in an XBL AddMem region already mapped by
+ * QHEE.  HLOS6 (0xa0b00000..0xbb600000) is AddDynamicMem and faults when the
+ * launch manager reads it at EL2.  The stock DXE heap is an AddMem region and
+ * is otherwise unused after U-Boot has replaced EDK2.
+ */
+#define QCOM_SL_TCB_ADDR		0x9c000000UL
+#define QCOM_SL_BUFFER_ADDR		0x9c200000UL
+#define QCOM_SL_BOOT_PARAMS_ADDR	0x9c240000UL
+
+/*
+ * QHEE's launch manager consumes the same CSRT-backed platform description
+ * that stock AcpiPlatform registers through ScmDxe.  Linux still boots from
+ * DT; this copy only supplies the pre-launch hypervisor firmware contract.
+ */
+/* PIL creates a temporary SHM bridge for metadata, so use ordinary HLOS RAM. */
+#define QCOM_ACPI_ELF_ADDR		0xa1000000UL
+#define QCOM_ACPI_MAX_SIZE		SZ_1M
+#define QCOM_ACPI_VERSION		0x16
+#define QCOM_ACPI_SCM_SET_ELF		0x02000201UL
+#define QCOM_ACPI_SCM_SET_TABLES	0x02000202UL
+#define QCOM_ACPI_SCM_LOAD		0x02000205UL
+#define QCOM_ACPI_SCM_START		0x02000206UL
+#define QCOM_SCM_64_BIT			BIT(30)
+#define QCOM_SCM_ARGS_1			0x01
+#define QCOM_SCM_ARGS_2_RW		0x82
+#define QCOM_SCM_ARGS_3			0x03
+#define QCOM_SCM_ARGS_4			0x04
+
+#define QCOM_PAS_SVC			0x02
+#define QCOM_PAS_INIT_IMAGE		0x01
+#define QCOM_PAS_MEM_SETUP		0x02
+#define QCOM_PAS_AUTH_AND_RESET		0x05
+#define QCOM_PAS_METADATA_ADDR		0xa0f00000UL
+#define QCOM_PAS_METADATA_MAX_SIZE	SZ_64K
+#define QCOM_PAS_SMC_INTERRUPTED	1
+
+#define QCOM_MP_SVC			0x0c
+#define QCOM_MP_VIDEO_VAR		0x08
+#define QCOM_VENUS_PAS_ID		9
+#define QCOM_VENUS_CP_START		0
+#define QCOM_VENUS_CP_SIZE		0x25800000
+#define QCOM_VENUS_CP_NONPIXEL_START	0x01000000
+#define QCOM_VENUS_CP_NONPIXEL_SIZE	0x24800000
+
+#define ELF_MAGIC			0x464c457f
+#define ELFCLASS32			1
+#define ELFDATA2LSB			1
+#define ELF_ARM_MACHINE			0x28
+#define ELF_PT_NULL			0
+#define ELF_PT_LOAD			1
+#define ELF32_HEADER_SIZE		52
+#define ELF32_PROGRAM_SIZE		32
+#define QCOM_ELF_SEGMENT_TYPE_MASK	0x07000000
+#define QCOM_ELF_SEGMENT_TYPE_SHIFT	24
+#define QCOM_ELF_SEGMENT_HASH		2
+#define QCOM_ELF_RELOCATABLE		BIT(27)
+
+#define PE_DOS_MAGIC			0x5a4d
+#define PE_NT_MAGIC			0x00004550
+#define PE_AARCH64_MACHINE		0xaa64
+#define PE32_PLUS_MAGIC			0x020b
+#define PE_BOOT_APPLICATION		16
+#define PE_SECURITY_DIRECTORY		4
+#define PE_DIRECTORY_COUNT_OFF		108
+#define PE_DIRECTORY_TABLE_OFF		112
+#define PE_SIZE_OF_IMAGE_OFF		56
+#define PE_SIZE_OF_HEADERS_OFF		60
+#define PE_SUBSYSTEM_OFF		68
+#define PE_SECTION_SIZE			40
+
+struct qcom_sl_blob_header {
+	u8 magic[8];
+	u32 version;
+	u32 tcb_size;
+	u32 mssecapp_size;
+	u32 acpi_size;
+} __packed;
+
+struct qcom_qsee_response {
+	ulong result;
+	ulong type;
+	ulong data;
+};
+
+struct qcom_sl_smc_params {
+	u16 a;
+	u16 b;
+	u32 version;
+	u32 command;
+	u32 reserved;
+	u64 pe_data;
+	u64 pe_size;
+	u64 arg_data;
+	u64 arg_size;
+} __packed;
+
+struct qcom_sl_dma_range {
+	u64 a;
+	u64 b;
+	u64 c;
+} __packed;
+
+struct qcom_sl_transition_data {
+	u64 mair;
+	u64 sp;
+	u64 tcr;
+	u64 ttbr0;
+	u64 ttbr1;
+} __packed;
+
+struct qcom_sl_tz_data {
+	u32 version;
+	u32 cert_offset;
+	u32 cert_size;
+	u32 tcg_offset;
+	u32 tcg_size;
+	u32 tcg_used;
+	u32 tcg_version;
+	u32 reserved0;
+	u64 this_size;
+	u64 this_phys;
+	u32 crt_offset;
+	u32 crt_page_count;
+	u64 boot_params;
+	u32 boot_params_size;
+	u32 reserved1;
+	u64 transition_entry;
+	u64 transition_virt;
+	u64 transition_phys;
+	u64 transition_size;
+	struct qcom_sl_transition_data transition_data;
+	struct qcom_sl_dma_range dma_ranges[2];
+	u32 dma_range_count;
+	u32 reserved2;
+} __packed;
+
+struct qcom_sl_context {
+	struct qcom_sl_smc_params *params;
+	struct qcom_sl_tz_data *tz;
+	void *tcb;
+	void *buffer;
+	void *boot_params;
+	u64 tcb_size;
+	u64 arg_size;
+	size_t buffer_size;
+	const void *mssecapp;
+	size_t mssecapp_size;
+	const void *acpi;
+	size_t acpi_size;
+};
+
+extern void qcom_sl_transition_entry(void);
+extern int qcom_sl_setjmp(u64 *buffer) __attribute__((returns_twice));
+extern u64 qcom_sl_jump_buffer[21];
+
+static bool range_valid(size_t total, size_t offset, size_t size)
+{
+	return offset <= total && size <= total - offset;
+}
+
+static int qcom_pas_scm(u32 command, ulong arginfo, ulong arg0,
+			ulong arg1, ulong arg2)
+{
+	struct arm_smccc_res res;
+	struct arm_smccc_quirk quirk = {
+		.id = ARM_SMCCC_QUIRK_QCOM_A6,
+	};
+	ulong function = ARM_SMCCC_CALL_VAL(ARM_SMCCC_STD_CALL,
+					    ARM_SMCCC_SMC_64,
+					    ARM_SMCCC_OWNER_SIP,
+					    (QCOM_PAS_SVC << 8) | command);
+	unsigned int interrupts = 0;
+
+	do {
+		arm_smccc_smc_quirk(function, arginfo, arg0, arg1, arg2, 0,
+				     quirk.state.a6, 0, &res, &quirk);
+		if (res.a0 == QCOM_PAS_SMC_INTERRUPTED)
+			function = QCOM_PAS_SMC_INTERRUPTED;
+	} while (res.a0 == QCOM_PAS_SMC_INTERRUPTED &&
+		 ++interrupts < QCOM_SL_MAX_INTERRUPTS);
+
+	printf("Dragon: PAS SCM cmd=%u resumes=%u a0=%lx result=%lx\n",
+	       command, interrupts, res.a0, res.a1);
+	if (res.a0 == QCOM_PAS_SMC_INTERRUPTED)
+		return -ETIMEDOUT;
+	if (res.a0)
+		return -EIO;
+	return res.a1 ? -EACCES : 0;
+}
+
+static int qcom_venus_protect_memory(void)
+{
+	struct arm_smccc_res res;
+	struct arm_smccc_quirk quirk = {
+		.id = ARM_SMCCC_QUIRK_QCOM_A6,
+	};
+	ulong function = ARM_SMCCC_CALL_VAL(ARM_SMCCC_STD_CALL,
+					    ARM_SMCCC_SMC_64,
+					    ARM_SMCCC_OWNER_SIP,
+					    (QCOM_MP_SVC << 8) |
+					    QCOM_MP_VIDEO_VAR);
+	unsigned int interrupts = 0;
+
+	do {
+		arm_smccc_smc_quirk(function, QCOM_SCM_ARGS_4,
+				     QCOM_VENUS_CP_START, QCOM_VENUS_CP_SIZE,
+				     QCOM_VENUS_CP_NONPIXEL_START,
+				     QCOM_VENUS_CP_NONPIXEL_SIZE,
+				     quirk.state.a6, 0, &res, &quirk);
+		if (res.a0 == QCOM_PAS_SMC_INTERRUPTED)
+			function = QCOM_PAS_SMC_INTERRUPTED;
+	} while (res.a0 == QCOM_PAS_SMC_INTERRUPTED &&
+		 ++interrupts < QCOM_SL_MAX_INTERRUPTS);
+
+	printf("Dragon: Venus memory protection resumes=%u a0=%lx result=%lx\n",
+	       interrupts, res.a0, res.a1);
+	if (res.a0 == QCOM_PAS_SMC_INTERRUPTED)
+		return -ETIMEDOUT;
+	if (res.a0)
+		return -EIO;
+	return res.a1 ? -EACCES : 0;
+}
+
+/*
+ * Load a combined Qualcomm MDT/MBN image exactly as Linux's qcom_mdt_loader
+ * does. Radxa's firmware performs this for ADSP and CDSP before Secure Launch;
+ * once Gunyah has taken ownership Linux is no longer allowed to authenticate
+ * these images itself.
+ */
+int qcom_pas_boot(const void *firmware, size_t firmware_size, u32 pas_id,
+		  ulong region_addr, size_t region_size)
+{
+	const u8 *file = firmware;
+	const u8 *programs;
+	u8 *metadata = (void *)QCOM_PAS_METADATA_ADDR;
+	u32 program_offset, metadata_header_size, hash_offset = 0;
+	u32 hash_size = 0;
+	u32 min_addr = U32_MAX, max_addr = 0;
+	u16 program_size, program_count;
+	bool relocatable = false;
+	size_t metadata_size;
+	int hash_count = 0;
+	int i, ret;
+
+	if (firmware_size < ELF32_HEADER_SIZE ||
+	    get_unaligned_le32(file) != ELF_MAGIC ||
+	    file[4] != ELFCLASS32 || file[5] != ELFDATA2LSB)
+		return -EINVAL;
+
+	program_offset = get_unaligned_le32(file + 28);
+	program_size = get_unaligned_le16(file + 42);
+	program_count = get_unaligned_le16(file + 44);
+	if (program_size < ELF32_PROGRAM_SIZE || !program_count ||
+	    !range_valid(firmware_size, program_offset,
+			 program_size * (size_t)program_count))
+		return -EINVAL;
+	programs = file + program_offset;
+
+	/* Qualcomm stores the complete ELF/program-header block in segment 0. */
+	metadata_header_size = get_unaligned_le32(programs + 16);
+	if (!metadata_header_size || metadata_header_size > firmware_size)
+		return -EINVAL;
+
+	for (i = 0; i < program_count; i++) {
+		const u8 *program = programs + i * program_size;
+		u32 type = get_unaligned_le32(program);
+		u32 offset = get_unaligned_le32(program + 4);
+		u32 paddr = get_unaligned_le32(program + 12);
+		u32 file_size = get_unaligned_le32(program + 16);
+		u32 memory_size = get_unaligned_le32(program + 20);
+		u32 flags = get_unaligned_le32(program + 24);
+		u32 segment_type = (flags & QCOM_ELF_SEGMENT_TYPE_MASK) >>
+				   QCOM_ELF_SEGMENT_TYPE_SHIFT;
+
+		if ((type == ELF_PT_NULL || type == ELF_PT_LOAD) &&
+		    segment_type == QCOM_ELF_SEGMENT_HASH) {
+			if (!file_size ||
+			    !range_valid(firmware_size, offset, file_size))
+				return -EINVAL;
+			hash_offset = offset;
+			hash_size = file_size;
+			hash_count++;
+			continue;
+		}
+		if (type != ELF_PT_LOAD || !memory_size)
+			continue;
+		if (file_size > memory_size ||
+		    (file_size &&
+		     !range_valid(firmware_size, offset, file_size)) ||
+		    paddr > U32_MAX - memory_size)
+			return -EINVAL;
+		min_addr = min(min_addr, paddr);
+		max_addr = max(max_addr, ALIGN(paddr + memory_size, SZ_4K));
+		if (flags & QCOM_ELF_RELOCATABLE)
+			relocatable = true;
+	}
+	if (hash_count != 1 || min_addr >= max_addr)
+		return -EINVAL;
+	if (!relocatable || max_addr - min_addr > region_size)
+		return -EINVAL;
+
+	metadata_size = metadata_header_size + hash_size;
+	if (metadata_size > QCOM_PAS_METADATA_MAX_SIZE)
+		return -E2BIG;
+	memcpy(metadata, file, metadata_header_size);
+	memcpy(metadata + metadata_header_size, file + hash_offset, hash_size);
+	flush_dcache_range((ulong)metadata,
+			   ALIGN((ulong)metadata + metadata_size,
+				 ARCH_DMA_MINALIGN));
+
+	ret = qcom_pas_scm(QCOM_PAS_INIT_IMAGE, QCOM_SCM_ARGS_2_RW,
+			   pas_id, (ulong)metadata, 0);
+	if (ret)
+		return ret;
+	ret = qcom_pas_scm(QCOM_PAS_MEM_SETUP, QCOM_SCM_ARGS_3,
+			   pas_id, region_addr, max_addr - min_addr);
+	if (ret)
+		return ret;
+
+	memset((void *)region_addr, 0, region_size);
+	for (i = 0; i < program_count; i++) {
+		const u8 *program = programs + i * program_size;
+		u32 type = get_unaligned_le32(program);
+		u32 offset = get_unaligned_le32(program + 4);
+		u32 paddr = get_unaligned_le32(program + 12);
+		u32 file_size = get_unaligned_le32(program + 16);
+		u32 memory_size = get_unaligned_le32(program + 20);
+		u32 flags = get_unaligned_le32(program + 24);
+		u32 segment_type = (flags & QCOM_ELF_SEGMENT_TYPE_MASK) >>
+				   QCOM_ELF_SEGMENT_TYPE_SHIFT;
+		size_t destination_offset;
+
+		if (type != ELF_PT_LOAD || !memory_size ||
+		    segment_type == QCOM_ELF_SEGMENT_HASH)
+			continue;
+		destination_offset = paddr - min_addr;
+		memcpy((void *)(region_addr + destination_offset),
+		       file + offset, file_size);
+	}
+	flush_dcache_range(region_addr,
+			   ALIGN(region_addr + region_size, ARCH_DMA_MINALIGN));
+
+	ret = qcom_pas_scm(QCOM_PAS_AUTH_AND_RESET, QCOM_SCM_ARGS_1,
+			   pas_id, 0, 0);
+	if (!ret && pas_id == QCOM_VENUS_PAS_ID)
+		ret = qcom_venus_protect_memory();
+	if (!ret)
+		printf("Dragon: PAS %u started from %zu-byte image at %lx/%zx\n",
+		       pas_id, firmware_size, region_addr, region_size);
+	return ret;
+}
+
+/* Match ScmDxe's raw fast-call wrapper, including interrupted-call resumes. */
+static int qcom_acpi_scm(ulong command, ulong arginfo, ulong arg0,
+			 ulong arg1, ulong arg2)
+{
+	register ulong x0 asm("x0") = command | QCOM_SCM_64_BIT;
+	register ulong x1 asm("x1") = arginfo;
+	register ulong x2 asm("x2") = arg0;
+	register ulong x3 asm("x3") = arg1;
+	register ulong x4 asm("x4") = arg2;
+	register ulong x5 asm("x5") = 0;
+	register ulong x6 asm("x6") = 0;
+	register ulong x7 asm("x7") = 0;
+
+	/*
+	 * Keep the retry branch inside one asm block.  QHEE can return opaque
+	 * continuation state in caller-saved registers above x7; touching a C
+	 * loop counter between SMCs corrupts that state.  This is the exact loop
+	 * emitted by the stock ScmDxe wrapper.
+	 */
+	asm volatile("1: smc #0\n"
+		     "cmp w0, #0\n"
+		     "b.gt 1b\n"
+		     : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3),
+		       "+r" (x4), "+r" (x5), "+r" (x6), "+r" (x7)
+		     : : "cc", "memory", "x8", "x9", "x10", "x11", "x12",
+			 "x13", "x14", "x15", "x16", "x17");
+
+	printf("Dragon: ACPI SCM %lx a0=%lx a1=%lx a2=%lx a3=%lx\n",
+	       command, x0, x1, x2, x3);
+	return x0 ? -EIO : 0;
+}
+
+static int qcom_acpi_register(struct qcom_sl_context *ctx)
+{
+	const u8 *source = ctx->acpi;
+	u8 *image = (void *)QCOM_ACPI_ELF_ADDR;
+	u32 program_offset, metadata_end, hash_offset = 0, hash_size = 0;
+	u32 load_offset = 0, load_size = 0;
+	u16 program_size, program_count;
+	unsigned int hash_count = 0, load_count = 0;
+	int i, ret;
+
+	if (ctx->acpi_size < ELF32_HEADER_SIZE ||
+	    get_unaligned_le32(source) != ELF_MAGIC ||
+	    source[4] != ELFCLASS32 || source[5] != ELFDATA2LSB ||
+	    get_unaligned_le16(source + 18) != ELF_ARM_MACHINE)
+		return -EINVAL;
+
+	program_offset = get_unaligned_le32(source + 28);
+	program_size = get_unaligned_le16(source + 42);
+	program_count = get_unaligned_le16(source + 44);
+	if (program_size < ELF32_PROGRAM_SIZE || !program_count ||
+	    !range_valid(ctx->acpi_size, program_offset,
+			 program_size * (size_t)program_count))
+		return -EINVAL;
+	metadata_end = program_offset + program_size * program_count;
+
+	for (i = 0; i < program_count; i++) {
+		const u8 *program = source + program_offset + i * program_size;
+		u32 type = get_unaligned_le32(program);
+		u32 flags = get_unaligned_le32(program + 24);
+		u32 segment_type = (flags & QCOM_ELF_SEGMENT_TYPE_MASK) >>
+				   QCOM_ELF_SEGMENT_TYPE_SHIFT;
+
+		if ((type == ELF_PT_NULL || type == ELF_PT_LOAD) &&
+		    segment_type == QCOM_ELF_SEGMENT_HASH) {
+			hash_offset = get_unaligned_le32(program + 4);
+			hash_size = get_unaligned_le32(program + 16);
+			if (!hash_size ||
+			    !range_valid(ctx->acpi_size, hash_offset, hash_size) ||
+			    !range_valid(ctx->acpi_size, metadata_end, hash_size))
+				return -EINVAL;
+			hash_count++;
+			continue;
+		}
+
+		if (type != ELF_PT_LOAD)
+			continue;
+		load_offset = get_unaligned_le32(program + 4);
+		load_size = get_unaligned_le32(program + 16);
+		if (!load_size ||
+		    get_unaligned_le32(program + 20) < load_size ||
+		    !range_valid(ctx->acpi_size, load_offset, load_size))
+			return -EINVAL;
+		load_count++;
+	}
+	if (hash_count != 1 || load_count != 1)
+		return -EINVAL;
+
+	/* The table payload begins with the little-endian ASCII signature ACPI. */
+	if (memcmp(source + load_offset, "ACPI", 4))
+		return -EINVAL;
+
+	memset(image, 0, ALIGN(ctx->acpi_size, SZ_4K));
+	memcpy(image, source, ctx->acpi_size);
+	/* ScmDxe's PIL_INIT metadata is ELF headers plus a contiguous hash blob. */
+	memmove(image + metadata_end, image + hash_offset, hash_size);
+	flush_dcache_range((ulong)image,
+			   ALIGN((ulong)image + ctx->acpi_size,
+				 ARCH_DMA_MINALIGN));
+
+	ret = qcom_acpi_scm(QCOM_ACPI_SCM_SET_ELF, QCOM_SCM_ARGS_2_RW,
+			    QCOM_ACPI_VERSION, (ulong)image, 0);
+	if (ret)
+		return ret;
+	ret = qcom_acpi_scm(QCOM_ACPI_SCM_SET_TABLES, QCOM_SCM_ARGS_3,
+			    QCOM_ACPI_VERSION, (ulong)image + load_offset,
+			    load_size);
+	if (ret)
+		return ret;
+	ret = qcom_acpi_scm(QCOM_ACPI_SCM_LOAD, QCOM_SCM_ARGS_1,
+			    QCOM_ACPI_VERSION, 0, 0);
+	if (ret)
+		return ret;
+	return qcom_acpi_scm(QCOM_ACPI_SCM_START, QCOM_SCM_ARGS_1,
+			     QCOM_ACPI_VERSION, 0, 0);
+}
+
+static int qcom_qsee_smc(ulong smc_id, ulong arginfo, ulong arg0,
+			 ulong arg1, ulong arg2,
+			 struct qcom_qsee_response *response)
+{
+	struct arm_smccc_res res;
+	struct arm_smccc_quirk quirk = {
+		.id = ARM_SMCCC_QUIRK_QCOM_A6,
+	};
+	ulong function = smc_id;
+	unsigned int interrupts = 0;
+
+	do {
+		arm_smccc_smc_quirk(function, arginfo, arg0, arg1, arg2, 0,
+				     quirk.state.a6, 0, &res, &quirk);
+		if (res.a0 == QCOM_SL_SMC_INTERRUPTED)
+			function = QCOM_SL_SMC_INTERRUPTED;
+	} while (res.a0 == QCOM_SL_SMC_INTERRUPTED &&
+		 ++interrupts < QCOM_SL_MAX_INTERRUPTS);
+
+	response->result = res.a1;
+	response->type = res.a2;
+	response->data = res.a3;
+	printf("Dragon: QSEE SMC %lx resumes=%u a0=%lx result=%lx type=%lx data=%lx\n",
+	       smc_id, interrupts, res.a0, res.a1, res.a2, res.a3);
+
+	if (res.a0 == QCOM_SL_SMC_INTERRUPTED)
+		return -ETIMEDOUT;
+	return res.a0 ? -EIO : 0;
+}
+
+static int qcom_qsee_lookup_mssecapp(u32 *app_id)
+{
+	struct qcom_qsee_response response;
+	const char name[] = QCOM_QSEE_MSSECAPP_NAME;
+	void *name_buffer = (void *)QCOM_QSEE_APP_NAME_ADDR;
+	int ret;
+
+	memset(name_buffer, 0, SZ_4K);
+	memcpy(name_buffer, name, sizeof(name) - 1);
+	flush_dcache_range((ulong)name_buffer, (ulong)name_buffer + SZ_4K);
+	ret = qcom_qsee_smc(QCOM_QSEE_APP_LOOKUP_ID,
+			    QCOM_QSEE_ARGS_2_RW_VAL,
+			    (ulong)name_buffer, sizeof(name) - 1, 0,
+			    &response);
+	if (ret)
+		return ret;
+	if (response.result == QCOM_QSEE_RESULT_FAILURE)
+		return -ENOENT;
+	if (response.result != QCOM_QSEE_RESULT_SUCCESS ||
+	    response.type != QCOM_QSEE_RESPONSE_APP_ID)
+		return -EIO;
+
+	*app_id = response.data;
+	return 0;
+}
+
+static int qcom_qsee_legacy_start_mssecapp(struct qcom_sl_context *ctx,
+					   struct qcom_qsee_response *response)
+{
+	struct arm_smccc_res res = { 0 };
+	struct arm_smccc_quirk quirk = {
+		.id = ARM_SMCCC_QUIRK_QCOM_A6,
+	};
+	u8 *command = (void *)QCOM_QSEE_LEGACY_CMD_ADDR;
+	ulong function = 1;
+	ulong context;
+	ulong buffer = (ulong)command;
+	unsigned int resumes = 0;
+
+	/*
+	 * Match the stock ScmDxe QSEECom protocol command-1 packet.  The final
+	 * twelve bytes of its empty 32-byte app-name field are deliberately
+	 * overlaid by the request length and legacy response header.
+	 */
+	memset(command, 0, SZ_4K);
+	put_unaligned_le32(QCOM_QSEE_LEGACY_CMD_SIZE, command + 0x00);
+	put_unaligned_le32(QCOM_QSEE_LEGACY_REQUEST_OFF, command + 0x04);
+	put_unaligned_le32(QCOM_QSEE_LEGACY_RESPONSE_OFF, command + 0x08);
+	put_unaligned_le32(QCOM_QSEE_LEGACY_SCHEDULER_ID, command + 0x0c);
+	put_unaligned_le32(1, command + 0x10);
+	put_unaligned_le64(0, command + 0x14);
+	put_unaligned_le64(ctx->mssecapp_size, command + 0x1c);
+	put_unaligned_le64(QCOM_QSEE_MSSECAPP_ADDR, command + 0x24);
+	put_unaligned_le32(0x3c, command + 0x40);
+	put_unaligned_le32(0x18, command + 0x44);
+	put_unaligned_le32(0x0c, command + 0x48);
+	flush_dcache_range((ulong)command, (ulong)command + SZ_4K);
+
+	asm volatile("mov %0, sp" : "=r" (context));
+	context = (u32)context;
+	do {
+		arm_smccc_smc_quirk(function, context, buffer, 0, 0, 0,
+				     quirk.state.a6, 0, &res, &quirk);
+		if ((long)res.a0 > 0) {
+			function = res.a0;
+			context = res.a1;
+			buffer = res.a2;
+		}
+	} while ((long)res.a0 > 0 && ++resumes < QCOM_SL_MAX_INTERRUPTS);
+	invalidate_dcache_range((ulong)command, (ulong)command + SZ_4K);
+
+	response->result = get_unaligned_le32(command + 0x50);
+	response->type = get_unaligned_le32(command + 0x54);
+	response->data = get_unaligned_le32(command + 0x58);
+	printf("Dragon: QSEE legacy start resumes=%u a0=%lx response=%x result=%lx type=%lx data=%lx\n",
+	       resumes, res.a0, get_unaligned_le32(command + 0x4c),
+	       response->result, response->type, response->data);
+
+	if ((long)res.a0 > 0)
+		return -ETIMEDOUT;
+	return res.a0 ? -EIO : 0;
+}
+
+static int qcom_qsee_load_mssecapp(struct qcom_sl_context *ctx)
+{
+	struct qcom_qsee_response response;
+	void *image = (void *)QCOM_QSEE_MSSECAPP_ADDR;
+	u32 app_id;
+	int ret;
+
+	ret = qcom_qsee_lookup_mssecapp(&app_id);
+	if (!ret) {
+		printf("Dragon: QSEE mssecapp already loaded as app %u\n", app_id);
+		return 0;
+	}
+	if (ret != -ENOENT)
+		return ret;
+
+	ret = qcom_qsee_smc(QCOM_QSEE_APP_REGION_ID,
+			    QCOM_QSEE_ARGS_2_RW_VAL,
+			    QCOM_QSEE_TZAPPS_ADDR, QCOM_QSEE_TZAPPS_SIZE, 0,
+			    &response);
+	if (ret)
+		return ret;
+	if (response.result != QCOM_QSEE_RESULT_SUCCESS) {
+		printf("Dragon: QSEE TZApps region registration failed (%lx)\n",
+		       response.result);
+		return -EACCES;
+	}
+
+	memcpy(image, ctx->mssecapp, ctx->mssecapp_size);
+	flush_dcache_range((ulong)image,
+			   ALIGN((ulong)image + ctx->mssecapp_size,
+				 ARCH_DMA_MINALIGN));
+
+	/*
+	 * ScmDxe command 11 is QSEOS_LOAD_SERV_IMAGE_COMMAND.  Stock TzDxe
+	 * always submits it before command 1 when loading mssecapp.  Its three
+	 * value arguments are MDT length (zero for this combined ELF), complete
+	 * image length, and image physical address.
+	 */
+	ret = qcom_qsee_smc(QCOM_QSEE_LOAD_SERVICES_ID,
+			    QCOM_QSEE_ARGS_3_VAL, 0,
+			    ctx->mssecapp_size, (ulong)image, &response);
+	if (ret)
+		return ret;
+	if (response.result != QCOM_QSEE_RESULT_SUCCESS) {
+		printf("Dragon: QSEE services image load failed (%lx)\n",
+		       response.result);
+		return -EACCES;
+	}
+
+	ret = qcom_qsee_smc(QCOM_QSEE_APP_START_ID, QCOM_QSEE_ARGS_3_VAL,
+			    0, ctx->mssecapp_size, (ulong)image, &response);
+	if (ret) {
+		printf("Dragon: QSEE modern app start unavailable; trying legacy ABI\n");
+		ret = qcom_qsee_legacy_start_mssecapp(ctx, &response);
+	}
+	if (ret)
+		return ret;
+	if (response.result != QCOM_QSEE_RESULT_SUCCESS ||
+	    response.type != QCOM_QSEE_RESPONSE_APP_ID) {
+		printf("Dragon: QSEE mssecapp start failed (%lx/%lx)\n",
+		       response.result, response.type);
+		return -EACCES;
+	}
+	printf("Dragon: QSEE started mssecapp as app %lu\n", response.data);
+
+	ret = qcom_qsee_lookup_mssecapp(&app_id);
+	if (ret) {
+		printf("Dragon: QSEE cannot find qcom.tz.mssecapp after start (%d)\n",
+		       ret);
+		return ret;
+	}
+	printf("Dragon: QSEE verified qcom.tz.mssecapp as app %u\n", app_id);
+	return 0;
+}
+
+static ulong qcom_sl_smc(struct qcom_sl_context *ctx, u32 command)
+{
+	struct arm_smccc_res res;
+	struct arm_smccc_quirk quirk = {
+		.id = ARM_SMCCC_QUIRK_QCOM_A6,
+	};
+	ulong function = QCOM_SL_SMC_ID;
+	ulong params = (ulong)ctx->params;
+	ulong daif;
+	ulong cntp_ctl;
+	ulong cntv_ctl;
+	unsigned int interrupts = 0;
+
+	/* Some Gunyah versions wipe this page while changing ownership. */
+	memset(ctx->params, 0, SZ_4K);
+	ctx->params->a = 1;
+	ctx->params->version = 0x10;
+	ctx->params->command = command;
+	ctx->params->pe_data = (ulong)ctx->tcb;
+	ctx->params->pe_size = ctx->tcb_size;
+	ctx->params->arg_data = (ulong)ctx->tz;
+	ctx->params->arg_size = ctx->arg_size;
+	flush_dcache_range((ulong)ctx->params, (ulong)ctx->params + SZ_4K);
+
+	/*
+	 * EDK2 invokes Secure Launch after ExitBootServices has quiesced its
+	 * timer events.  Do the equivalent here: a still-asserted architectural
+	 * timer can make Gunyah interrupt the longer AUTH operation even while
+	 * normal-world IRQ delivery is masked.
+	 */
+	asm volatile("mrs %0, cntp_ctl_el0" : "=r" (cntp_ctl));
+	asm volatile("mrs %0, cntv_ctl_el0" : "=r" (cntv_ctl));
+	asm volatile("msr cntp_ctl_el0, xzr");
+	asm volatile("msr cntv_ctl_el0, xzr");
+
+	/* No exception may return Gunyah from TrustZone into this EL1 caller. */
+	asm volatile("mrs %0, daif" : "=r" (daif));
+	asm volatile("msr daifset, #0xf" : : : "memory");
+	isb();
+	do {
+		arm_smccc_smc_quirk(function, params, command, 0, 0, 0,
+				     quirk.state.a6, 0, &res, &quirk);
+
+		/*
+		 * Qualcomm's standard-call ABI returns 1 when secure-world work
+		 * was interrupted.  AUTH can return this after Gunyah has already
+		 * removed the TCB and argument pages from EL1, so it is essential
+		 * to resume with x0=1 without touching or rebuilding those pages.
+		 * Preserve x6 as required by the Qualcomm SMCCC quirk.
+		 */
+		if (res.a0 == QCOM_SL_SMC_INTERRUPTED)
+			function = QCOM_SL_SMC_INTERRUPTED;
+	} while (res.a0 == QCOM_SL_SMC_INTERRUPTED &&
+		 ++interrupts < QCOM_SL_MAX_INTERRUPTS);
+	asm volatile("msr daif, %0" : : "r" (daif) : "memory");
+	asm volatile("msr cntp_ctl_el0, %0" : : "r" (cntp_ctl));
+	asm volatile("msr cntv_ctl_el0, %0" : : "r" (cntv_ctl));
+	isb();
+
+	if (res.a0 == QCOM_SL_SMC_INTERRUPTED)
+		printf("Dragon: Secure Launch SMC did not complete after %u resumes\n",
+		       interrupts);
+	if (command != QCOM_SL_CMD_IS_AVAILABLE || res.a0)
+		printf("Dragon: Secure Launch SMC cmd=%u resumes=%u timers=%lx/%lx a0=%lx a1=%lx a2=%lx a3=%lx a6=%lx\n",
+		       command, interrupts, cntp_ctl, cntv_ctl, res.a0, res.a1,
+		       res.a2, res.a3, quirk.state.a6);
+
+	return res.a0;
+}
+
+int qcom_secure_launch_available(void)
+{
+	struct qcom_sl_context ctx = { 0 };
+	ulong ret;
+
+	ctx.params = memalign(ARCH_DMA_MINALIGN, SZ_4K);
+	if (!ctx.params)
+		return -ENOMEM;
+
+	ret = qcom_sl_smc(&ctx, QCOM_SL_CMD_IS_AVAILABLE);
+	free(ctx.params);
+
+	return ret ? -ENOSYS : 0;
+}
+
+static int qcom_sl_parse_and_load_pe(struct qcom_sl_context *ctx,
+				     const u8 *file, size_t file_size,
+				     const u8 **cert, size_t *cert_size)
+{
+	const u8 *file_header;
+	const u8 *optional;
+	const u8 *section;
+	u32 pe_offset, header_size, image_size;
+	u32 security_offset, security_size;
+	u16 optional_size, section_count;
+	int i;
+
+	if (!range_valid(file_size, 0, 0x40) ||
+	    get_unaligned_le16(file) != PE_DOS_MAGIC)
+		return -EINVAL;
+
+	pe_offset = get_unaligned_le32(file + 0x3c);
+	if (!range_valid(file_size, pe_offset, 24) ||
+	    get_unaligned_le32(file + pe_offset) != PE_NT_MAGIC)
+		return -EINVAL;
+
+	file_header = file + pe_offset + 4;
+	if (get_unaligned_le16(file_header) != PE_AARCH64_MACHINE)
+		return -EINVAL;
+	section_count = get_unaligned_le16(file_header + 2);
+	optional_size = get_unaligned_le16(file_header + 16);
+	optional = file_header + 20;
+
+	if (optional_size < PE_DIRECTORY_TABLE_OFF + 8 * 5 ||
+	    !range_valid(file_size, optional - file, optional_size) ||
+	    get_unaligned_le16(optional) != PE32_PLUS_MAGIC ||
+	    get_unaligned_le16(optional + PE_SUBSYSTEM_OFF) !=
+			PE_BOOT_APPLICATION ||
+	    get_unaligned_le32(optional + PE_DIRECTORY_COUNT_OFF) <=
+			PE_SECURITY_DIRECTORY)
+		return -EINVAL;
+
+	header_size = get_unaligned_le32(optional + PE_SIZE_OF_HEADERS_OFF);
+	image_size = get_unaligned_le32(optional + PE_SIZE_OF_IMAGE_OFF);
+	if (!header_size || header_size > file_size ||
+	    !image_size || image_size > QCOM_SL_TCB_PAGES * SZ_4K)
+		return -E2BIG;
+
+	security_offset = get_unaligned_le32(optional + PE_DIRECTORY_TABLE_OFF +
+					      PE_SECURITY_DIRECTORY * 8);
+	security_size = get_unaligned_le32(optional + PE_DIRECTORY_TABLE_OFF +
+					    PE_SECURITY_DIRECTORY * 8 + 4);
+	if (security_size < 8 ||
+	    !range_valid(file_size, security_offset, security_size) ||
+	    get_unaligned_le16(file + security_offset + 4) != 0x200 ||
+	    get_unaligned_le16(file + security_offset + 6) != 2)
+		return -EINVAL;
+
+	ctx->tcb = (void *)QCOM_SL_TCB_ADDR;
+	memset(ctx->tcb, 0, QCOM_SL_TCB_PAGES * SZ_4K);
+	memcpy(ctx->tcb, file, header_size);
+
+	section = optional + optional_size;
+	if (!range_valid(file_size, section - file,
+			 section_count * PE_SECTION_SIZE))
+		return -EINVAL;
+
+	for (i = 0; i < section_count; i++, section += PE_SECTION_SIZE) {
+		u32 virtual_address = get_unaligned_le32(section + 12);
+		u32 raw_size = get_unaligned_le32(section + 16);
+		u32 raw_offset = get_unaligned_le32(section + 20);
+
+		if (!range_valid(file_size, raw_offset, raw_size) ||
+		    !range_valid(QCOM_SL_TCB_PAGES * SZ_4K,
+				 virtual_address, raw_size))
+			return -EINVAL;
+		memcpy(ctx->tcb + virtual_address, file + raw_offset, raw_size);
+	}
+
+	ctx->tcb_size = QCOM_SL_TCB_PAGES * SZ_4K;
+	*cert = file + security_offset;
+	*cert_size = security_size;
+	return 0;
+}
+
+static int qcom_sl_prepare(struct qcom_sl_context *ctx)
+{
+	const struct qcom_sl_blob_header *blob;
+	const u8 *file, *cert;
+	size_t file_size, cert_size, cert_pages, buffer_pages;
+	ulong transition;
+	int ret;
+
+	BUILD_BUG_ON(sizeof(struct qcom_sl_tz_data) != 0xc8);
+
+	blob = (const void *)CONFIG_QCOM_SECURE_LAUNCH_BLOB_ADDR;
+	if (memcmp(blob->magic, QCOM_SL_BLOB_MAGIC, sizeof(blob->magic)) ||
+	    blob->version != QCOM_SL_BLOB_VERSION ||
+	    !blob->tcb_size || !blob->mssecapp_size || !blob->acpi_size ||
+	    blob->tcb_size > QCOM_SL_BLOB_MAX_SIZE ||
+	    blob->mssecapp_size > QCOM_SL_BLOB_MAX_SIZE ||
+	    blob->acpi_size > QCOM_ACPI_MAX_SIZE ||
+	    blob->tcb_size > QCOM_SL_BLOB_MAX_SIZE - blob->mssecapp_size ||
+	    blob->tcb_size + blob->mssecapp_size >
+		QCOM_SL_BLOB_MAX_SIZE - blob->acpi_size)
+		return -ENOENT;
+
+	file = (const u8 *)(blob + 1);
+	file_size = blob->tcb_size;
+	ret = qcom_sl_parse_and_load_pe(ctx, file, file_size,
+					&cert, &cert_size);
+	if (ret)
+		return ret;
+	ctx->mssecapp = file + file_size;
+	ctx->mssecapp_size = blob->mssecapp_size;
+	if (ctx->mssecapp_size < 64 ||
+	    get_unaligned_le32(ctx->mssecapp) != 0x464c457f ||
+	    get_unaligned_le16(ctx->mssecapp + 18) != 0xb7)
+		return -EINVAL;
+	ctx->acpi = ctx->mssecapp + ctx->mssecapp_size;
+	ctx->acpi_size = blob->acpi_size;
+
+	cert_pages = cert_size / SZ_4K + 1;
+	buffer_pages = 27 + cert_pages + 3;
+	ctx->buffer_size = buffer_pages * SZ_4K;
+	ctx->buffer = (void *)QCOM_SL_BUFFER_ADDR;
+	ctx->boot_params = (void *)QCOM_SL_BOOT_PARAMS_ADDR;
+
+	memset(ctx->buffer, 0, ctx->buffer_size);
+	memset(ctx->boot_params, 0xff,
+	       QCOM_SL_BOOT_PARAMS_PAGES * SZ_4K);
+	ctx->params = ctx->buffer + SZ_4K;
+	ctx->tz = ctx->buffer + 2 * SZ_4K;
+
+	ctx->tz->version = 1;
+	ctx->tz->cert_offset = 25 * SZ_4K;
+	ctx->tz->cert_size = cert_size;
+	memcpy((u8 *)ctx->tz + ctx->tz->cert_offset, cert, cert_size);
+	ctx->tz->tcg_offset = ctx->tz->cert_offset + cert_size;
+	ctx->tz->tcg_size = QCOM_SL_TCG_PAGES * SZ_4K;
+	ctx->tz->tcg_version = 2;
+	ctx->tz->this_size = (buffer_pages - 3) * SZ_4K;
+	ctx->tz->this_phys = (ulong)ctx->tz;
+	ctx->tz->crt_offset = SZ_4K;
+	ctx->tz->crt_page_count = QCOM_SL_CRT_PAGES;
+	ctx->tz->boot_params = (ulong)ctx->boot_params;
+	ctx->tz->boot_params_size = QCOM_SL_BOOT_PARAMS_PAGES * SZ_4K;
+
+	transition = (ulong)qcom_sl_transition_entry;
+	ctx->tz->transition_entry = transition;
+	ctx->tz->transition_virt = ALIGN_DOWN(transition, SZ_4K);
+	ctx->tz->transition_phys = ctx->tz->transition_virt;
+	ctx->tz->transition_size = 2 * SZ_4K;
+	ctx->tz->transition_data.mair = (ulong)qcom_sl_jump_buffer;
+	ctx->arg_size = ctx->tz->this_size;
+
+	if (ctx->tz->tcg_offset + ctx->tz->tcg_size > ctx->arg_size)
+		return -E2BIG;
+
+	flush_dcache_range((ulong)ctx->tcb,
+			   (ulong)ctx->tcb + ctx->tcb_size);
+	flush_dcache_range((ulong)ctx->buffer,
+			   (ulong)ctx->buffer + ctx->buffer_size);
+	flush_dcache_range((ulong)ctx->boot_params,
+			   (ulong)ctx->boot_params +
+			   QCOM_SL_BOOT_PARAMS_PAGES * SZ_4K);
+	return 0;
+}
+
+int qcom_secure_launch_prepare_platform(void)
+{
+	struct qcom_sl_context ctx = { 0 };
+	int ret;
+
+	ret = qcom_sl_prepare(&ctx);
+	if (ret)
+		return ret;
+
+	return qcom_acpi_register(&ctx);
+}
+
+int qcom_secure_launch(void)
+{
+	struct qcom_sl_context ctx = { 0 };
+	ulong ret;
+	int err;
+
+	if (current_el() == 2)
+		return 0;
+	if (current_el() != 1)
+		return -EPERM;
+
+	err = qcom_sl_prepare(&ctx);
+	if (err) {
+		printf("Dragon: cannot prepare Secure Launch (%d)\n", err);
+		return err;
+	}
+
+	err = qcom_acpi_register(&ctx);
+	if (err) {
+		printf("Dragon: cannot register Secure Launch ACPI data (%d)\n",
+		       err);
+		return err;
+	}
+
+	ret = qcom_sl_smc(&ctx, QCOM_SL_CMD_IS_AVAILABLE);
+	if (ret) {
+		printf("Dragon: Secure Launch unavailable (a0=%lx)\n", ret);
+		return -ENOSYS;
+	}
+	printf("Dragon: Secure Launch buffers params=%lx tcb=%lx/%llx args=%lx/%llx transition=%lx\n",
+	       (ulong)ctx.params, (ulong)ctx.tcb,
+	       (unsigned long long)ctx.tcb_size,
+	       (ulong)ctx.tz, (unsigned long long)ctx.arg_size,
+	       (ulong)qcom_sl_transition_entry);
+
+	err = qcom_qsee_load_mssecapp(&ctx);
+	if (err) {
+		printf("Dragon: cannot load Secure Launch trusted app (%d)\n", err);
+		return err;
+	}
+
+	/* AUTH may transfer RAM ownership, so clean every U-Boot cache first. */
+	flush_dcache_all();
+	ret = qcom_sl_smc(&ctx, QCOM_SL_CMD_AUTH);
+	if (ret) {
+		printf("Dragon: Secure Launch authentication failed (a0=%lx)\n",
+		       ret);
+		return -EACCES;
+	}
+
+	if (!qcom_sl_setjmp(qcom_sl_jump_buffer)) {
+		flush_dcache_range((ulong)qcom_sl_jump_buffer,
+				   (ulong)qcom_sl_jump_buffer +
+				   sizeof(qcom_sl_jump_buffer));
+		ret = qcom_sl_smc(&ctx, QCOM_SL_CMD_LAUNCH);
+		printf("Dragon: Secure Launch returned unexpectedly (a0=%lx)\n",
+		       ret);
+		return -EIO;
+	}
+
+	if (current_el() != 2) {
+		printf("Dragon: Secure Launch transition returned at EL%u\n",
+		       current_el());
+		return -EIO;
+	}
+
+	puts("Dragon: Secure Launch handed U-Boot EL2\n");
+	return 0;
+}
diff --git a/arch/arm/mach-snapdragon/secure_launch_transition.S b/arch/arm/mach-snapdragon/secure_launch_transition.S
new file mode 100644
index 00000000..102c1244
--- /dev/null
+++ b/arch/arm/mach-snapdragon/secure_launch_transition.S
@@ -0,0 +1,135 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+/*
+ * Copyright (c) 2024 Nikita Travkin <nikita@trvn.ru>
+ * Copyright (c) 2026 Asius Technologies, Inc.
+ *
+ * EL1-to-EL2 return trampoline derived from slbounce.
+ */
+
+#include <config.h>
+#include <linux/linkage.h>
+
+#define HCR_EL2_TGE		(1 << 27)
+#define HCR_EL2_E2H		(1ULL << 34)
+#define CNTHCTL_EL2_EL1PCTEN	(1 << 0)
+#define CNTHCTL_EL2_EL1PCEN	(1 << 1)
+
+.macro movq reg, value
+	movz	\reg, (\value >> 0) & 0xffff
+	movk	\reg, (\value >> 16) & 0xffff, lsl 16
+	movk	\reg, (\value >> 32) & 0xffff, lsl 32
+	movk	\reg, (\value >> 48) & 0xffff, lsl 48
+.endm
+
+.pushsection .text.qcom_sl_transition_entry, "ax"
+ENTRY(qcom_sl_transition_entry)
+	mov	x9, x0
+	hvc	#1
+
+	/* TCB returns from the HVC in EL2; temporarily use physical addresses. */
+	mrs	x0, sctlr_el2
+	bic	x0, x0, #1
+	msr	sctlr_el2, x0
+	isb
+	msr	daifset, #0xf
+
+	/* transition_data.mair carries the saved U-Boot jump-buffer address. */
+	ldr	x0, [x9]
+	mov	x1, #1
+	bl	qcom_sl_longjmp
+
+	/* No valid path returns here. */
+	movz	x0, #8
+	movk	x0, #0xc400, lsl #16
+	smc	#0
+1:	wfe
+	b	1b
+ENDPROC(qcom_sl_transition_entry)
+.popsection
+
+.pushsection .text.qcom_sl_setjmp, "ax"
+ENTRY(qcom_sl_setjmp)
+	.macro save_sysreg reg, offset
+		mrs	x2, \reg
+		str	x2, [x0, \offset]
+	.endm
+
+	save_sysreg vbar_el1,  #104
+	save_sysreg tpidr_el0, #112
+	save_sysreg cpacr_el1, #120
+	save_sysreg ttbr0_el1, #128
+	save_sysreg tcr_el1,   #136
+	save_sysreg mair_el1,  #144
+	save_sysreg sctlr_el1, #152
+	save_sysreg daif,      #160
+
+	stp	x19, x20, [x0, #0]
+	stp	x21, x22, [x0, #16]
+	stp	x23, x24, [x0, #32]
+	stp	x25, x26, [x0, #48]
+	stp	x27, x28, [x0, #64]
+	stp	x29, x30, [x0, #80]
+	mov	x2, sp
+	str	x2, [x0, #96]
+	mov	x0, #0
+	ret
+ENDPROC(qcom_sl_setjmp)
+.popsection
+
+.pushsection .text.qcom_sl_longjmp, "ax"
+ENTRY(qcom_sl_longjmp)
+	.macro load_sysreg reg, offset
+		ldr	x2, [x0, \offset]
+		msr	\reg, x2
+		isb
+	.endm
+
+	tlbi	alle2
+	dsb	ish
+	tlbi	alle2
+
+	load_sysreg vbar_el2,  #104
+	load_sysreg tpidr_el0, #112
+
+	movq	x2, (HCR_EL2_TGE | HCR_EL2_E2H)
+	msr	hcr_el2, x2
+	isb
+	mov	x2, #(CNTHCTL_EL2_EL1PCTEN | CNTHCTL_EL2_EL1PCEN)
+	msr	cnthctl_el2, x2
+
+	load_sysreg cpacr_el1, #120
+	load_sysreg ttbr0_el2, #128
+	load_sysreg tcr_el2,   #136
+	load_sysreg mair_el2,  #144
+	dsb	ish
+	isb
+
+	ldr	x2, [x0, #152]
+	movq	x3, 0x00001000faef387f
+	and	x2, x2, x3
+	movq	x3, 0x0000000030c50830
+	orr	x2, x2, x3
+	msr	sctlr_el2, x2
+	isb
+
+	ldp	x19, x20, [x0, #0]
+	ldp	x21, x22, [x0, #16]
+	ldp	x23, x24, [x0, #32]
+	ldp	x25, x26, [x0, #48]
+	ldp	x27, x28, [x0, #64]
+	ldp	x29, x30, [x0, #80]
+	ldr	x2, [x0, #96]
+	mov	sp, x2
+	load_sysreg daif, #160
+
+	cmp	w1, #0
+	csinc	w0, w1, wzr, ne
+	br	x30
+ENDPROC(qcom_sl_longjmp)
+.popsection
+
+.data
+.align 3
+.global qcom_sl_jump_buffer
+qcom_sl_jump_buffer:
+	.zero 8 * 21
diff --git a/board/qualcomm/asius-dragon-q6a.env b/board/qualcomm/asius-dragon-q6a.env
new file mode 100644
index 00000000..d4380cb7
--- /dev/null
+++ b/board/qualcomm/asius-dragon-q6a.env
@@ -0,0 +1,55 @@
+stdin=serial
+stdout=serial
+stderr=serial
+
+kernel_addr_r=a1000000
+fdt_addr_r=a5000000
+qupfw_addr_r=a6000000
+dspfw_addr_r=a7000000
+fdt_high=ffffffffffffffff
+bootargs_base=console=ttyMSM0,115200n8 earlycon rootwait rw fw_devlink=permissive quiet loglevel=3 msm.separate_gpu_kms=1
+vamos_dtb=qcs6490-radxa-dragon-q6a.dtb
+vamos_load=
+	if ext4load ${vamos_interface} ${vamos_device}:${vamos_rootpart} ${dspfw_addr_r} lib/firmware/qcom/qcs6490/radxa/dragon-q6a/adsp.mbn &&
+	   dspboot ${dspfw_addr_r} ${filesize} 1 8b800000 2800000 &&
+	   ext4load ${vamos_interface} ${vamos_device}:${vamos_rootpart} ${dspfw_addr_r} lib/firmware/qcom/qcs6490/radxa/dragon-q6a/cdsp.mbn &&
+	   dspboot ${dspfw_addr_r} ${filesize} 12 8e000000 1e00000 &&
+	   sllaunch &&
+	   fatload ${vamos_interface} ${vamos_device}:${vamos_esp} ${qupfw_addr_r} EFI/vamos/qupv3fw.elf &&
+	   genifw ${qupfw_addr_r} ${filesize} &&
+	   fatload ${vamos_interface} ${vamos_device}:${vamos_esp} ${kernel_addr_r} EFI/vamos/Image &&
+	   fatload ${vamos_interface} ${vamos_device}:${vamos_esp} ${fdt_addr_r} ${vamos_dtb}; then
+		fdt addr ${fdt_addr_r};
+		fdt resize 1000;
+		fdt memory 80000000 200000000;
+		if test "${vamos_usb_mode}" = "host"; then
+			fdt set /soc@0/usb@a600000 dr_mode host;
+			setenv vamos_usb_arg vamos.usb_mode=host;
+		else
+			fdt set /soc@0/usb@a600000 dr_mode peripheral;
+			setenv vamos_usb_arg vamos.usb_mode=ncm;
+		fi;
+		setenv bootargs ${bootargs_base} root=${vamos_root} vamos.slot=${vamos_slot} ${vamos_state_arg} ${vamos_usb_arg};
+		booti ${kernel_addr_r} - ${fdt_addr_r};
+	fi
+vamos_nvme=
+	setenv vamos_interface nvme;
+	setenv vamos_device 0;
+	pci enum && nvme scan && vamosboot nvme 0 &&
+	if test "${vamos_edl}" = "1"; then edl; else run vamos_load; fi;
+	vamosboot nvme 0 fail && run vamos_load
+vamos_ufs=
+	setenv vamos_interface scsi;
+	setenv vamos_device 0;
+	ufs init && scsi scan && vamosboot scsi 0 &&
+	if test "${vamos_edl}" = "1"; then edl; else run vamos_load; fi;
+	vamosboot scsi 0 fail && run vamos_load
+bootcmd=
+	if test "${vamos_storage}" = "ufs"; then
+		run vamos_ufs;
+		run vamos_nvme;
+	else
+		run vamos_nvme;
+		run vamos_ufs;
+	fi;
+	echo vamOS: no bootable NVMe or UFS slot found
diff --git a/boot/Kconfig b/boot/Kconfig
