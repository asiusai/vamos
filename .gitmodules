[submodule "kernel/linux"]
	path = kernel/linux
	url = https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
[submodule "bootloader/u-boot"]
	path = bootloader/u-boot
	url = https://source.denx.de/u-boot/u-boot.git
[submodule "bootloader/qtestsign"]
	path = bootloader/qtestsign
	url = https://github.com/msm8916-mainline/qtestsign.git
[submodule "kernel/aic8800"]
	path = kernel/aic8800
	url = https://github.com/radxa-pkg/aic8800.git
